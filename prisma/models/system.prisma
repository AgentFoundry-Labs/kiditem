// system.prisma — System domain

/// @namespace System
/// @describe 피처 플래그. allowedOrganizations: string[] 로 회사별 enable.
model FeatureGate {
  id                   String   @id @default(uuid()) @db.Uuid
  name                 String   @unique
  description          String?
  enabled              Boolean  @default(false)
  allowedOrganizations String[] @map("allowed_organizations")
  metadata             Json?    @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("feature_gates")
}

/// @namespace System
model Alert {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  // Focused source-failure identity: the owner-defined dedupe key and, when
  // one exists, the failed attempt.
  dedupeKey String  @default(uuid()) @map("dedupe_key")
  attemptId String? @map("attempt_id") @db.Uuid

  targetType String? @map("target_type")
  targetId   String? @map("target_id") @db.Uuid

  status  String    @default("OPEN")
  type    String
  title   String
  message String?
  readAt  DateTime? @map("read_at") @db.Timestamptz

  sourceType String? @map("source_type")
  href       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, dedupeKey], map: "alerts_organization_id_dedupe_key_key")
  @@index([organizationId])
  @@index([organizationId, dedupeKey])
  @@index([organizationId, sourceType, attemptId])
  @@index([organizationId, targetType, targetId])
  @@index([type])
  @@index([createdAt])
  @@map("alerts")
}

/// @namespace System
model SystemSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  key            String
  value          Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("system_settings")
}

/// @namespace System
/// @describe 운영 data migration ledger. Schema-only db push와 별도로 영속 데이터 보정 실행 여부를 기록한다.
model DataMigrationRun {
  migrationId      String    @id @map("migration_id")
  releaseVersion   String    @map("release_version")
  name             String
  status           String
  gitSha           String?   @map("git_sha")
  prismaSchemaHash String?   @map("prisma_schema_hash")
  affectedRows     Int       @default(0) @map("affected_rows")
  details          Json      @default("{}") @db.JsonB
  error            String?
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([status])
  @@index([releaseVersion])
  @@index([completedAt])
  @@map("data_migration_runs")
}

/// @namespace System
/// @describe 할 일 한 줄(TO DO LIST 화면). 사장님이 해 줘야 하는 일과 우리가 만들 일을 한 곳에 적는다 — 몰 대량등록처럼 여러 화면에 걸친 일의 남은 조각을 잊지 않으려고 둔다.
model TodoItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  /// 누가 하는 일인가 — `operator` 사장님 · `kiditem` 우리(개발).
  owner          String    @db.VarChar(20)
  /// 어느 일에 딸린 것인가(`몰 대량등록` 처럼). 화면이 이 이름으로 묶는다.
  area           String    @db.VarChar(60)
  title          String
  detail         String?
  /// `open` 할 일 · `doing` 하는 중 · `done` 끝.
  status         String    @default("open") @db.VarChar(20)
  sortOrder      Int       @default(0) @map("sort_order")
  doneAt         DateTime? @map("done_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, sortOrder])
  @@map("todo_items")
}
