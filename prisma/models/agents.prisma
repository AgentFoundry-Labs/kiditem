// agents.prisma — Agent OS + Workflows
//
// Agent OS owns organization-scoped instances, runtime, policy, approvals,
// and cost ledgers. Shipped agent definitions live in the backend code
// registry, not in DB.
// Workflow models live alongside because the workflow runner triggers
// Agent OS through `AgentRunnerPort` and shares related FK columns.

/// @namespace AgentOS
/// @describe Immutable runtime and policy identity for one version of a code-defined interactive agent.
model AgentVersion {
  id                 String    @id @default(uuid()) @db.Uuid
  agentDefinitionKey String    @map("agent_definition_key")
  version            Int
  displayName        String    @map("display_name")
  description        String
  runtimeType        String    @map("runtime_type")
  modelIdentity      String    @map("model_identity")
  capabilityKeys     Json      @map("capability_keys") @db.JsonB
  policyDocument     Json      @map("policy_document") @db.JsonB
  manifestHash       String    @map("manifest_hash")
  runtimeManifest    Json      @map("runtime_manifest") @db.JsonB
  activatedAt        DateTime? @map("activated_at") @db.Timestamptz
  retiredAt          DateTime? @map("retired_at") @db.Timestamptz
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz

  primarySessions AgentSession[]               @relation("AgentSessionPrimaryVersion")
  assignedTasks   AgentSessionTask[]           @relation("AgentSessionTaskAssignedVersion")
  policySnapshots AgentPolicySnapshot[]        @relation("AgentPolicySnapshotAgentVersion")
  executions      AgentExecution[]             @relation("AgentExecutionAgentVersion")
  delegationsFrom AgentSessionTaskDelegation[] @relation("AgentTaskDelegationFromVersion")
  delegationsTo   AgentSessionTaskDelegation[] @relation("AgentTaskDelegationToVersion")

  @@unique([agentDefinitionKey, version], map: "agent_versions_definition_version_key")
  @@unique([agentDefinitionKey, manifestHash], map: "agent_versions_definition_manifest_hash_key")
  @@unique([agentDefinitionKey], map: "agent_versions_one_active_key", where: raw("activated_at IS NOT NULL AND retired_at IS NULL"))
  @@index([agentDefinitionKey, activatedAt])
  @@map("agent_versions")
}

/// @namespace AgentOS
/// @describe Immutable organization-scoped authority profile selected before a durable Agent session begins.
model AgentAuthorityProfileVersion {
  id             String
  organizationId String   @map("organization_id") @db.Uuid
  profileKey     String   @map("profile_key")
  version        Int
  capabilityKeys Json     @map("capability_keys") @db.JsonB
  policyDocument Json     @map("policy_document") @db.JsonB
  policyHash     String   @map("policy_hash")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization    Organization                 @relation("AgentAuthorityProfileVersionOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  sessions        AgentSession[]               @relation("AgentSessionAuthorityProfileVersion")
  policySnapshots AgentPolicySnapshot[]        @relation("AgentPolicySnapshotAuthorityProfileVersion")
  delegations     AgentSessionTaskDelegation[] @relation("AgentTaskDelegationAuthorityProfileVersion")

  @@id([id, organizationId], map: "agent_authority_profile_versions_pkey")
  @@unique([organizationId, profileKey, version], map: "agent_authority_profile_versions_org_profile_version_key")
  @@unique([organizationId, profileKey, policyHash], map: "agent_authority_profile_versions_org_profile_hash_key")
  @@index([organizationId, profileKey, createdAt])
  @@map("agent_authority_profile_versions")
}

/// @namespace AgentOS
/// @describe Organization-scoped canonical interaction session rooted at the first submitted user message.
model AgentSession {
  id                        String    @id @default(uuid()) @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  createdByUserId           String    @map("created_by_user_id") @db.Uuid
  copilotThreadId           String    @map("copilot_thread_id")
  primaryAgentVersionId     String    @map("primary_agent_version_id") @db.Uuid
  authorityProfileVersionId String    @map("authority_profile_version_id")
  contextEpoch              Int       @default(1) @map("context_epoch")
  title                     String?
  lastEventSequence         BigInt    @default(0) @map("last_event_sequence") @db.BigInt
  lifecycle                 String    @default("active")
  completedAt               DateTime? @map("completed_at") @db.Timestamptz
  cancelledAt               DateTime? @map("cancelled_at") @db.Timestamptz
  archivedAt                DateTime? @map("archived_at") @db.Timestamptz
  legalHoldAt               DateTime? @map("legal_hold_at") @db.Timestamptz
  legalHoldReason           String?   @map("legal_hold_reason") @db.Text
  retentionDueAt            DateTime? @map("retention_due_at") @db.Timestamptz
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization            Organization                 @relation("AgentSessionOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  creator                 User                         @relation("AgentSessionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  primaryAgentVersion     AgentVersion                 @relation("AgentSessionPrimaryVersion", fields: [primaryAgentVersionId], references: [id], onDelete: Restrict)
  authorityProfileVersion AgentAuthorityProfileVersion @relation("AgentSessionAuthorityProfileVersion", fields: [authorityProfileVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  tasks                   AgentSessionTask[]           @relation("AgentSessionTasks")
  epochs                  AgentContextEpoch[]          @relation("AgentSessionEpochs")
  policySnapshots         AgentPolicySnapshot[]        @relation("AgentSessionPolicySnapshots")
  executions              AgentExecution[]             @relation("AgentSessionExecutions")
  events                  AgentConversationEvent[]     @relation("AgentSessionEvents")
  delegations             AgentSessionTaskDelegation[] @relation("AgentSessionTaskDelegations")
  approvals               AgentSessionApproval[]       @relation("AgentSessionApprovals")
  artifacts               AgentSessionArtifact[]       @relation("AgentSessionArtifacts")
  lifecycleRequests       AgentSessionLifecycleRequest[] @relation("AgentSessionLifecycleRequests")

  @@unique([organizationId, copilotThreadId], map: "agent_sessions_org_copilot_thread_key")
  @@unique([id, organizationId], map: "agent_sessions_id_org_key")
  @@index([organizationId, createdByUserId, lifecycle, updatedAt])
  @@index([createdByUserId])
  @@index([primaryAgentVersionId])
  @@map("agent_sessions")
}

/// @namespace AgentOS
/// @describe Organization-level immutable-minimum interaction retention policy with an auditable legal policy version.
model AgentInteractionRetentionPolicy {
  organizationId       String   @id @map("organization_id") @db.Uuid
  sessionRetentionDays Int      @default(365) @map("session_retention_days")
  residency            String   @default("KR")
  legalPolicyVersion   String   @map("legal_policy_version")
  updatedByUserId      String?  @map("updated_by_user_id") @db.Uuid
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation("AgentInteractionRetentionPolicyOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation("AgentInteractionRetentionPolicyUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([updatedByUserId])
  @@map("agent_interaction_retention_policies")
}

/// @namespace AgentOS
/// @describe Scoped lifecycle idempotency record retained only while its canonical AgentSession exists.
model AgentSessionLifecycleRequest {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  command           String
  reason            String    @db.Text
  idempotencyKey    String    @map("idempotency_key")
  status            String
  requestedByUserId String    @map("requested_by_user_id") @db.Uuid
  deletionDueAt     DateTime? @map("deletion_due_at") @db.Timestamptz
  errorCode         String?   @map("error_code")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finishedAt        DateTime? @map("finished_at") @db.Timestamptz

  organization Organization @relation("AgentSessionLifecycleRequestOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  session      AgentSession @relation("AgentSessionLifecycleRequests", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requestedBy  User         @relation("AgentSessionLifecycleRequestRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey], map: "agent_session_lifecycle_requests_org_idempotency_key")
  @@unique([id, organizationId], map: "agent_session_lifecycle_requests_id_org_key")
  @@index([organizationId, status, deletionDueAt])
  @@index([sessionId, organizationId])
  @@index([requestedByUserId])
  @@map("agent_session_lifecycle_requests")
}

/// @namespace AgentOS
/// @describe Content-free, versioned-HMAC deletion receipt used only for terminal delete idempotency.
model AgentSessionTombstone {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationIdHash     String   @map("organization_id_hash")
  copilotThreadIdHash    String   @unique(map: "agent_session_tombstones_copilot_thread_hash_key") @map("copilot_thread_id_hash")
  idempotencyKeyHash     String   @unique(map: "agent_session_tombstones_idempotency_hash_key") @map("idempotency_key_hash")
  requestFingerprintHash String   @map("request_fingerprint_hash")
  hashKeyVersion         String   @map("hash_key_version")
  terminalLifecycle      String   @map("terminal_lifecycle")
  deletionReasonCode     String   @map("deletion_reason_code")
  deletedAt              DateTime @map("deleted_at") @db.Timestamptz
  legalPolicyVersion     String   @map("legal_policy_version")

  @@index([organizationIdHash, deletedAt])
  @@map("agent_session_tombstones")
}

/// @namespace AgentOS
/// @describe Root or delegated task control state owned by one canonical interaction session.
model AgentSessionTask {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  sessionId              String    @map("session_id") @db.Uuid
  parentTaskId           String?   @map("parent_task_id") @db.Uuid
  assignedAgentVersionId String    @map("assigned_agent_version_id") @db.Uuid
  objective              String?   @db.Text
  isRoot                 Boolean   @default(false) @map("is_root")
  status                 String
  idempotencyKey         String    @map("idempotency_key")
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  finishedAt             DateTime? @map("finished_at") @db.Timestamptz

  session              AgentSession                 @relation("AgentSessionTasks", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  parent               AgentSessionTask?            @relation("AgentSessionTaskHierarchy", fields: [parentTaskId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Restrict)
  children             AgentSessionTask[]           @relation("AgentSessionTaskHierarchy")
  assignedAgentVersion AgentVersion                 @relation("AgentSessionTaskAssignedVersion", fields: [assignedAgentVersionId], references: [id], onDelete: Restrict)
  executions           AgentExecution[]             @relation("AgentSessionTaskExecutions")
  outgoingDelegations  AgentSessionTaskDelegation[] @relation("AgentSessionTaskOutgoingDelegations")
  incomingDelegation   AgentSessionTaskDelegation?  @relation("AgentSessionTaskIncomingDelegation")
  approvals            AgentSessionApproval[]       @relation("AgentSessionTaskApprovals")
  artifacts            AgentSessionArtifact[]       @relation("AgentSessionTaskArtifacts")

  @@unique([sessionId, idempotencyKey], map: "agent_session_tasks_session_idempotency_key")
  @@unique([sessionId], map: "agent_session_tasks_one_root_key", where: raw("is_root = true"))
  @@unique([id, organizationId], map: "agent_session_tasks_id_org_key")
  @@unique([id, sessionId, organizationId], map: "agent_session_tasks_id_session_org_key")
  @@index([organizationId, sessionId, status])
  @@index([sessionId, organizationId])
  @@index([parentTaskId, sessionId, organizationId])
  @@index([assignedAgentVersionId])
  @@map("agent_session_tasks")
}

/// @namespace AgentOS
/// @describe Immutable context-boundary marker owned by one canonical interaction session.
model AgentContextEpoch {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  sessionId           String   @map("session_id") @db.Uuid
  epoch               Int
  boundaryAguiRunId   String?  @map("boundary_agui_run_id")
  validatedHandoffRef String?  @map("validated_handoff_ref")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  session AgentSession @relation("AgentSessionEpochs", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([sessionId, epoch], map: "agent_context_epochs_session_epoch_key")
  @@unique([id, organizationId], map: "agent_context_epochs_id_org_key")
  @@index([organizationId, sessionId])
  @@index([sessionId, organizationId])
  @@map("agent_context_epochs")
}

/// @namespace AgentOS
/// @describe Immutable session-scoped authority and capability decision used to authorize AgentOS executions.
model AgentPolicySnapshot {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  sessionId                 String   @map("session_id") @db.Uuid
  agentVersionId            String   @map("agent_version_id") @db.Uuid
  authorityProfileVersionId String   @map("authority_profile_version_id")
  capabilityKeys            Json     @map("capability_keys") @db.JsonB
  policyHash                String   @map("policy_hash")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization            Organization                 @relation("AgentPolicySnapshotOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  session                 AgentSession                 @relation("AgentSessionPolicySnapshots", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  agentVersion            AgentVersion                 @relation("AgentPolicySnapshotAgentVersion", fields: [agentVersionId], references: [id], onDelete: Restrict)
  authorityProfileVersion AgentAuthorityProfileVersion @relation("AgentPolicySnapshotAuthorityProfileVersion", fields: [authorityProfileVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  executions              AgentExecution[]             @relation("AgentExecutionPolicySnapshot")

  @@unique([id, organizationId], map: "agent_policy_snapshots_id_org_key")
  @@unique([id, sessionId, organizationId], map: "agent_policy_snapshots_id_session_org_key")
  @@unique([organizationId, sessionId, agentVersionId, authorityProfileVersionId, policyHash], map: "agent_policy_snapshots_deterministic_key")
  @@index([organizationId, agentVersionId, createdAt])
  @@index([sessionId, organizationId])
  @@index([agentVersionId])
  @@map("agent_policy_snapshots")
}

/// @namespace AgentOS
/// @describe Required session/task-owned interaction execution and terminal control state.
model AgentExecution {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  sessionTaskId    String    @map("session_task_id") @db.Uuid
  copilotThreadId  String    @map("copilot_thread_id")
  aguiRunId        String    @map("agui_run_id")
  agentVersionId   String    @map("agent_version_id") @db.Uuid
  runtimeType      String    @map("runtime_type")
  modelIdentity    String    @map("model_identity")
  policySnapshotId String    @map("policy_snapshot_id") @db.Uuid
  inputHash        String    @map("input_hash")
  currentInput     Json      @default("{}") @map("current_input") @db.JsonB
  resourceRefs     Json      @default("[]") @map("resource_refs") @db.JsonB
  attempt          Int       @default(1)
  status           String
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz
  errorCode        String?   @map("error_code")

  organization   Organization             @relation("AgentExecutionOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  session        AgentSession             @relation("AgentSessionExecutions", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sessionTask    AgentSessionTask         @relation("AgentSessionTaskExecutions", fields: [sessionTaskId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Restrict)
  agentVersion   AgentVersion             @relation("AgentExecutionAgentVersion", fields: [agentVersionId], references: [id], onDelete: Restrict)
  policySnapshot AgentPolicySnapshot      @relation("AgentExecutionPolicySnapshot", fields: [policySnapshotId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Restrict)
  events         AgentConversationEvent[] @relation("AgentExecutionEvents")
  usage          AgentExecutionUsage[]    @relation("AgentExecutionUsages")
  attempts       AgentExecutionAttempt[]  @relation("AgentExecutionAttempts")
  approvals      AgentSessionApproval[]   @relation("AgentExecutionApprovals")
  artifacts      AgentSessionArtifact[]   @relation("AgentExecutionArtifacts")

  @@unique([id, organizationId], map: "agent_executions_id_org_key")
  @@unique([id, sessionId, organizationId], map: "agent_executions_id_session_org_key")
  @@unique([id, sessionTaskId, sessionId, organizationId], map: "agent_executions_id_task_session_org_key")
  @@unique([organizationId, copilotThreadId, aguiRunId], map: "agent_executions_org_thread_agui_run_key")
  @@index([organizationId, sessionId, status])
  @@index([sessionId, organizationId])
  @@index([sessionTaskId, sessionId, organizationId])
  @@index([agentVersionId])
  @@index([policySnapshotId, sessionId, organizationId])
  @@map("agent_executions")
}

/// @namespace AgentOS
/// @describe Canonical append-only conversation event with organization-fenced session and execution ownership.
model AgentConversationEvent {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  sessionId       String   @map("session_id") @db.Uuid
  executionId     String?  @map("execution_id") @db.Uuid
  externalEventId String   @map("external_event_id")
  sequence        BigInt   @db.BigInt
  eventType       String   @map("event_type")
  schemaVersion   Int      @map("schema_version")
  payload         Json     @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  session   AgentSession             @relation("AgentSessionEvents", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  execution AgentExecution?          @relation("AgentExecutionEvents", fields: [executionId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Restrict)
  outbox    AgentConversationOutbox? @relation("AgentConversationEventOutbox")

  @@unique([sessionId, sequence], map: "agent_conversation_events_session_sequence_key")
  @@unique([organizationId, externalEventId], map: "agent_conversation_events_org_external_event_key")
  @@unique([id, organizationId], map: "agent_conversation_events_id_org_key")
  @@index([organizationId, sessionId, createdAt])
  @@index([sessionId, organizationId])
  @@index([executionId, sessionId, organizationId])
  @@map("agent_conversation_events")
}

/// @namespace AgentOS
/// @describe Transactional publication marker referencing canonical conversation content without copying its payload.
model AgentConversationOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  eventId        String    @unique(map: "agent_conversation_outboxes_event_key") @map("event_id") @db.Uuid
  attemptCount   Int       @default(0) @map("attempt_count")
  publishedAt    DateTime? @map("published_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz

  event AgentConversationEvent @relation("AgentConversationEventOutbox", fields: [eventId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId], map: "agent_conversation_outboxes_id_org_key")
  @@unique([eventId, organizationId], map: "agent_conversation_outboxes_event_org_key")
  @@index([publishedAt, createdAt])
  @@map("agent_conversation_outboxes")
}

/// @namespace AgentOS
/// @describe Immutable model usage and cost record attached to an organization-scoped interaction execution.
model AgentExecutionUsage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  executionId    String   @map("execution_id") @db.Uuid
  modelIdentity  String   @map("model_identity")
  provider       String
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  costMicros     BigInt   @map("cost_micros") @db.BigInt
  currency       String   @default("USD")
  recordedAt     DateTime @default(now()) @map("recorded_at") @db.Timestamptz

  organization Organization   @relation("AgentExecutionUsageOrganization", fields: [organizationId], references: [id], onDelete: Restrict)
  execution    AgentExecution @relation("AgentExecutionUsages", fields: [executionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@index([organizationId, executionId, recordedAt])
  @@index([executionId, organizationId])
  @@map("agent_execution_usages")
}

/// @namespace AgentOS
/// @describe Immutable parent-child task delegation with a bounded authority subset and stable idempotency identity.
model AgentSessionTaskDelegation {
  id                        String    @id @default(uuid()) @db.Uuid
  organizationId            String    @map("organization_id") @db.Uuid
  sessionId                 String    @map("session_id") @db.Uuid
  parentTaskId              String    @map("parent_task_id") @db.Uuid
  childTaskId               String    @map("child_task_id") @db.Uuid
  fromAgentVersionId        String    @map("from_agent_version_id") @db.Uuid
  toAgentVersionId          String    @map("to_agent_version_id") @db.Uuid
  authorityProfileVersionId String    @map("authority_profile_version_id")
  authoritySubset           Json      @map("authority_subset") @db.JsonB
  depth                     Int
  idempotencyKey            String    @map("idempotency_key")
  state                     String
  createdAt                 DateTime  @default(now()) @map("created_at") @db.Timestamptz
  finishedAt                DateTime? @map("finished_at") @db.Timestamptz

  session                 AgentSession                 @relation("AgentSessionTaskDelegations", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  parentTask              AgentSessionTask             @relation("AgentSessionTaskOutgoingDelegations", fields: [parentTaskId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Restrict)
  childTask               AgentSessionTask             @relation("AgentSessionTaskIncomingDelegation", fields: [childTaskId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Restrict)
  fromAgentVersion        AgentVersion                 @relation("AgentTaskDelegationFromVersion", fields: [fromAgentVersionId], references: [id], onDelete: Restrict)
  toAgentVersion          AgentVersion                 @relation("AgentTaskDelegationToVersion", fields: [toAgentVersionId], references: [id], onDelete: Restrict)
  authorityProfileVersion AgentAuthorityProfileVersion @relation("AgentTaskDelegationAuthorityProfileVersion", fields: [authorityProfileVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([sessionId, parentTaskId, idempotencyKey], map: "agent_session_task_delegations_parent_idempotency_key")
  @@unique([childTaskId, sessionId, organizationId], map: "agent_session_task_delegations_child_session_org_key")
  @@unique([id, organizationId], map: "agent_session_task_delegations_id_org_key")
  @@index([organizationId, sessionId, state])
  @@index([sessionId, organizationId])
  @@index([parentTaskId, sessionId, organizationId])
  @@index([childTaskId, sessionId, organizationId])
  @@index([fromAgentVersionId])
  @@index([toAgentVersionId])
  @@index([authorityProfileVersionId, organizationId])
  @@map("agent_session_task_delegations")
}

/// @namespace AgentOS
/// @describe One immutable numbered runtime attempt and its opaque reconnect handle identity.
model AgentExecutionAttempt {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  sessionId          String    @map("session_id") @db.Uuid
  executionId        String    @map("execution_id") @db.Uuid
  attemptNumber      Int       @map("attempt_number")
  idempotencyKey     String    @map("idempotency_key")
  runtimeType        String    @map("runtime_type")
  externalRunId      String?   @map("external_run_id")
  encryptedHandleRef String?   @map("encrypted_handle_ref")
  runtimeGeneration  Int       @default(0) @map("runtime_generation")
  state              String
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt         DateTime? @map("finished_at") @db.Timestamptz
  errorCode          String?   @map("error_code")
  errorMessage       String?   @map("error_message") @db.Text

  execution         AgentExecution                          @relation("AgentExecutionAttempts", fields: [executionId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Cascade)
  operationBindings AgentExecutionAttemptOperationBinding[] @relation("AgentExecutionAttemptOperationBindings")
  approvals         AgentSessionApproval[]                  @relation("AgentSessionApprovalAttempt")

  @@unique([executionId, attemptNumber], map: "agent_execution_attempts_execution_number_key")
  @@unique([executionId, idempotencyKey], map: "agent_execution_attempts_execution_idempotency_key")
  @@unique([id, executionId, sessionId, organizationId], map: "agent_execution_attempts_id_execution_session_org_key")
  @@index([organizationId, state, startedAt])
  @@index([executionId, sessionId, organizationId])
  @@index([externalRunId])
  @@map("agent_execution_attempts")
}

/// @namespace AgentOS
/// @describe Immutable lifecycle-envelope binding for one durable Agent execution attempt. A successor OperationRun retains the same external runtime handle and references the previous immutable OperationRun.
model AgentExecutionAttemptOperationBinding {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  executionAttemptId        String   @map("execution_attempt_id") @db.Uuid
  executionId               String   @map("execution_id") @db.Uuid
  sessionId                 String   @map("session_id") @db.Uuid
  operationRunId            String   @map("operation_run_id") @db.Uuid
  predecessorOperationRunId String?  @map("predecessor_operation_run_id") @db.Uuid
  continuationKey           String   @map("continuation_key")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz

  attempt                 AgentExecutionAttempt @relation("AgentExecutionAttemptOperationBindings", fields: [executionAttemptId, executionId, sessionId, organizationId], references: [id, executionId, sessionId, organizationId], onDelete: Restrict)
  operationRun            OperationRun          @relation("AgentExecutionAttemptOperationBindingOperationRun", fields: [operationRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  predecessorOperationRun OperationRun?         @relation("AgentExecutionAttemptOperationBindingPredecessorRun", fields: [predecessorOperationRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  approvals               AgentSessionApproval[] @relation("AgentSessionApprovalOperationBinding")

  @@unique([id, organizationId], map: "agent_execution_attempt_operation_bindings_id_org_key")
  @@unique([operationRunId, organizationId], map: "agent_attempt_op_bindings_operation_run_org_key")
  @@unique([organizationId, executionAttemptId, continuationKey], map: "agent_attempt_op_bindings_org_attempt_continuation_key")
  @@index([organizationId, executionAttemptId, createdAt])
  @@index([predecessorOperationRunId, organizationId])
  @@map("agent_execution_attempt_operation_bindings")
}

/// @namespace AgentOS
/// @describe Invocation-scoped human approval request and immutable terminal decision identity, bound to the exact OperationRun envelope that requested it.
model AgentSessionApproval {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  sessionId              String    @map("session_id") @db.Uuid
  taskId                 String    @map("task_id") @db.Uuid
  executionId            String    @map("execution_id") @db.Uuid
  attemptId              String    @map("attempt_id") @db.Uuid
  operationBindingId     String    @map("operation_binding_id") @db.Uuid
  predecessorOperationRunId String @map("predecessor_operation_run_id") @db.Uuid
  capabilityKey          String    @map("capability_key")
  argumentsHash          String    @map("arguments_hash")
  resourceSnapshot       Json      @map("resource_snapshot") @db.JsonB
  state                  String
  expiresAt              DateTime  @map("expires_at") @db.Timestamptz
  idempotencyKey         String    @map("idempotency_key")
  decisionIdempotencyKey String?   @map("decision_idempotency_key")
  decidedByActorType     String?   @map("decided_by_actor_type")
  decidedByActorId       String?   @map("decided_by_actor_id")
  requestedAt            DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  decidedAt              DateTime? @map("decided_at") @db.Timestamptz

  session   AgentSession          @relation("AgentSessionApprovals", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  task      AgentSessionTask      @relation("AgentSessionTaskApprovals", fields: [taskId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Restrict)
  execution AgentExecution        @relation("AgentExecutionApprovals", fields: [executionId, taskId, sessionId, organizationId], references: [id, sessionTaskId, sessionId, organizationId], onDelete: Restrict)
  attempt   AgentExecutionAttempt @relation("AgentSessionApprovalAttempt", fields: [attemptId, executionId, sessionId, organizationId], references: [id, executionId, sessionId, organizationId], onDelete: Restrict)
  operationBinding AgentExecutionAttemptOperationBinding @relation("AgentSessionApprovalOperationBinding", fields: [operationBindingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  predecessorOperationRun OperationRun @relation("AgentSessionApprovalPredecessorOperationRun", fields: [predecessorOperationRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  continuation AgentSessionApprovalContinuation?

  @@unique([executionId, idempotencyKey], map: "agent_session_approvals_execution_idempotency_key")
  @@unique([organizationId, decisionIdempotencyKey], map: "agent_session_approvals_org_decision_idempotency_key")
  @@unique([id, organizationId], map: "agent_session_approvals_id_org_key")
  @@index([organizationId, sessionId, state, expiresAt])
  @@index([sessionId, organizationId])
  @@index([taskId, sessionId, organizationId])
  @@index([executionId, taskId, sessionId, organizationId])
  @@index([attemptId, executionId, sessionId, organizationId])
  @@index([operationBindingId, organizationId])
  @@index([predecessorOperationRunId, organizationId])
  @@map("agent_session_approvals")
}

/// @namespace AgentOS
/// @describe Durable approval-continuation outbox. It records successor-envelope creation and exact idempotent runtime interrupt delivery separately.
model AgentSessionApprovalContinuation {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  approvalId            String    @map("approval_id") @db.Uuid
  successorOperationRunId String? @map("successor_operation_run_id") @db.Uuid
  state                 String    @default("pending")
  interruptDeliveredAt  DateTime? @map("interrupt_delivered_at") @db.Timestamptz
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  approval     AgentSessionApproval @relation(fields: [approvalId, organizationId], references: [id, organizationId], onDelete: Cascade)
  successorOperationRun OperationRun? @relation("AgentSessionApprovalContinuationSuccessorRun", fields: [successorOperationRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([approvalId, organizationId], map: "agent_session_approval_continuations_approval_org_key")
  @@unique([successorOperationRunId, organizationId], map: "agent_session_approval_continuations_successor_run_org_key")
  @@index([organizationId, state, createdAt])
  @@map("agent_session_approval_continuations")
}

/// @namespace AgentOS
/// @describe Immutable content-addressed artifact reference owned by one durable session task and execution.
model AgentSessionArtifact {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  sessionId        String    @map("session_id") @db.Uuid
  taskId           String    @map("task_id") @db.Uuid
  executionId      String    @map("execution_id") @db.Uuid
  artifactType     String    @map("artifact_type")
  storageReference String    @map("storage_reference")
  sha256           String
  metadata         Json      @default("{}") @db.JsonB
  lifecycle        String    @default("active")
  idempotencyKey   String    @map("idempotency_key")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  supersededAt     DateTime? @map("superseded_at") @db.Timestamptz

  session   AgentSession     @relation("AgentSessionArtifacts", fields: [sessionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  task      AgentSessionTask @relation("AgentSessionTaskArtifacts", fields: [taskId, sessionId, organizationId], references: [id, sessionId, organizationId], onDelete: Restrict)
  execution AgentExecution   @relation("AgentExecutionArtifacts", fields: [executionId, taskId, sessionId, organizationId], references: [id, sessionTaskId, sessionId, organizationId], onDelete: Restrict)

  @@unique([executionId, idempotencyKey], map: "agent_session_artifacts_execution_idempotency_key")
  @@unique([id, organizationId], map: "agent_session_artifacts_id_org_key")
  @@index([organizationId, sha256])
  @@index([sessionId, organizationId])
  @@index([taskId, sessionId, organizationId])
  @@index([executionId, taskId, sessionId, organizationId])
  @@map("agent_session_artifacts")
}

/// @namespace AgentOS
/// @describe Organization-owned runnable subject. Type must match the code-owned Agent Definition Registry.
model AgentInstance {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  type               String
  name               String
  role               String    @default("specialist")
  title              String?
  icon               String?
  reportsToId        String?   @map("reports_to_id") @db.Uuid
  lifecycleStatus    String    @default("active") @map("lifecycle_status")
  pauseReason        String?   @map("pause_reason")
  pausedAt           DateTime? @map("paused_at") @db.Timestamptz
  trustLevel         Int       @default(0) @map("trust_level")
  adapterType        String    @map("adapter_type")
  modelOverride      String?   @map("model_override")
  adapterConfig      Json      @default("{}") @map("adapter_config") @db.JsonB
  runtimeConfig      Json      @default("{}") @map("runtime_config") @db.JsonB
  promptPathOverride String?   @map("prompt_path_override")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization         Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent               AgentInstance?            @relation("AgentInstanceHierarchy", fields: [reportsToId], references: [id], onDelete: SetNull)
  children             AgentInstance[]           @relation("AgentInstanceHierarchy")
  runtimeState         AgentRuntimeState?
  requests             AgentRunRequest[]
  runs                 AgentRun[]
  events               AgentRunEvent[]
  taskSessions         AgentTaskSession[]
  instanceToolPolicies AgentInstanceToolPolicy[]
  authorizationEvents  AgentAuthorizationEvent[]
  approvalRequests     AgentApprovalRequest[]
  costEvents           AgentCostEvent[]
  agentUsers           User[]
  conversationMessages AgentMessage[]
  toolInvocations      AgentToolInvocation[]
  artifacts            AgentArtifact[]

  @@unique([organizationId, type])
  @@index([organizationId])
  @@index([reportsToId])
  @@index([organizationId, lifecycleStatus])
  @@index([organizationId, reportsToId])
  @@map("agent_instances")
}

/// @namespace AgentOS
/// @describe Frequently-changing per-instance runtime state (last run, totals, cached aggregates). 1:1 with AgentInstance.
model AgentRuntimeState {
  id                      String    @id @default(uuid()) @db.Uuid
  organizationId          String    @map("organization_id") @db.Uuid
  agentInstanceId         String    @unique @map("agent_instance_id") @db.Uuid
  lastRunId               String?   @map("last_run_id") @db.Uuid
  lastRunStatus           String?   @map("last_run_status")
  lastError               String?   @map("last_error") @db.Text
  lastHeartbeatAt         DateTime? @map("last_heartbeat_at") @db.Timestamptz
  consecutiveFailureCount Int       @default(0) @map("consecutive_failure_count")
  totalRuns               Int       @default(0) @map("total_runs")
  totalInputTokens        Int       @default(0) @map("total_input_tokens")
  totalOutputTokens       Int       @default(0) @map("total_output_tokens")
  totalCostMicros         BigInt    @default(0) @map("total_cost_micros")
  stateJson               Json      @default("{}") @map("state_json") @db.JsonB
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentInstance AgentInstance @relation(fields: [agentInstanceId], references: [id], onDelete: Cascade)
  lastRun       AgentRun?     @relation("AgentRuntimeStateLastRun", fields: [lastRunId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([lastRunId])
  @@map("agent_runtime_states")
}

/// @namespace AgentOS
/// @describe Per-task durable session. taskKey defaults to "default" only at API boundary.
model AgentTaskSession {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  agentInstanceId String   @map("agent_instance_id") @db.Uuid
  adapterType     String   @map("adapter_type")
  taskKey         String   @map("task_key")
  title           String?
  metadata        Json     @default("{}") @db.JsonB
  sessionParams   Json?    @map("session_params") @db.JsonB
