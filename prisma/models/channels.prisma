// Channels owns selling definitions, account/listing identity, registration executions and source publication.

/// @namespace Channels
/// @describe Current organization-scoped, read-only Sellpia manual-match evidence restricted to exact aliases used by current channel listings.
model SellpiaManualMatchSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @unique @map("organization_id") @db.Uuid
  targetCount        Int      @map("target_count")
  matchedTargetCount Int      @map("matched_target_count")
  aliasCount         Int      @map("alias_count")
  snapshotHash       String   @map("snapshot_hash") @db.VarChar(64)
  capturedAt         DateTime @map("captured_at") @db.Timestamptz

  aliases SellpiaManualMatchAlias[]

  @@unique([id, organizationId], map: "sellpia_manual_match_snapshots_id_org_key")
  @@index([organizationId, capturedAt])
  @@map("sellpia_manual_match_snapshots")
}

/// @namespace Channels
/// @describe Exact normalized marketplace-title evidence linking one historical Sellpia manual match to an active physical SKU and positive unit quantity.
model SellpiaManualMatchAlias {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  snapshotId      String @map("snapshot_id") @db.Uuid
  masterProductId String @map("master_product_id") @db.Uuid
  aliasTitle      String @map("alias_title") @db.VarChar(500)
  normalizedAlias String @map("normalized_alias") @db.VarChar(500)
  itemCount       Int    @map("item_count")
  matchedType     String @map("matched_type") @db.VarChar(1)
  evidenceCount   Int    @map("evidence_count")

  snapshot SellpiaManualMatchSnapshot @relation(fields: [snapshotId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([organizationId, normalizedAlias, masterProductId, itemCount], map: "sellpia_manual_match_aliases_org_alias_master_qty_key")
  @@index([organizationId, normalizedAlias])
  @@index([snapshotId])
  @@index([organizationId, masterProductId])
  @@map("sellpia_manual_match_aliases")
}

/// @namespace Channels
/// @describe 채널별 상품/광고/트래픽 스크래핑 실행 단위. 원본 row 는 ChannelScrapeSnapshot 에 저장.
model ChannelScrapeRun {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  channelAccountId  String  @map("channel_account_id") @db.Uuid
  clientRunKey      String? @map("client_run_key") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid

  channel      String
  source       String
  pageType     String    @map("page_type")
  businessDate DateTime? @map("business_date") @db.Date
  periodStart  DateTime? @map("period_start") @db.Date
  periodEnd    DateTime? @map("period_end") @db.Date

  status        String  @default("running")
  targetUrl     String? @map("target_url")
  period        String?
  parserVersion String? @map("parser_version")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  metaJson  Json? @map("meta_json")
  errorJson Json? @map("error_json")

  channelAccount ChannelAccount          @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  chunks         ChannelScrapeChunk[]
  snapshots      ChannelScrapeSnapshot[]

  @@unique([id, organizationId], map: "channel_scrape_runs_id_org_key")
  @@unique([organizationId, channelAccountId, source, clientRunKey], map: "channel_scrape_runs_org_account_source_client_key", where: raw("client_run_key IS NOT NULL"))
  @@index([organizationId, channel, source, businessDate])
  @@index([organizationId, status, startedAt])
  @@index([startedAt])
  @@index([channelAccountId])
  @@index([sourceImportRunId])
  @@map("channel_scrape_runs")
}

/// @namespace Channels
/// @describe Browser catalog collection payloads kept in JSONB until an atomic publication succeeds.
model ChannelScrapeChunk {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  scrapeRunId    String @map("scrape_run_id") @db.Uuid

  kind      String
  sequence  Int
  checksum  String
  itemCount Int    @map("item_count")
  payload   Json   @db.JsonB

  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  publicationJson Json?     @map("publication_json") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  scrapeRun ChannelScrapeRun @relation(fields: [scrapeRunId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([scrapeRunId, kind, sequence], map: "channel_scrape_chunks_run_kind_sequence_key")
  @@index([organizationId, scrapeRunId])
  @@index([scrapeRunId, kind])
  @@map("channel_scrape_chunks")
}

/// @namespace Channels
/// @describe 채널 스크래퍼/API 가 본 원본 row. 매칭 실패/파서 변경 대비 rawJson 을 보존.
model ChannelScrapeSnapshot {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  scrapeRunId       String? @map("scrape_run_id") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid

  channel      String
  source       String
  pageType     String    @map("page_type")
  businessDate DateTime? @map("business_date") @db.Date
  observedAt   DateTime  @default(now()) @map("observed_at") @db.Timestamptz

  externalId       String? @map("external_id")
  externalOptionId String? @map("external_option_id")
  listingId        String? @map("listing_id") @db.Uuid
  listingOptionId  String? @map("listing_option_id") @db.Uuid

  matchStatus String  @default("unmatched") @map("match_status")
  matchReason String? @map("match_reason")
  rowHash     String? @map("row_hash")

  rawJson        Json  @map("raw_json")
  normalizedJson Json? @map("normalized_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  scrapeRun     ChannelScrapeRun?     @relation(fields: [scrapeRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  listing       ChannelListing?       @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  listingOption ChannelListingOption? @relation(fields: [listingOptionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  listingDailySnapshots ChannelListingDailySnapshot[]       @relation("ListingDailyRawSnapshot")
  optionDailySnapshots  ChannelListingOptionDailySnapshot[] @relation("OptionDailyRawSnapshot")

  @@unique([id, organizationId], map: "channel_scrape_snapshots_id_org_key")
  // PostgreSQL stores IN (...) as = ANY (ARRAY[...]); any other spelling makes db push re-plan the index (KID-143).
  @@unique([sourceImportRunId, organizationId], map: "channel_scrape_snapshots_serp_capture_key", where: raw("source_import_run_id IS NOT NULL AND source = ANY (ARRAY['coupang_keyword_serp'::text, 'coupang_wing_rank'::text])"))
  @@index([sourceImportRunId, organizationId])
  @@index([organizationId, channel, source, businessDate])
  @@index([organizationId, channel, pageType, businessDate])
  @@index([scrapeRunId])
  @@index([listingId, businessDate])
  @@index([listingOptionId, businessDate])
  @@index([organizationId, channel, externalId])
  @@index([organizationId, channel, externalOptionId])
  @@index([organizationId, matchStatus])
  @@index([observedAt])
  @@map("channel_scrape_snapshots")
}

/// @namespace Channels
/// @describe 채널 listing 의 일별 정규화 상태. 반복 scrape 는 businessDate row 를 upsert.
model ChannelListingDailySnapshot {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  listingId      String @map("listing_id") @db.Uuid

  channel      String
  externalId   String   @map("external_id")
  businessDate DateTime @map("business_date") @db.Date

  productName    String? @map("product_name")
  status         String?
  exposureStatus String? @map("exposure_status")
  saleStatus     String? @map("sale_status")
  channelPrice   Int?    @map("channel_price")

  reviewCount Int?     @map("review_count")
  avgRating   Decimal? @map("avg_rating") @db.Decimal(4, 2)

  isOfferWinner  Boolean? @map("is_offer_winner")
  myPrice        Int?     @map("my_price")
  winnerPrice    Int?     @map("winner_price")
  winnerGapPrice Int?     @map("winner_gap_price")

  productRank  Int? @map("product_rank")
  categoryRank Int? @map("category_rank")

  // Traffic additive metrics (Hard rewrite H1)
  trafficVisitors   Int       @default(0) @map("traffic_visitors")
  trafficViews      Int       @default(0) @map("traffic_views")
  trafficCartAdds   Int       @default(0) @map("traffic_cart_adds")
  trafficOrders     Int       @default(0) @map("traffic_orders")
  trafficSalesQty   Int       @default(0) @map("traffic_sales_qty")
  trafficRevenue    Int       @default(0) @map("traffic_revenue")
  trafficObservedAt DateTime? @map("traffic_observed_at") @db.Timestamptz

  sampleCount     Int      @default(1) @map("sample_count")
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz
  lastObservedAt  DateTime @default(now()) @map("last_observed_at") @db.Timestamptz
  rawSnapshotId   String?  @map("raw_snapshot_id") @db.Uuid

  metaJson  Json?    @map("meta_json")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  listing     ChannelListing         @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  rawSnapshot ChannelScrapeSnapshot? @relation("ListingDailyRawSnapshot", fields: [rawSnapshotId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, listingId, businessDate])
  @@index([organizationId, channel, externalId, businessDate])
  @@index([rawSnapshotId])
  @@index([organizationId, businessDate])
  @@index([listingId, businessDate])
  @@index([organizationId, channel, businessDate])
  @@index([organizationId, isOfferWinner])
  @@map("channel_listing_daily_snapshots")
}

/// @namespace Channels
/// @describe 채널 listing option/vendor item 의 일별 정규화 상태.
model ChannelListingOptionDailySnapshot {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  listingId       String @map("listing_id") @db.Uuid
  listingOptionId String @map("listing_option_id") @db.Uuid

  channel          String
  externalId       String   @map("external_id")
  externalOptionId String   @map("external_option_id")
  businessDate     DateTime @map("business_date") @db.Date

  optionName String?  @map("option_name")
  salePrice  Int?     @map("sale_price")
  stockQty   Int?     @map("stock_qty")
  saleStatus String?  @map("sale_status")
  isActive   Boolean? @map("is_active")

  isOfferWinner  Boolean? @map("is_offer_winner")
  myPrice        Int?     @map("my_price")
  winnerPrice    Int?     @map("winner_price")
  winnerGapPrice Int?     @map("winner_gap_price")

  sampleCount     Int      @default(1) @map("sample_count")
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz
  lastObservedAt  DateTime @default(now()) @map("last_observed_at") @db.Timestamptz
  rawSnapshotId   String?  @map("raw_snapshot_id") @db.Uuid

  metaJson  Json?    @map("meta_json")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  listing       ChannelListing         @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  listingOption ChannelListingOption   @relation(fields: [listingOptionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  rawSnapshot   ChannelScrapeSnapshot? @relation("OptionDailyRawSnapshot", fields: [rawSnapshotId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, listingOptionId, businessDate])
  @@index([organizationId, channel, externalId, externalOptionId, businessDate])
  @@index([rawSnapshotId])
  @@index([organizationId, businessDate])
  @@index([listingId, businessDate])
  @@index([listingOptionId, businessDate])
  @@index([organizationId, externalOptionId])
  @@map("channel_listing_option_daily_snapshots")
}

/// @namespace Channels
/// @describe Agent-triggered registration mutation receipt keyed by the exact Channels owner input, atomically retained with local listing resolution.
model ChannelRegistrationOwnerIdempotencyReceipt {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  capabilityKey       String @map("capability_key") @db.VarChar(120)
  ownerIdempotencyKey String @map("owner_idempotency_key") @db.VarChar(128)
  requestHash         String @map("request_hash") @db.VarChar(64)
  resultJson          Json   @map("result_json") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, capabilityKey, ownerIdempotencyKey], map: "channel_registration_owner_receipts_org_capability_key")
  @@index([organizationId])
  @@map("channel_registration_owner_idempotency_receipts")
}

/// @namespace Channels
/// @describe Channel listing 삭제의 provider side effect 실행 기록. 삭제 대상 외부 listing identity를 요청 시점에 동결한다.
model ChannelListingDeletionOperation {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  channelAccountId String @map("channel_account_id") @db.Uuid
  channelListingId String @map("channel_listing_id") @db.Uuid

  idempotencyKey            String @map("idempotency_key")
  requestHash               String @map("request_hash")
  externalListingId         String @map("external_listing_id")
  expectedProviderAccountId String @map("expected_provider_account_id")

  status          String @default("prepared")
  providerOutcome String @default("not_attempted") @map("provider_outcome")

  resultJson       Json?   @map("result_json") @db.JsonB
  lastErrorCode    String? @map("last_error_code")
  lastErrorMessage String? @map("last_error_message")

  leaseToken             String?   @map("lease_token") @db.Uuid
  leaseClaimedAt         DateTime? @map("lease_claimed_at") @db.Timestamptz
  requestedByUserId      String?   @map("requested_by_user_id") @db.Uuid
  authorizationExpiresAt DateTime? @map("authorization_expires_at") @db.Timestamptz
  startedAt              DateTime? @map("started_at") @db.Timestamptz
  completedAt            DateTime? @map("completed_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  channelAccount ChannelAccount @relation("ChannelAccountListingDeletionOperations", fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  channelListing ChannelListing @relation("ChannelListingDeletionOperations", fields: [channelListingId, organizationId, channelAccountId], references: [id, organizationId, channelAccountId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey], map: "channel_listing_deletion_operations_org_idempotency_key")
  @@unique([organizationId, channelListingId], map: "channel_listing_deletion_operations_active_listing_key", where: raw("status = ANY (ARRAY['prepared'::text, 'executing'::text, 'reconciling'::text])"))
  @@index([channelAccountId])
  @@index([channelListingId])
  @@index([requestedByUserId])
  @@index([organizationId, status, createdAt])
  @@map("channel_listing_deletion_operations")
}

// ── 몰 작업 관찰 기록 ───────────────────────────────────────────────────────
//
// 몰 송신 프로필은 `ChannelAccount.config.listingProfile`, 고시·KC 는 수집상품 초안
// (`SourcingCandidate.rawData.manualBasics`)에 둔다(KID-107). 새 표는 원천 owner 가 없는
// 브라우저 몰 작업 기록 하나뿐이다.

/// @namespace Channels
/// @describe One frozen registration intent. A reusable target has many executions; one active execution per target and idempotent requests prevent duplicate submissions (ADR-0020).
model ProductRegistrationExecution {
  id                   String  @id @default(uuid()) @db.Uuid
  organizationId       String  @map("organization_id") @db.Uuid
  registrationTargetId String? @map("registration_target_id") @db.Uuid
  channelAccountId     String  @map("channel_account_id") @db.Uuid
  channelListingId     String? @map("channel_listing_id") @db.Uuid

  executionKind             String  @default("create") @map("execution_kind")
  expectedProviderAccountId String? @map("expected_provider_account_id")
  idempotencyKey            String  @map("idempotency_key")
  requestHash               String  @map("request_hash")
  ownerIdempotencyKey       String? @map("owner_idempotency_key")

  submissionPayloadJson Json?   @map("submission_payload_json") @db.JsonB
  submissionPayloadHash String? @map("submission_payload_hash")

  status          String @default("prepared")
  providerOutcome String @default("not_attempted") @map("provider_outcome")

  providerSubmissionId String? @map("provider_submission_id")
  externalListingId    String? @map("external_listing_id")
  resultJson           Json?   @map("result_json") @db.JsonB
  lastErrorCode        String? @map("last_error_code")
  lastErrorMessage     String? @map("last_error_message")

  leaseToken        String?   @map("lease_token") @db.Uuid
  leaseClaimedAt    DateTime? @map("lease_claimed_at") @db.Timestamptz
  reviewPayloadHash String?   @map("review_payload_hash")
  approvedAt        DateTime? @map("approved_at") @db.Timestamptz
  approvedByUserId  String?   @map("approved_by_user_id") @db.Uuid
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  startedAt         DateTime? @map("started_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  channelAccount ChannelAccount      @relation("ChannelAccountProductRegistrationExecutions", fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  channelListing ChannelListing?     @relation("ChannelListingProductRegistrationExecutions", fields: [channelListingId, organizationId, channelAccountId], references: [id, organizationId, channelAccountId], onDelete: Restrict)
  preparation    RegistrationTarget? @relation(fields: [registrationTargetId, organizationId, channelAccountId], references: [id, organizationId, channelAccountId], onDelete: Restrict)

  @@unique([organizationId, idempotencyKey], map: "product_registration_executions_org_idempotency_key")
  @@unique([organizationId, registrationTargetId], map: "product_registration_executions_target_pending_key", where: raw("status = ANY (ARRAY['prepared'::text, 'executing'::text, 'reconciling'::text])"))
  @@unique([organizationId, channelListingId], map: "product_registration_executions_active_listing_key", where: raw("channel_listing_id IS NOT NULL AND status = ANY (ARRAY['prepared'::text, 'executing'::text, 'reconciling'::text])"))
  @@unique([organizationId, channelAccountId, externalListingId], map: "product_registration_executions_active_external_listing_key", where: raw("external_listing_id IS NOT NULL AND status = ANY (ARRAY['prepared'::text, 'executing'::text, 'reconciling'::text])"))
  @@index([registrationTargetId])
  @@index([channelAccountId])
  @@index([channelListingId])
  @@index([requestedByUserId])
  @@index([approvedByUserId])
  @@index([organizationId, status, createdAt])
  @@map("product_registration_executions")
}

/// @namespace Channels
/// @describe Channels-owned common selling product identified by its KID. Reusable registration targets select its options and override its defaults; inventory and ABC remain Products-owned (ADR-0020).
model SalesProduct {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  /// 발급된 KID(판매상품코드). 사방넷에서 옮긴 상품은 사방넷 품번코드다.
  /// 팔기로 정한 시점에 발급한다 — 아직 정하지 않은 초안은 비어 있다.
  code                 String?  @db.VarChar(60)
  /// 자체상품코드(사방넷에서 중복 불가). 비어 있을 수 있다.
  ownCode              String?  @map("own_code") @db.VarChar(100)
  sabangnetGoodsNo     String?  @map("sabangnet_goods_no") @db.VarChar(30)
  name                 String   @db.VarChar(255)
  shortName            String?  @map("short_name") @db.VarChar(255)
  englishName          String?  @map("english_name") @db.VarChar(255)
  printName            String?  @map("print_name") @db.VarChar(255)
  modelName            String?  @map("model_name") @db.VarChar(60)
  modelNo              String?  @map("model_no") @db.VarChar(60)
  brand                String?  @db.VarChar(50)
  manufacturer         String?  @db.VarChar(50)
  originCountry        String?  @map("origin_country") @db.VarChar(50)
  originRegion         String?  @map("origin_region") @db.VarChar(50)
  keywords             String[] @default([])
  standardCategory     String?  @map("standard_category") @db.VarChar(40)
  /// 상세설명 본문(사람이 쓰는 글). 몰 상세 HTML(detailHtml)과 다르다.
  description          String   @default("")
  /// 누구에게 파는 상품인가(예: '3~5세 여아').
  targetAudience       String?  @map("target_audience") @db.VarChar(200)
  /// 연령대 표기(예: '36개월 이상').
  ageGroup             String?  @map("age_group") @db.VarChar(100)
  /// 상품 크기 한 줄(예: '가로 30 x 세로 20cm').
  productSize          String?  @map("product_size") @db.VarChar(200)
  /// 색상 이름 목록. 옵션 단과 달리 문서에 적는 설명값이다.
  colorVariantNames    String[] @default([]) @map("color_variant_names")
  /// 한 박스에 들어가는 개수.
  boxSetQuantity       Int?     @map("box_set_quantity")
  /// 몰 공통 등록 문서 입력값. 몰별 값은 RegistrationTarget.registrationInput 이다.
  registrationDefaults Json?    @map("registration_defaults")
  /// draft | active | paused | sold_out | unused | archived.
  /// `draft` 는 판매(selling) 옵션 중 판매가가 비어 있다는 뜻이다 — 저장할 때마다 다시 판정한다.
  /// paused · sold_out · unused · archived 는 사람이 정한 상태라 그대로 둔다.
  status               String   @default("active")
  /// taxable | tax_free | zero_rated | unknown
  taxType              String   @default("taxable") @map("tax_type")
  /// free | collect | prepay | collect_or_prepay
  deliveryFeeType      String?  @map("delivery_fee_type")
  deliveryFee          Int?     @map("delivery_fee")
  /// 옵션 단 제목(최대 3). 비어 있으면 옵션 없는 단일 상품이다.
  optionAxes           String[] @default([]) @map("option_axes")
  stockManaged         Boolean  @default(false) @map("stock_managed")
  /// [0] 대표, 그다음 추가 사진 순서.
  imageUrls            String[] @default([]) @map("image_urls")
  detailHtml           String?  @map("detail_html")
  extraDetailHtml      String[] @default([]) @map("extra_detail_html")
  /// 사방넷 속성분류코드(상품정보고시)와 그 순서대로의 값.
  noticeCategory       String?  @map("notice_category") @db.VarChar(10)
  noticeValues         String[] @default([]) @map("notice_values")
  /// 인증 문서 목록(번호 · 기관 · 분야 · 유효기간 · 발급일 · 인증일 · 이미지).
  certifications       Json?
  importDeclarationNo  String?  @map("import_declaration_no") @db.VarChar(60)
  adminMemo            String?  @map("admin_memo")
  /// 가져온 원문 한 줄(사방넷 엑셀 칸 그대로). 화면은 읽지 않는다.
  sourceRaw            Json?    @map("source_raw")
  /// 이 초안을 만든 원천 기록(SourcingCandidate)의 id. Sourcing 소유라 외래키 없이 id 만 둔다.
  /// 후보 하나에 초안 하나다 — 원천 기록을 가리키는 포인터일 뿐, 후보를 지워도 초안은 남는다.
  sourceCandidateId    String?  @map("source_candidate_id") @db.Uuid
  /// 원천 장터(1688 · coupang · sabangnet …). 초안을 만들 때 후보에서 복사하고 바꾸지 않는다.
  /// 목록의 원천 탭이 Sourcing 조인 없이 걸러지도록 여기에 둔다.
  sourcePlatform       String?  @map("source_platform") @db.VarChar(40)
  /// 원천 상품 주소. sourcePlatform 과 같은 시점에 복사하고 바꾸지 않는다.
  sourceUrl            String?  @map("source_url")
  version              Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  options             SalesProductOption[]
  registrationTargets RegistrationTarget[]
  channelListings     ChannelListing[]     @relation("ChannelListingSalesProduct")

  @@unique([organizationId, code], map: "sales_products_org_code_key", where: raw("code IS NOT NULL"))
  @@unique([organizationId, ownCode], map: "sales_products_org_own_code_key", where: raw("own_code IS NOT NULL"))
  @@unique([organizationId, sabangnetGoodsNo], map: "sales_products_org_sabangnet_goods_key", where: raw("sabangnet_goods_no IS NOT NULL"))
  @@unique([organizationId, sourceCandidateId], map: "sales_products_org_source_candidate_key", where: raw("source_candidate_id IS NOT NULL"))
  @@unique([id, organizationId], map: "sales_products_id_org_key")
  @@index([organizationId, status])
  /// 수집상품 탭: 조직 · 원천 장터 · 상태로 거르고 updatedAt desc, id desc 로 정렬한다.
  /// 정렬 열이 동등 조건 열 뒤에 와야 색인 하나로 걸러 낸 뒤 정렬 없이 읽는다.
  @@index([organizationId, sourcePlatform, status, updatedAt, id])
  @@index([organizationId, updatedAt, id])
  @@map("sales_products")
}

/// @namespace Channels
/// @describe Selling composition with a stable UUID, issued KID and final option price. Its template is not operational inventory; confirmed channel recipes own that composition (ADR-0020).
model SalesProductOption {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @map("organization_id") @db.Uuid
  salesProductId      String   @map("sales_product_id") @db.Uuid
  /// 발급된 KID(단품코드). 상품과 같은 시점에 발급하므로 초안의 단품은 비어 있다.
  /// 가져오기 정체성(사방넷 단품코드)은 아래 별도 칸이다.
  optionCode          String?  @map("option_code") @db.VarChar(80)
  sabangnetOptionCode String?  @map("sabangnet_option_code") @db.VarChar(80)
  /// SalesProduct.optionAxes 순서대로의 값.
  values              String[] @default([])
  /// values 를 ':' 로 이은 값. 옵션 없는 상품은 ''.
  optionKey           String   @map("option_key") @db.VarChar(500)
  alias               String?  @db.VarChar(100)
  barcode             String?  @db.VarChar(60)
  /// 판매가. 초안은 아직 정하지 않아 비어 있을 수 있다 — 비어 있으면 상품이 `draft` 이고 등록 · 몰 시트 · 품절에서 막힌다.
  salePrice           Int?     @map("sale_price")
  normalPrice         Int?     @map("normal_price")
  /// selling | sold_out | unused
  supplyStatus        String   @default("selling") @map("supply_status")
  safetyStock         Int?     @map("safety_stock")
  sortOrder           Int      @default(0) @map("sort_order")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  salesProduct           SalesProduct                  @relation(fields: [salesProductId, organizationId], references: [id, organizationId], onDelete: Cascade)
  components             SalesProductOptionComponent[]
  channelListingOptions  ChannelListingOption[]        @relation("ChannelListingOptionSalesProductOption")
  registrationSelections RegistrationTargetOption[]

  @@unique([salesProductId, optionKey], map: "sales_product_options_active_key", where: raw("supply_status <> 'unused'"))
  @@unique([id, organizationId], map: "sales_product_options_id_org_key")
  @@index([organizationId, optionCode])
  @@index([salesProductId, organizationId])
  @@index([organizationId, barcode])
  @@map("sales_product_options")
}

/// @namespace Channels
/// @describe Declared source composition for a selling option. Applied to an empty channel recipe only by an explicit request; never a capacity source (ADR-0020).
model SalesProductOptionComponent {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  salesProductOptionId String   @map("sales_product_option_id") @db.Uuid
  masterProductId      String   @map("master_product_id") @db.Uuid
  quantity             Int
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  salesProductOption SalesProductOption @relation(fields: [salesProductOptionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([salesProductOptionId, masterProductId])
  @@index([organizationId, salesProductOptionId], map: "sales_product_option_components_org_option_idx")
  @@index([organizationId, masterProductId], map: "sales_product_option_components_org_master_product_idx")
  @@map("sales_product_option_components")
}

/// @namespace Channels
/// @describe Public copy of a sales-product image or detail image that malls can download (우리 저장소는 사무실 밖에서 열리지 않는다). Keyed by our storage URL; the sales product keeps its own URL and mall bulk sheets use the copy (ADR-0014).
model SalesProductPublicImage {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// 우리 저장소 주소(판매상품 사진 · 상세설명 속 사진).
  sourceUrl      String   @map("source_url")
  /// 몰이 가져갈 수 있는 공개 주소.
  publicUrl      String   @map("public_url")
  /// 올린 곳(`kidsnote` = 키즈노트 첨부 저장소).
  host           String   @db.VarChar(40)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([organizationId, sourceUrl])
  @@map("sales_product_public_images")
}

/// @namespace Channels
/// @describe Persistent registration target with explicit marketplace overrides. Executions freeze submitted values separately (ADR-0020).
model RegistrationTarget {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  salesProductId String @map("sales_product_id") @db.Uuid
  version        Int    @default(1)

  channelAccountId String @map("channel_account_id") @db.Uuid

  archivedAt DateTime? @map("archived_at") @db.Timestamptz

  displayName String? @map("display_name")

  selectedThumbnailUrl                   String? @map("selected_thumbnail_url")
  selectedThumbnailGenerationId          String? @map("selected_thumbnail_generation_id") @db.Uuid
  selectedThumbnailGenerationCandidateId String? @map("selected_thumbnail_generation_candidate_id") @db.Uuid
  selectedDetailPageArtifactId           String? @map("selected_detail_page_artifact_id") @db.Uuid
  selectedDetailPageRevisionId           String? @map("selected_detail_page_revision_id") @db.Uuid
  selectedDetailPageGenerationId         String? @map("selected_detail_page_generation_id") @db.Uuid

  registrationInput Json @default("{}") @map("registration_input")

  createdByUserId String?  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  channelAccount ChannelAccount @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)

  salesProduct    SalesProduct                   @relation(fields: [salesProductId, organizationId], references: [id, organizationId], onDelete: Restrict)
  selectedOptions RegistrationTargetOption[]
  executions      ProductRegistrationExecution[]

  @@unique([id, organizationId])
  @@unique([id, organizationId, channelAccountId], map: "registration_targets_id_org_account_key")
  /// 상품 × 몰 계정당 활성 등록 설정은 하나다. 행사용 등록은 별도 판매상품으로 만든다.
  @@unique([organizationId, salesProductId, channelAccountId], map: "registration_targets_org_product_account_active_key", where: raw("archived_at IS NULL"))
  @@index([salesProductId, organizationId])
  @@index([organizationId, archivedAt])
  @@index([channelAccountId])
  @@index([selectedDetailPageArtifactId])
  @@index([selectedDetailPageRevisionId])
  @@index([selectedDetailPageGenerationId])
  @@index([selectedThumbnailGenerationId])
  @@index([selectedThumbnailGenerationCandidateId])
  @@index([createdByUserId])
  @@map("registration_targets")
}

/// @namespace Channels
/// @describe Selected common option and explicit price overrides for one persistent registration target.
model RegistrationTargetOption {
  id                   String @id @default(uuid()) @db.Uuid
  organizationId       String @map("organization_id") @db.Uuid
  registrationTargetId String @map("registration_target_id") @db.Uuid
  salesProductOptionId String @map("sales_product_option_id") @db.Uuid
  sortOrder            Int    @default(0) @map("sort_order")
  salePrice            Int?   @map("sale_price")
  normalPrice          Int?   @map("normal_price")
  supplyPrice          Int?   @map("supply_price")

  preparation RegistrationTarget @relation(fields: [registrationTargetId, organizationId], references: [id, organizationId], onDelete: Cascade)
  option      SalesProductOption @relation(fields: [salesProductOptionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([registrationTargetId, salesProductOptionId])
  @@index([salesProductOptionId, organizationId])
  @@index([organizationId])
  @@map("registration_target_options")
}

/// @namespace Channels
/// @describe ChannelAccount canonical state owned by channels.
/// @namespace Core
/// @describe Marketplace/store account such as Coupang Wing or Naver SmartStore. Operational channel ownership is distinct from the SaaS organization.
model ChannelAccount {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  channel           String
  name              String
  externalAccountId String?  @map("external_account_id")
  sellerId          String?  @map("seller_id")
  vendorId          String?  @map("vendor_id")
  status            String   @default("active")
  isPrimary         Boolean  @default(false) @map("is_primary")
  config            Json?    @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  listings                         ChannelListing[]
  productPreparations              RegistrationTarget[]
  productRegistrationExecutions    ProductRegistrationExecution[]    @relation("ChannelAccountProductRegistrationExecutions")
  channelListingDeletionOperations ChannelListingDeletionOperation[] @relation("ChannelAccountListingDeletionOperations")
  channelScrapeRuns                ChannelScrapeRun[]

  @@unique([organizationId, channel, externalAccountId])
  @@unique([id, organizationId], map: "channel_accounts_id_org_key")
  @@index([organizationId, channel])
  @@index([organizationId, isPrimary])
  @@map("channel_accounts")
}

/// @namespace Channels
/// @describe ChannelListing canonical state owned by channels.
/// @namespace Channels
/// @describe 채널에 올라간 판매 등록상품. 쿠팡 등록상품ID, 네이버 상품번호 등.
model ChannelListing {
  salesProductId   String?       @map("sales_product_id") @db.Uuid
  salesProduct     SalesProduct? @relation("ChannelListingSalesProduct", fields: [salesProductId, organizationId], references: [id, organizationId], onDelete: Restrict)
  id               String        @id @default(uuid()) @db.Uuid
  organizationId   String        @map("organization_id") @db.Uuid
  channelAccountId String        @map("channel_account_id") @db.Uuid

  externalId String @map("external_id")

  channelName     String? @map("channel_name")
  displayName     String? @map("display_name")
  category        String?
  brand           String?
  manufacturer    String?
  /// 몰이 들고 있는 대표 사진. 상품 화면이 콘텐츠 작업물 다음으로 이 값을 쓴다.
  imageUrl        String? @map("image_url")
  rawJson         Json?   @map("raw_json")
  lastImportRunId String? @map("last_import_run_id") @db.Uuid

  status         String?
  exposureStatus String? @map("exposure_status")

  deliveryChargeType String? @map("delivery_charge_type")
  freeShipOverAmount Int?    @map("free_ship_over_amount")
  returnCharge       Int?    @map("return_charge")
  deliveryInfo       Json?   @map("delivery_info")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  channelAccount                ChannelAccount                    @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  options                       ChannelListingOption[]
  productRegistrationExecutions ProductRegistrationExecution[]    @relation("ChannelListingProductRegistrationExecutions")
  deletionOperations            ChannelListingDeletionOperation[] @relation("ChannelListingDeletionOperations")

  // Channels — market-data snapshots (Wave C0)
  channelScrapeSnapshots             ChannelScrapeSnapshot[]
  channelListingDailySnapshots       ChannelListingDailySnapshot[]
  channelListingOptionDailySnapshots ChannelListingOptionDailySnapshot[]

  // Channels — daily fact extensions (Hard rewrite H1)

  @@unique([organizationId, channelAccountId, externalId])
  @@unique([id, organizationId], map: "channel_listings_id_org_key")
  @@unique([id, organizationId, channelAccountId], map: "channel_listings_id_org_account_key")
  @@index([organizationId, salesProductId])
  @@index([organizationId])
  @@index([channelAccountId])
  @@index([lastImportRunId])
  @@index([organizationId, channelAccountId, isActive])
  @@index([organizationId, updatedAt, id])
  @@map("channel_listings")
}

/// @namespace Channels
/// @describe ChannelListingOption canonical state owned by channels.
/// @namespace Core
/// @describe One sellable SKU under a channel listing.
model ChannelListingOption {
  salesProductOptionId String? @map("sales_product_option_id") @db.Uuid
  id                   String  @id @default(uuid()) @db.Uuid
  listingId            String  @map("listing_id") @db.Uuid
  organizationId       String  @map("organization_id") @db.Uuid

  externalOptionId String  @map("external_option_id") @db.VarChar(60)
  kidItemCode      String? @map("kid_item_code") @db.VarChar(11)
  itemName         String? @map("item_name")
  salePrice        Int?    @map("sale_price")
  sellerSku        String? @map("seller_sku")
  barcode          String?
  modelNumber      String? @map("model_number")
  status           String?
  attributesJson   Json?   @map("attributes_json")
  rawJson          Json?   @map("raw_json")
  lastImportRunId  String? @map("last_import_run_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  safetyStock Int      @default(0) @map("safety_stock")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  listing             ChannelListing                           @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  salesProductOption  SalesProductOption?                      @relation("ChannelListingOptionSalesProductOption", fields: [salesProductOptionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventoryComponents ChannelListingOptionInventoryComponent[]

  // Channels — market-data snapshots (Wave C0)
  channelScrapeSnapshots             ChannelScrapeSnapshot[]
  channelListingOptionDailySnapshots ChannelListingOptionDailySnapshot[]

  // Channels — daily fact extensions (Hard rewrite H1)

  @@unique([listingId, externalOptionId])
  @@unique([id, organizationId], map: "channel_listing_options_id_org_key")
  @@index([kidItemCode], map: "channel_listing_options_kid_item_code_idx")
  @@index([organizationId, externalOptionId])
  @@index([externalOptionId])
  @@index([lastImportRunId])
  @@index([organizationId, salesProductOptionId])
  @@map("channel_listing_options")
}

/// @namespace Channels
/// @describe ChannelListingOptionInventoryComponent canonical state owned by channels.
/// @namespace Channels
/// @describe Confirmed source-product quantities for one channel sellable option.
model ChannelListingOptionInventoryComponent {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  channelListingOptionId String   @map("channel_listing_option_id") @db.Uuid
  masterProductId        String   @map("master_product_id") @db.Uuid
  quantity               Int
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz

  channelListingOption ChannelListingOption @relation(fields: [channelListingOptionId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([channelListingOptionId, masterProductId])
  @@index([organizationId, channelListingOptionId], map: "channel_option_inventory_components_org_option_idx")
  @@index([organizationId, masterProductId], map: "channel_option_inventory_components_org_master_product_idx")
  @@map("channel_listing_option_inventory_components")
}
