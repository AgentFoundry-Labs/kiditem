/// @namespace Channels
/// @describe Sellpia 판매현황(sale_summary) 몰별·일별 매출 fact. order_search.ajax.html(mode=selldate, 주문일자 기준)에서 판매처(seller)별로 수집. channelGroup 으로 rocket(쿠팡-직배송) / others(쿠팡윙+기타 전체몰) 버킷을 구분해 대시보드 '몰별 매출' 섹션에 표시한다. price=판매금액, buy_price=매입금액, amount=판매수량.
model SellpiaSalesDailySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid
  businessDate   DateTime @map("business_date") @db.Date

  sellerId     String @map("seller_id") // Sellpia 판매처 id (예 "129")
  sellerName   String @map("seller_name") // 판매처명 (예 "쿠팡-직배송")
  channelGroup String @map("channel_group") // "rocket" | "others" — 대시보드 버킷 분류

  revenueKrw Int @default(0) @map("revenue_krw") // 판매금액 합계 (price, KRW)
  qty        Int @default(0) @map("qty") // 판매수량 (amount)
  costKrw    Int @default(0) @map("cost_krw") // 매입금액 합계 (buy_price, KRW)

  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz // 수집 시각 (staleness 판단용)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation("SellpiaSalesSource", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, sourceImportRunId, businessDate, sellerId], map: "sellpia_sales_daily_source_run_key", where: raw("source_import_run_id IS NOT NULL"))
  @@unique([organizationId, businessDate, sellerId], map: "sellpia_sales_daily_legacy_key", where: raw("source_import_run_id IS NULL"))
  @@index([organizationId, sourceImportRunId, businessDate])
  @@index([organizationId, businessDate])
  @@index([organizationId, channelGroup, businessDate])
  @@map("sellpia_sales_daily_snapshots")
}

/// @namespace Channels
/// @describe Sellpia 상품별 이익현황(stat_prd_profit) 월별 판매수량(재고 소진) fact. stat_action.ajax.html(mode=stat_prd_profit)의 graph(월별 매입액/판매액/판매수량)에서 상품×옵션×연월로 수집. 재고관리용 1개월/2개월 평균 소진량 산정 소스. 메이크샵 주문 데이터 기준.
model SellpiaProductMonthlySales {
  id                    String  @id @default(uuid()) @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  sourceImportRunId     String? @map("source_import_run_id") @db.Uuid
  sellpiaInventorySkuId String? @map("sellpia_inventory_sku_id") @db.Uuid
  masterProductId       String? @map("master_product_id") @db.Uuid

  productCode String @map("product_code") // Sellpia 상품코드
  optionCode  String @map("option_code") // 옵션코드
  yearMonth   String @map("year_month") // "YYYY-MM" (KST 캘린더 월)

  orderQty          Int       @default(0) @map("order_qty") // 월 판매수량 = 재고 소진량
  orderAmount       Int       @default(0) @map("order_amount") // 월 판매금액
  inQty             Int       @default(0) @map("in_qty") // 월 매입수량
  inAmount          Int       @default(0) @map("in_amount") // 월 매입금액
  costBasis         String    @default("UNKNOWN") @map("cost_basis") // 원가 기준: ORDER_TIME_SUPPLY_COST만 매출총이익 ABC에 사용
  vatIncluded       Boolean?  @map("vat_included") // 공급가 VAT 포함 여부; 원가 출처가 명시된 수집만 true
  coverageStartDate DateTime? @map("coverage_start_date") @db.Date // 요청 범위와 해당 월의 실제 교집합 시작일
  coverageEndDate   DateTime? @map("coverage_end_date") @db.Date // 요청 범위와 해당 월의 실제 교집합 종료일

  // 상품 메타 (최신 스냅샷)
  productName  String  @map("product_name")
  optionName   String? @map("option_name")
  providerName String? @map("provider_name") // 매입처/공급사
  salePrice    Int     @default(0) @map("sale_price")
  buyPrice     Int     @default(0) @map("buy_price")
  barcode      String? @map("barcode") // dp_code

  capturedAt DateTime @default(now()) @map("captured_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization              Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun           SourceImportRun?     @relation("SellpiaProductMonthlySourceImport", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  frozenSellpiaInventorySku SellpiaInventorySku? @relation("SellpiaProductMonthlyFrozenSku", fields: [sellpiaInventorySkuId, organizationId], references: [id, organizationId], onDelete: Restrict)
  frozenMasterProduct       MasterProduct?       @relation("SellpiaProductMonthlyFrozenMaster", fields: [masterProductId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, sourceImportRunId, productCode, optionCode, yearMonth], map: "sellpia_product_monthly_sales_generation_identity_key", where: raw("source_import_run_id IS NOT NULL"))
  @@unique([organizationId, productCode, optionCode, yearMonth], map: "sellpia_product_monthly_sales_legacy_identity_key", where: raw("source_import_run_id IS NULL"))
  @@index([organizationId, yearMonth])
  @@index([organizationId, sourceImportRunId, yearMonth])
  @@index([sourceImportRunId, organizationId])
  @@index([organizationId, sellpiaInventorySkuId])
  @@index([organizationId, masterProductId])
  @@index([organizationId, productCode, optionCode])
  @@map("sellpia_product_monthly_sales")
}

/// @namespace Channels
/// @describe Agent-triggered registration mutation receipt keyed by the exact Channels owner input, atomically retained with local listing resolution.
model ChannelRegistrationOwnerIdempotencyReceipt {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  capabilityKey       String @map("capability_key") @db.VarChar(120)
  ownerIdempotencyKey String @map("owner_idempotency_key") @db.VarChar(128)
  requestHash         String @map("request_hash") @db.VarChar(64)
  resultJson          Json   @map("result_json") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation("ChannelRegistrationOwnerIdempotencyReceiptOrganization", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, capabilityKey, ownerIdempotencyKey], map: "channel_registration_owner_receipts_org_capability_key")
  @@index([organizationId])
  @@map("channel_registration_owner_idempotency_receipts")
}

/// @namespace Channels
/// @describe Channel listing 삭제의 provider side effect 실행 기록. 삭제 대상 외부 listing identity를 요청 시점에 동결한다.
model ChannelListingDeletionOperation {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  channelAccountId String @map("channel_account_id") @db.Uuid
  channelListingId String @map("channel_listing_id") @db.Uuid

  idempotencyKey            String @map("idempotency_key")
  requestHash               String @map("request_hash")
  externalListingId         String @map("external_listing_id")
  expectedProviderAccountId String @map("expected_provider_account_id")

  status          String @default("prepared")
  providerOutcome String @default("not_attempted") @map("provider_outcome")

  resultJson       Json?   @map("result_json") @db.JsonB
  lastErrorCode    String? @map("last_error_code")
  lastErrorMessage String? @map("last_error_message")

  leaseToken             String?   @map("lease_token") @db.Uuid
  leaseClaimedAt         DateTime? @map("lease_claimed_at") @db.Timestamptz
  requestedByUserId      String?   @map("requested_by_user_id") @db.Uuid
  authorizationExpiresAt DateTime? @map("authorization_expires_at") @db.Timestamptz
  startedAt              DateTime? @map("started_at") @db.Timestamptz
  completedAt            DateTime? @map("completed_at") @db.Timestamptz
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization   @relation("ChannelListingDeletionOperationOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  channelAccount  ChannelAccount @relation("ChannelAccountListingDeletionOperations", fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  channelListing  ChannelListing @relation("ChannelListingDeletionOperations", fields: [channelListingId, organizationId, channelAccountId], references: [id, organizationId, channelAccountId], onDelete: Restrict)
  requestedByUser User?          @relation("ChannelListingDeletionOperationRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey], map: "channel_listing_deletion_operations_org_idempotency_key")
  @@unique([organizationId, channelListingId], map: "channel_listing_deletion_operations_active_listing_key", where: raw("status = ANY (ARRAY['prepared'::text, 'executing'::text, 'reconciling'::text])"))
  @@index([channelAccountId])
  @@index([channelListingId])
  @@index([requestedByUserId])
  @@index([organizationId, status, createdAt])
  @@map("channel_listing_deletion_operations")
}
