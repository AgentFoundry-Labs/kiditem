// channels.prisma — Channel market-data foundation (Wave C0)
//
// Provides a channel-generic schema layer for raw scrape capture and daily
// listing/option state snapshots. `channel = "coupang"` is row data, not a
// table name — provider-specific column names live only in adapter DTOs and
// `rawJson`/`metaJson`. See `.omx/plans/channel-market-data-daily-snapshots-plan.md`.
//
// C0 scope: schema foundation only. No service/runtime change in this PR.
// Subsequent waves (C1 product identity sync, C2 raw scrape dual-write,
// C3 daily upserts, C4 strategy reads) wire ingestion paths.

/// @namespace Channels
/// @describe Current organization-scoped, read-only Sellpia manual-match evidence restricted to exact aliases used by current channel listings.
model SellpiaManualMatchSnapshot {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @unique @map("organization_id") @db.Uuid
  sourceOrigin       String   @default("https://kiditem.sellpia.com") @map("source_origin")
  sourcePath         String   @default("/product_manual_match.html") @map("source_path")
  schemaVersion      Int      @default(1) @map("schema_version")
  targetCount        Int      @map("target_count")
  matchedTargetCount Int      @map("matched_target_count")
  aliasCount         Int      @map("alias_count")
  snapshotHash       String   @map("snapshot_hash") @db.VarChar(64)
  capturedAt         DateTime @map("captured_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  aliases      SellpiaManualMatchAlias[]

  @@unique([id, organizationId], map: "sellpia_manual_match_snapshots_id_org_key")
  @@index([organizationId, capturedAt])
  @@map("sellpia_manual_match_snapshots")
}

/// @namespace Channels
/// @describe Exact normalized marketplace-title evidence linking one historical Sellpia manual match to an active physical SKU and positive unit quantity.
model SellpiaManualMatchAlias {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  snapshotId            String   @map("snapshot_id") @db.Uuid
  sellpiaInventorySkuId String   @map("sellpia_inventory_sku_id") @db.Uuid
  aliasTitle            String   @map("alias_title") @db.VarChar(500)
  normalizedAlias       String   @map("normalized_alias") @db.VarChar(500)
  itemCount             Int      @map("item_count")
  matchedType           String   @map("matched_type") @db.VarChar(1)
  evidenceCount         Int      @map("evidence_count")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization        Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot            SellpiaManualMatchSnapshot @relation(fields: [snapshotId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sellpiaInventorySku SellpiaInventorySku        @relation(fields: [sellpiaInventorySkuId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, normalizedAlias, sellpiaInventorySkuId, itemCount], map: "sellpia_manual_match_aliases_org_alias_sku_qty_key")
  @@index([organizationId, normalizedAlias])
  @@index([snapshotId])
  @@index([sellpiaInventorySkuId])
  @@map("sellpia_manual_match_aliases")
}

/// @namespace Channels
/// @describe 채널별 상품/광고/트래픽 스크래핑 실행 단위. 원본 row 는 ChannelScrapeSnapshot 에 저장.
model ChannelScrapeRun {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  channelAccountId  String  @map("channel_account_id") @db.Uuid
  clientRunKey      String? @map("client_run_key") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid

  channel      String
  source       String
  pageType     String    @map("page_type")
  businessDate DateTime? @map("business_date") @db.Date
  periodStart  DateTime? @map("period_start") @db.Date
  periodEnd    DateTime? @map("period_end") @db.Date

  status        String  @default("running")
  targetUrl     String? @map("target_url")
  period        String?
  parserVersion String? @map("parser_version")

  rowCount       Int @default(0) @map("row_count")
  matchedCount   Int @default(0) @map("matched_count")
  unmatchedCount Int @default(0) @map("unmatched_count")
  errorCount     Int @default(0) @map("error_count")

  startedAt  DateTime  @default(now()) @map("started_at") @db.Timestamptz
  finishedAt DateTime? @map("finished_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  metaJson  Json? @map("meta_json")
  errorJson Json? @map("error_json")

  organization    Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelAccount  ChannelAccount          @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceImportRun SourceImportRun?        @relation(fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  chunks          ChannelScrapeChunk[]
  snapshots       ChannelScrapeSnapshot[]

  @@unique([id, organizationId], map: "channel_scrape_runs_id_org_key")
  @@unique([organizationId, channelAccountId, source, clientRunKey], map: "channel_scrape_runs_org_account_source_client_key", where: raw("client_run_key IS NOT NULL"))
  @@index([organizationId, channel, source, businessDate])
  @@index([organizationId, status, startedAt])
  @@index([startedAt])
  @@index([channelAccountId])
  @@index([sourceImportRunId])
  @@map("channel_scrape_runs")
}

/// @namespace Channels
/// @describe Browser catalog collection payloads kept in JSONB until an atomic publication succeeds.
model ChannelScrapeChunk {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  scrapeRunId    String @map("scrape_run_id") @db.Uuid

  kind      String
  sequence  Int
  checksum  String
  itemCount Int    @map("item_count")
  payload   Json   @db.JsonB

  publishedAt     DateTime? @map("published_at") @db.Timestamptz
  publicationJson Json?     @map("publication_json") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scrapeRun    ChannelScrapeRun @relation(fields: [scrapeRunId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([scrapeRunId, kind, sequence], map: "channel_scrape_chunks_run_kind_sequence_key")
  @@index([organizationId, scrapeRunId])
  @@index([scrapeRunId, kind])
  @@map("channel_scrape_chunks")
}

/// @namespace Channels
/// @describe 채널 스크래퍼/API 가 본 원본 row. 매칭 실패/파서 변경 대비 rawJson 을 보존.
model ChannelScrapeSnapshot {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  scrapeRunId       String? @map("scrape_run_id") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid

  channel      String
  source       String
  pageType     String    @map("page_type")
  businessDate DateTime? @map("business_date") @db.Date
  observedAt   DateTime  @default(now()) @map("observed_at") @db.Timestamptz

  externalId       String? @map("external_id")
  externalOptionId String? @map("external_option_id")
  listingId        String? @map("listing_id") @db.Uuid
  listingOptionId  String? @map("listing_option_id") @db.Uuid

  matchStatus String  @default("unmatched") @map("match_status")
  matchReason String? @map("match_reason")
  rowHash     String? @map("row_hash")

  rawJson        Json  @map("raw_json")
  normalizedJson Json? @map("normalized_json")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  scrapeRun       ChannelScrapeRun?     @relation(fields: [scrapeRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceImportRun SourceImportRun?      @relation("KeywordSerpCapture", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  listing         ChannelListing?       @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  listingOption   ChannelListingOption? @relation(fields: [listingOptionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  listingDailySnapshots  ChannelListingDailySnapshot[]       @relation("ListingDailyRawSnapshot")
  optionDailySnapshots   ChannelListingOptionDailySnapshot[] @relation("OptionDailyRawSnapshot")
  adTargetDailySnapshots ChannelAdTargetDailySnapshot[]      @relation("AdTargetDailyRawSnapshot")
  accountKpiSnapshots    ChannelAccountDailyKpiSnapshot[]    @relation("AccountKpiRawSnapshot")

  @@unique([id, organizationId], map: "channel_scrape_snapshots_id_org_key")
  @@unique([sourceImportRunId, organizationId], map: "channel_scrape_snapshots_serp_capture_key", where: raw("source_import_run_id IS NOT NULL AND source IN ('coupang_keyword_serp', 'coupang_wing_rank')"))
  @@index([sourceImportRunId, organizationId])
  @@index([organizationId, channel, source, businessDate])
  @@index([organizationId, channel, pageType, businessDate])
  @@index([scrapeRunId])
  @@index([listingId, businessDate])
  @@index([listingOptionId, businessDate])
  @@index([organizationId, channel, externalId])
  @@index([organizationId, channel, externalOptionId])
  @@index([organizationId, matchStatus])
  @@index([observedAt])
  @@map("channel_scrape_snapshots")
}

/// @namespace Channels
/// @describe 채널 listing 의 일별 정규화 상태. 반복 scrape 는 businessDate row 를 upsert.
model ChannelListingDailySnapshot {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  listingId      String @map("listing_id") @db.Uuid

  channel      String
  externalId   String   @map("external_id")
  businessDate DateTime @map("business_date") @db.Date

  productName    String? @map("product_name")
  status         String?
  exposureStatus String? @map("exposure_status")
  saleStatus     String? @map("sale_status")
  channelPrice   Int?    @map("channel_price")

  reviewCount Int?     @map("review_count")
  avgRating   Decimal? @map("avg_rating") @db.Decimal(4, 2)

  isOfferWinner  Boolean? @map("is_offer_winner")
  myPrice        Int?     @map("my_price")
  winnerPrice    Int?     @map("winner_price")
  winnerGapPrice Int?     @map("winner_gap_price")

  productRank  Int? @map("product_rank")
  categoryRank Int? @map("category_rank")

  // Ad additive metrics (Hard rewrite H1) — sums only, ratios recompute in reads.
  adSpend              Int       @default(0) @map("ad_spend")
  adRevenue            Int       @default(0) @map("ad_revenue")
  adImpressions        Int       @default(0) @map("ad_impressions")
  adClicks             Int       @default(0) @map("ad_clicks")
  adConversions        Int       @default(0) @map("ad_conversions")
  adOrders             Int       @default(0) @map("ad_orders")
  adDirectOrders1d     Int       @default(0) @map("ad_direct_orders_1d")
  adIndirectOrders1d   Int       @default(0) @map("ad_indirect_orders_1d")
  adDirectQty1d        Int       @default(0) @map("ad_direct_qty_1d")
  adIndirectQty1d      Int       @default(0) @map("ad_indirect_qty_1d")
  adDirectRevenue1d    Int       @default(0) @map("ad_direct_revenue_1d")
  adIndirectRevenue1d  Int       @default(0) @map("ad_indirect_revenue_1d")
  adTotalOrders14d     Int       @default(0) @map("ad_total_orders_14d")
  adDirectOrders14d    Int       @default(0) @map("ad_direct_orders_14d")
  adIndirectOrders14d  Int       @default(0) @map("ad_indirect_orders_14d")
  adTotalQty14d        Int       @default(0) @map("ad_total_qty_14d")
  adDirectQty14d       Int       @default(0) @map("ad_direct_qty_14d")
  adIndirectQty14d     Int       @default(0) @map("ad_indirect_qty_14d")
  adTotalRevenue14d    Int       @default(0) @map("ad_total_revenue_14d")
  adDirectRevenue14d   Int       @default(0) @map("ad_direct_revenue_14d")
  adIndirectRevenue14d Int       @default(0) @map("ad_indirect_revenue_14d")
  adCoverageStatus     String?   @map("ad_coverage_status")
  adObservedAt         DateTime? @map("ad_observed_at") @db.Timestamptz

  // Traffic additive metrics (Hard rewrite H1)
  trafficVisitors       Int       @default(0) @map("traffic_visitors")
  trafficViews          Int       @default(0) @map("traffic_views")
  trafficCartAdds       Int       @default(0) @map("traffic_cart_adds")
  trafficOrders         Int       @default(0) @map("traffic_orders")
  trafficSalesQty       Int       @default(0) @map("traffic_sales_qty")
  trafficRevenue        Int       @default(0) @map("traffic_revenue")
  trafficCoverageStatus String?   @map("traffic_coverage_status")
  trafficObservedAt     DateTime? @map("traffic_observed_at") @db.Timestamptz

  sampleCount     Int      @default(1) @map("sample_count")
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz
  lastObservedAt  DateTime @default(now()) @map("last_observed_at") @db.Timestamptz
  rawSnapshotId   String?  @map("raw_snapshot_id") @db.Uuid

  metaJson  Json?    @map("meta_json")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      ChannelListing         @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  rawSnapshot  ChannelScrapeSnapshot? @relation("ListingDailyRawSnapshot", fields: [rawSnapshotId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, listingId, businessDate])
  @@index([organizationId, channel, externalId, businessDate])
  @@index([rawSnapshotId])
  @@index([organizationId, businessDate])
  @@index([listingId, businessDate])
  @@index([organizationId, channel, businessDate])
  @@index([organizationId, isOfferWinner])
  @@map("channel_listing_daily_snapshots")
}

/// @namespace Channels
/// @describe 채널 listing option/vendor item 의 일별 정규화 상태.
model ChannelListingOptionDailySnapshot {
  id              String @id @default(uuid()) @db.Uuid
  organizationId  String @map("organization_id") @db.Uuid
  listingId       String @map("listing_id") @db.Uuid
  listingOptionId String @map("listing_option_id") @db.Uuid

  channel          String
  externalId       String   @map("external_id")
  externalOptionId String   @map("external_option_id")
  businessDate     DateTime @map("business_date") @db.Date

  optionName String?  @map("option_name")
  salePrice  Int?     @map("sale_price")
  stockQty   Int?     @map("stock_qty")
  saleStatus String?  @map("sale_status")
  isActive   Boolean? @map("is_active")

  isOfferWinner  Boolean? @map("is_offer_winner")
  myPrice        Int?     @map("my_price")
  winnerPrice    Int?     @map("winner_price")
  winnerGapPrice Int?     @map("winner_gap_price")

  sampleCount     Int      @default(1) @map("sample_count")
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz
  lastObservedAt  DateTime @default(now()) @map("last_observed_at") @db.Timestamptz
  rawSnapshotId   String?  @map("raw_snapshot_id") @db.Uuid

  metaJson  Json?    @map("meta_json")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing       ChannelListing         @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  listingOption ChannelListingOption   @relation(fields: [listingOptionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  rawSnapshot   ChannelScrapeSnapshot? @relation("OptionDailyRawSnapshot", fields: [rawSnapshotId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, listingOptionId, businessDate])
  @@index([organizationId, channel, externalId, externalOptionId, businessDate])
  @@index([rawSnapshotId])
  @@index([organizationId, businessDate])
  @@index([listingId, businessDate])
  @@index([listingOptionId, businessDate])
  @@index([organizationId, externalOptionId])
  @@map("channel_listing_option_daily_snapshots")
}

/// @namespace Channels
/// @describe 채널 광고 타겟(캠페인/키워드/상품)의 일별 정규화 fact. 기간 view 는 SUM 으로 derive.
model ChannelAdTargetDailySnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  channelAccountId String   @map("channel_account_id") @db.Uuid
  channel          String
  businessDate     DateTime @map("business_date") @db.Date

  listingId        String? @map("listing_id") @db.Uuid
  listingOptionId  String? @map("listing_option_id") @db.Uuid
  externalId       String? @map("external_id")
  externalOptionId String? @map("external_option_id")

  targetType       String  @map("target_type") // 'campaign' | 'keyword' | 'product'
  targetKey        String  @map("target_key") // deterministic canonical key, NOT NULL
  campaignId       String? @map("campaign_id")
  campaignIdentity String? @map("campaign_identity")
  campaignName     String? @map("campaign_name")
  adGroup          String? @map("ad_group")
  adGroupId        String? @map("ad_group_id")
  keyword          String?
  placement        String?
  status           String?
  onOff            String? @map("on_off")
  currentBid       Int?    @map("current_bid")
  dailyBudget      Int?    @map("daily_budget")

  spend       Int @default(0)
  revenue     Int @default(0)
  impressions Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)
  orders      Int @default(0)
  adSpend     Int @default(0) @map("ad_spend")
  adRevenue   Int @default(0) @map("ad_revenue")

  rawSnapshotId     String? @map("raw_snapshot_id") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid
  metaJson          Json?   @map("meta_json")

  sampleCount     Int      @default(1) @map("sample_count")
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz
  lastObservedAt  DateTime @default(now()) @map("last_observed_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelAccount  ChannelAccount         @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  listing         ChannelListing?        @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  listingOption   ChannelListingOption?  @relation(fields: [listingOptionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  rawSnapshot     ChannelScrapeSnapshot? @relation("AdTargetDailyRawSnapshot", fields: [rawSnapshotId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceImportRun SourceImportRun?       @relation("AdTargetSourceImport", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  adActions AdAction[]

  @@unique([id, organizationId], map: "channel_ad_target_daily_snapshots_id_org_key")
  @@unique([organizationId, channelAccountId, channel, businessDate, targetType, targetKey], map: "channel_ad_target_daily_legacy_key", where: raw("source_import_run_id IS NULL"))
  @@unique([organizationId, sourceImportRunId, channelAccountId, channel, businessDate, targetType, targetKey], map: "channel_ad_target_daily_generation_key", where: raw("source_import_run_id IS NOT NULL AND (target_type <> 'keyword' OR ad_group_id IS NULL)"))
  @@unique([organizationId, sourceImportRunId, channelAccountId, channel, businessDate, targetType, adGroupId, targetKey], map: "channel_ad_target_keyword_group_generation_key", where: raw("source_import_run_id IS NOT NULL AND target_type = 'keyword' AND ad_group_id IS NOT NULL"))
  @@index([organizationId, channel, businessDate])
  @@index([channelAccountId, businessDate])
  @@index([organizationId, channelAccountId, campaignIdentity, businessDate])
  @@index([listingId, businessDate])
  @@index([listingOptionId, businessDate])
  @@index([organizationId, targetType, businessDate])
  @@index([rawSnapshotId])
  @@index([sourceImportRunId, organizationId], map: "channel_ad_target_daily_source_run_org_idx")
  @@map("channel_ad_target_daily_snapshots")
}

/// @namespace Channels
/// @describe Immutable monthly recipe basis and integer-KRW allocation for one completed advertising source generation.
model ChannelAdListingProductMonthlyFact {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  sourceImportRunId      String   @map("source_import_run_id") @db.Uuid
  channelAccountId       String   @map("channel_account_id") @db.Uuid
  channelListingId       String   @map("channel_listing_id") @db.Uuid
  masterProductId        String   @map("master_product_id") @db.Uuid
  month                  DateTime @map("month") @db.Date
  coveredStartDate       DateTime @map("covered_start_date") @db.Date
  coveredEndDate         DateTime @map("covered_end_date") @db.Date
  wholeRecipeWeight      Int      @map("whole_recipe_weight")
  mappingGeneration      BigInt   @map("mapping_generation") @db.BigInt
  observedTargetDayCount Int      @map("observed_target_day_count")
  allocatedSpend         BigInt   @map("allocated_spend") @db.BigInt
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun @relation("AdListingProductMonthlyFacts", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  channelAccount  ChannelAccount  @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  channelListing  ChannelListing  @relation("AdFactChannelListing", fields: [channelListingId, organizationId, channelAccountId], references: [id, organizationId, channelAccountId], onDelete: Restrict)
  masterProduct   MasterProduct   @relation("AdFactMasterProduct", fields: [masterProductId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, sourceImportRunId, channelAccountId, channelListingId, month, masterProductId], map: "channel_ad_listing_product_monthly_facts_generation_key")
  @@index([sourceImportRunId, organizationId], map: "channel_ad_listing_product_monthly_facts_source_run_org_idx")
  @@index([channelAccountId, organizationId], map: "channel_ad_listing_product_monthly_facts_account_org_idx")
  @@index([channelListingId, organizationId, channelAccountId], map: "ad_monthly_facts_listing_org_account_idx")
  @@index([masterProductId, organizationId], map: "channel_ad_listing_product_monthly_facts_master_product_org_idx")
  @@index([organizationId, sourceImportRunId, month])
  @@map("channel_ad_listing_product_monthly_facts")
}

/// @namespace Channels
/// @describe 채널 계정/스토어 단위 KPI 일별 정규화 fact (listing 에 귀속되지 않는 dashboard KPI 용).
model ChannelAccountDailyKpiSnapshot {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  channelAccountId String    @map("channel_account_id") @db.Uuid
  channel          String
  source           String // 'wing' | 'advertising' | ...
  kpiType          String    @map("kpi_type") // e.g. 'wing_dashboard' | 'wing_itemwinner_kpi'
  businessDate     DateTime  @map("business_date") @db.Date
  periodStart      DateTime? @map("period_start") @db.Date
  periodEnd        DateTime? @map("period_end") @db.Date

