// ai.prisma — AI domain

/// @namespace AI
/// @describe 대표이미지 생성 job 하나(KID-313 W3a): status=pending/running/succeeded/failed/cancelled, method=generate/creative/auto/edit. 결과 후보는 content_assets(thumbnail_generation_id) 행이고 채택은 ContentWorkspace.current_thumbnail_asset_id 다. 입력 사진 · 편집 분석 · 원본 URL 은 input_meta 에 둔다.
model ThumbnailGeneration {
  id                 String @id @default(uuid()) @db.Uuid
  organizationId     String @map("organization_id") @db.Uuid
  contentWorkspaceId String @map("content_workspace_id") @db.Uuid

  status       String  @default("pending")
  prompt       String?
  method       String  @default("edit") @map("method")
  inputMeta    Json?   @map("input_meta")
  errorMessage String? @map("error_message")
  attemptCount Int     @default(0) @map("attempt_count")

  triggeredByUserId String? @map("triggered_by_user_id") @db.Uuid

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentWorkspace ContentWorkspace @relation("ThumbnailGenerationContentWorkspace", fields: [contentWorkspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  triggeredByUser  User?            @relation("ThumbnailGenerationTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  assets           ContentAsset[]   @relation("ContentAssetThumbnailGeneration")

  @@unique([id, organizationId], map: "thumbnail_generations_id_org_key")
  @@index([organizationId])
  @@index([contentWorkspaceId])
  @@index([status])
  @@index([organizationId, contentWorkspaceId, isDeleted], map: "thumbnail_generations_org_content_workspace_deleted_idx")
  @@index([triggeredByUserId])
  @@map("thumbnail_generations")
}

/// @namespace AI
/// @describe Durable queue and projection checkpoint for direct thumbnail, detail-page, and image-edit model work.
model AiDirectJob {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  jobType          String    @map("job_type")
  sourceResourceId String    @map("source_resource_id") @db.Uuid
  status           String    @default("held")
  payload          Json
  result           Json?
  attempts         Int       @default(0)
  maxAttempts      Int       @default(3) @map("max_attempts")
  scheduledFor     DateTime  @default(now()) @map("scheduled_for") @db.Timestamptz
  claimedAt        DateTime? @map("claimed_at") @db.Timestamptz
  claimedBy        String?   @map("claimed_by")
  leaseExpiresAt   DateTime? @map("lease_expires_at") @db.Timestamptz
  finishedAt       DateTime? @map("finished_at") @db.Timestamptz
  lastErrorCode    String?   @map("last_error_code")
  lastErrorMessage String?   @map("last_error_message")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, jobType, sourceResourceId], map: "ai_direct_jobs_source_key")
  @@index([status, scheduledFor])
  @@index([status, leaseExpiresAt])
  @@index([organizationId, status])
  @@index([organizationId, sourceResourceId])
  @@map("ai_direct_jobs")
}

/// @namespace AI
/// @describe Product content workspace owned by a sales product draft, its channel listing, or a direct detail page.
model ContentWorkspace {
  id                          String    @id @default(uuid()) @db.Uuid
  organizationId              String    @map("organization_id") @db.Uuid
  /// sales_product | channel_listing | direct_detail_page (KID-313 W3). 판매 상품 작업공간은 이름을 상품에서 읽는다.
  ownerType                   String    @map("owner_type")
  /// 작업공간 소유자. channels.SalesProduct 의 id 이며 교차 owner 참조이므로 FK 가 없다.
  salesProductId              String?   @map("sales_product_id") @db.Uuid
  /// 몰 카탈로그 import 가 만드는 리스팅 소유 작업공간의 리스팅 id(교차 owner scalar). 판매 상품 작업공간은 null 이다 — 리스팅은 sales_product_id 로 상품 작업공간에 닿는다.
  channelListingId            String?   @map("channel_listing_id") @db.Uuid
  /// 직접 상세 작업공간의 중복 방지 제목. 판매 상품 · 리스팅 작업공간은 null.
  normalizedTitle             String?   @map("normalized_title")
  status                      String    @default("active")
  /// 대표이미지의 유일한 자리(KID-313 W3a). 업로드본 · AI 후보 어느 쪽이든 content_assets 행 하나를 가리킨다.
  currentThumbnailAssetId     String?   @map("current_thumbnail_asset_id") @db.Uuid
  /// 몰로 가는 상세 HTML 의 유일한 포인터(KID-313 W3b).
  currentDetailPageRevisionId String?   @map("current_detail_page_revision_id") @db.Uuid
  createdByUserId             String?   @map("created_by_user_id") @db.Uuid
  isDeleted                   Boolean   @default(false) @map("is_deleted")
  deletedAt                   DateTime? @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization              Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  currentThumbnailAsset     ContentAsset?       @relation("ContentWorkspaceCurrentThumbnail", fields: [currentThumbnailAssetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  currentDetailPageRevision DetailPageRevision? @relation("ContentWorkspaceCurrentRevision", fields: [currentDetailPageRevisionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser             User?               @relation("ContentWorkspaceCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  assets                    ContentAsset[]      @relation("ContentAssetWorkspace")
  detailPages               DetailPage[]        @relation("DetailPageContentWorkspace")
  thumbnailGenerations      ThumbnailGeneration[] @relation("ThumbnailGenerationContentWorkspace")

  @@unique([organizationId, ownerType, normalizedTitle], map: "content_workspaces_direct_title_unique", where: raw("owner_type = 'direct_detail_page' AND sales_product_id IS NULL AND channel_listing_id IS NULL AND status = 'active' AND is_deleted = false"))
  @@unique([organizationId, salesProductId], map: "content_workspaces_sales_product_active_key", where: raw("sales_product_id IS NOT NULL AND status = 'active' AND is_deleted = false"))
  @@unique([organizationId, channelListingId], map: "content_workspaces_listing_active_key", where: raw("channel_listing_id IS NOT NULL AND status = 'active' AND is_deleted = false"))
  @@unique([id, organizationId], map: "content_workspaces_id_org_key")
  @@index([organizationId])
  @@index([salesProductId])
  @@index([channelListingId])
  @@index([currentThumbnailAssetId])
  @@index([currentDetailPageRevisionId])
  @@index([createdByUserId])
  @@index([organizationId, status, isDeleted])
  @@index([organizationId, ownerType, normalizedTitle, status, isDeleted])
  @@index([organizationId, salesProductId, status, isDeleted])
  @@map("content_workspaces")
}

/// @namespace AI
/// @describe 상세 페이지 하나(KID-313 W3b, ← content_generations + detail_page_artifacts): AI 생성 · 직접 작성 · 올린 파일 · 가져오기(사방넷) 어느 것이든 한 행이고, 그 이력은 detail_page_revisions 다. 워크스페이스에 여럿 있을 수 있고 몰로 가는 것은 ContentWorkspace.current_detail_page_revision_id 하나다.
model DetailPage {
  id                 String  @id @default(uuid()) @db.Uuid
  organizationId     String  @map("organization_id") @db.Uuid
  contentWorkspaceId String  @map("content_workspace_id") @db.Uuid
  /// generated | manual | uploaded | imported — 이 상세 페이지가 어떻게 시작됐는가. 가져오기는 원천 이름을 revision.source 에 둔다.
  source             String
  templateId         String? @map("template_id")
  title              String?
  /// pending | processing | ready | failed (생성) · ready (그 외). 생성의 ready 는 generation_result 가 기록된 순간이다 — sink 는 결과 없이 상태만 바꾸지 않는다.
  status             String  @default("ready")
  generationInput    Json    @default("{}") @map("generation_input")
  /// AI 가 준 구조화 결과(템플릿 데이터 · 처리한 이미지). HTML 은 웹 템플릿이 이 결과로 그리고, 처음 저장될 때 `generated` revision 이 된다(이미지만 다시 생성할 때 이 결과를 다시 쓴다).
  generationResult   Json    @default("{}") @map("generation_result")
  errorMessage       String? @map("error_message")
  currentRevisionId  String? @map("current_revision_id") @db.Uuid
  triggeredByUserId  String? @map("triggered_by_user_id") @db.Uuid
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization     Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentWorkspace ContentWorkspace              @relation("DetailPageContentWorkspace", fields: [contentWorkspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  currentRevision  DetailPageRevision?           @relation("DetailPageCurrentRevision", fields: [currentRevisionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  triggeredByUser  User?                         @relation("DetailPageTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  revisions        DetailPageRevision[]          @relation("DetailPageRevisions")
  renderIntents    DetailPageImageRenderIntent[] @relation("DetailPageImageRenderIntentDetailPage")

  @@unique([id, organizationId], map: "detail_pages_id_org_key")
  @@index([organizationId])
  @@index([contentWorkspaceId])
  @@index([currentRevisionId])
  @@index([triggeredByUserId])
  @@index([organizationId, contentWorkspaceId, isDeleted])
  @@index([organizationId, status])
  @@index([templateId])
  @@map("detail_pages")
}

/// @namespace AI
/// @describe Detail-page HTML revision history. AI 결과(generated) · 편집(manual_edit) · 복제(duplicate) · 가져오기(imported)가 한 이력에 쌓이고, DetailPage.current_revision_id 와 ContentWorkspace.current_detail_page_revision_id 가 현재를 고른다. 행은 지우지 않으며, 가져온(imported) revision 의 사진 주소만 사진 옮기기(KID-319)가 우리 저장소 주소로 바꿔 쓴다(source_digest 는 원문 것 그대로).
model DetailPageRevision {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  detailPageId   String  @map("detail_page_id") @db.Uuid
  /// generated | manual_edit | duplicate | imported
  revisionType   String  @default("manual_edit") @map("revision_type")
  html           String  @db.Text
  assetUrlMap    Json    @default("{}") @map("asset_url_map")
  imageUrls      Json    @default("[]") @map("image_urls")
  /// 미러 원천에서 가져온 revision 이면 그 원천(`sabangnet`); 사람이 만든 revision 은 null (KID-313 W2, revision_type = imported).
  source         String? @map("source")
  /// 원천이 준 원문의 digest(KID-304). 같은 원천의 마지막 imported revision 과 같으면 새 revision 을 만들지 않는다.
  sourceDigest   String? @map("source_digest")
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization                Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  detailPage                  DetailPage                    @relation("DetailPageRevisions", fields: [detailPageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdByUser               User?                         @relation("DetailPageRevisionCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentForDetailPages       DetailPage[]                  @relation("DetailPageCurrentRevision")
  currentForContentWorkspaces ContentWorkspace[]            @relation("ContentWorkspaceCurrentRevision")
  imageArtifacts              DetailPageImageArtifact[]     @relation("DetailPageImageArtifactRevision")
  imageRenderIntents          DetailPageImageRenderIntent[] @relation("DetailPageImageRenderIntentRevision")

  @@unique([id, organizationId], map: "detail_page_revisions_id_org_key")
  @@index([organizationId])
  @@index([detailPageId])
  @@index([createdByUserId])
  @@index([detailPageId, createdAt])
  @@index([detailPageId, source, createdAt])
  @@map("detail_page_revisions")
}

/// @namespace AI
/// @describe Durable single-JPEG marketplace rendition for one detail-page revision and renderer variant; the revision's HTML at render time is what the JPEG shows.
model DetailPageImageArtifact {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  revisionId      String  @map("revision_id") @db.Uuid
  variant         String
  outputWidth     Int     @map("output_width")
  objectKey       String  @map("object_key")
  imageUrl        String  @map("image_url")
  contentType     String  @map("content_type")
  byteLength      Int     @map("byte_length")
  pixelWidth      Int     @map("pixel_width")
  pixelHeight     Int     @map("pixel_height")
  sha256          String
  rendererKind    String  @map("renderer_kind")
  createdByUserId String? @map("created_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  revision               DetailPageRevision            @relation("DetailPageImageArtifactRevision", fields: [revisionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  createdBy              User?                         @relation("DetailPageImageArtifactCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  completedRenderIntents DetailPageImageRenderIntent[] @relation("DetailPageImageRenderIntentCompletedArtifact")

  @@unique([organizationId, revisionId, variant, outputWidth], map: "detail_page_image_artifacts_variant_key")
  @@unique([organizationId, objectKey], map: "detail_page_image_artifacts_object_key")
  @@index([revisionId])
  @@index([createdByUserId])
  @@index([organizationId, revisionId])
  @@map("detail_page_image_artifacts")
}

/// @namespace AI
/// @describe Short-lived organization-scoped claim that binds a browser renderer to one exact detail-page revision and object key.
model DetailPageImageRenderIntent {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  detailPageId         String    @map("detail_page_id") @db.Uuid
  revisionId           String    @map("revision_id") @db.Uuid
  variant              String
  outputWidth          Int       @map("output_width")
  objectKey            String    @map("object_key")
  state                String    @default("issued")
  attempt              Int       @default(1)
  expiresAt            DateTime  @map("expires_at") @db.Timestamptz
  requestedByUserId    String?   @map("requested_by_user_id") @db.Uuid
  claimedByUserId      String?   @map("claimed_by_user_id") @db.Uuid
  claimedAt            DateTime? @map("claimed_at") @db.Timestamptz
  uploadedAt           DateTime? @map("uploaded_at") @db.Timestamptz
  completedAt          DateTime? @map("completed_at") @db.Timestamptz
  failedAt             DateTime? @map("failed_at") @db.Timestamptz
  failureCode          String?   @map("failure_code")
  failureMessage       String?   @map("failure_message")
  completedArtifactId  String?   @map("completed_artifact_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  detailPage         DetailPage               @relation("DetailPageImageRenderIntentDetailPage", fields: [detailPageId, organizationId], references: [id, organizationId], onDelete: Cascade)
  revision           DetailPageRevision       @relation("DetailPageImageRenderIntentRevision", fields: [revisionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  requestedBy        User?                    @relation("DetailPageImageRenderIntentRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  claimedBy          User?                    @relation("DetailPageImageRenderIntentClaimedBy", fields: [claimedByUserId], references: [id], onDelete: SetNull)
  completedArtifact  DetailPageImageArtifact? @relation("DetailPageImageRenderIntentCompletedArtifact", fields: [completedArtifactId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([detailPageId])
  @@index([revisionId])
  @@index([requestedByUserId])
  @@index([claimedByUserId])
  @@index([completedArtifactId])
  @@index([organizationId, state, expiresAt])
  @@index([organizationId, revisionId, variant, outputWidth])
  @@map("detail_page_image_render_intents")
}

/// @namespace AI
/// @describe 워크스페이스가 소유한 관리 이미지 한 표(KID-313 W3a): 운영자 업로드 · AI 썸네일 후보 · 상세 이미지 · 몰 카탈로그 사진이 모두 여기 한 행이다. 대표이미지는 ContentWorkspace.current_thumbnail_asset_id 가 가리킨다.
model ContentAsset {
  id                    String  @id @default(uuid()) @db.Uuid
  organizationId        String  @map("organization_id") @db.Uuid
  contentWorkspaceId    String  @map("content_workspace_id") @db.Uuid
  /// upload | ai | detail_generation | catalog — 어디서 왔는가.
  source                String
  /// AI 후보이면 그 job. 다른 출처는 null.
  thumbnailGenerationId String? @map("thumbnail_generation_id") @db.Uuid
  createdByUserId       String? @map("created_by_user_id") @db.Uuid

  assetKey   String  @map("asset_key")
  url        String
  storageKey String? @map("storage_key")
  assetType  String  @default("image") @map("asset_type")
  /// thumbnail | detail_source | detail_image | primary | detail | option — 워크스페이스 안에서 하는 일.
  role       String?
  label      String?
  sortOrder  Int     @default(0) @map("sort_order")

  mimeType String? @map("mime_type")
  width    Int?
  height   Int?
  fileSize Int?    @map("file_size")
  metadata Json    @default("{}")

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contentWorkspace     ContentWorkspace     @relation("ContentAssetWorkspace", fields: [contentWorkspaceId, organizationId], references: [id, organizationId], onDelete: Cascade)
  thumbnailGeneration  ThumbnailGeneration? @relation("ContentAssetThumbnailGeneration", fields: [thumbnailGenerationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdByUser        User?                @relation("ContentAssetCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  currentForWorkspaces ContentWorkspace[]   @relation("ContentWorkspaceCurrentThumbnail")

  @@unique([organizationId, assetKey])
  @@unique([id, organizationId], map: "content_assets_id_org_key")
  @@index([organizationId])
  @@index([contentWorkspaceId])
  @@index([thumbnailGenerationId])
  @@index([createdByUserId])
  @@index([organizationId, contentWorkspaceId, role, isDeleted])
  @@index([organizationId, assetType])
  @@map("content_assets")
}

/// @namespace AI
/// @describe 몰에 실제 등록된 리스팅 대표이미지 한 장당 평가 한 행(KID-313 W3a, Content 소유). channel_listing_id 는 교차 owner scalar id(FK 없음), image_url 은 channel_listings.image_url 그 시점 값. 이미지가 바뀌면 새 행이 생기고 옛 평가는 남는다. 규칙 검사는 저장하지 않고 계산한다.
model ListingThumbnailEvaluation {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  channelListingId String   @map("channel_listing_id") @db.Uuid
  imageUrl         String   @map("image_url")
  /// S | A | B | C | D | F
  grade            String
  score            Int
  /// 5축 점수 · 준수 · issues · suggestions 한 JSON.
  details          Json     @default("{}")
  /// vision_model | rule
  method           String
  modelId          String?  @map("model_id")
  evaluatedAt      DateTime @default(now()) @map("evaluated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channelListingId, imageUrl], map: "listing_thumbnail_evaluations_listing_image_key")
  @@unique([id, organizationId], map: "listing_thumbnail_evaluations_id_org_key")
  @@index([organizationId])
  @@index([organizationId, channelListingId, evaluatedAt])
  @@map("listing_thumbnail_evaluations")
}

/// @namespace AI
/// @describe Append-only metering of one Gemini call: tokens and an estimated cost, attributed to the agent whose request or job made it. Cost is null when the model has no registered price.
model AiUsageRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  /// sourcing · product · mall · inventory · marketing · cs · finance; null when no agent owns the caller.
  agentKey       String?  @map("agent_key")
  provider       String
  model          String
  operation      String
  inputTokens    Int      @map("input_tokens")
  outputTokens   Int      @map("output_tokens")
  costMicroUsd   BigInt?  @map("cost_micro_usd")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("ai_usage_records")
}
