// advertising.prisma — Advertising domain

/// @namespace Advertising
/// @describe 광고 자동 실행 큐. ChannelAdTargetDailySnapshot→AdAction→ExecutionTask 파이프라인. 실행 상태는 최신 ExecutionTask에서 파생한다.
model AdAction {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  listingId       String?   @map("listing_id") @db.Uuid
  listingOptionId String?   @map("listing_option_id") @db.Uuid
  adTargetDailyId String?   @map("ad_target_daily_id") @db.Uuid
  actionType      String    @map("action_type")
  targetType      String    @map("target_type")
  externalId      String?   @map("external_id")
  targetLabel     String    @map("target_label")
  reason          String
  priority        String    @default("medium")
  currentValue    Int?      @map("current_value")
  proposedValue   Int?      @map("proposed_value")
  payload         Json?
  approvalStatus  String    @default("pending_review") @map("approval_status")
  approvedAt      DateTime? @map("approved_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  adTargetDaily  ChannelAdTargetDailySnapshot? @relation(fields: [adTargetDailyId, organizationId], references: [id, organizationId], onDelete: Restrict)
  executionTasks ExecutionTask[]

  @@index([listingOptionId])
  @@index([organizationId, approvalStatus])
  @@index([externalId])
  @@index([adTargetDailyId])
  @@index([listingId])
  @@index([createdAt])
  @@map("ad_actions")
}

/// @namespace Advertising
model ExecutionTask {
  id           String    @id @default(uuid()) @db.Uuid
  actionId     String    @map("action_id") @db.Uuid
  status       String    @default("queued")
  startedAt    DateTime? @map("started_at") @db.Timestamptz
  finishedAt   DateTime? @map("finished_at") @db.Timestamptz
  beforeJson   Json?     @map("before_json")
  afterJson    Json?     @map("after_json")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz

  action AdAction @relation(fields: [actionId], references: [id], onDelete: Cascade)

  @@index([actionId, status, createdAt])
  @@index([status])
  @@map("execution_tasks")
}

/// @namespace Advertising
/// @describe ChannelAdTargetDailySnapshot canonical state owned by advertising.
/// @namespace Channels
/// @describe 채널 광고 타겟(캠페인/키워드/상품)의 일별 정규화 fact. 기간 view 는 SUM 으로 derive.
model ChannelAdTargetDailySnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  channelAccountId String   @map("channel_account_id") @db.Uuid
  channel          String
  businessDate     DateTime @map("business_date") @db.Date

  listingId        String? @map("listing_id") @db.Uuid
  listingOptionId  String? @map("listing_option_id") @db.Uuid
  externalId       String? @map("external_id")
  externalOptionId String? @map("external_option_id")

  targetType       String  @map("target_type") // 'campaign' | 'keyword' | 'product'
  targetKey        String  @map("target_key") // deterministic canonical key, NOT NULL
  campaignId       String? @map("campaign_id")
  campaignIdentity String? @map("campaign_identity")
  campaignName     String? @map("campaign_name")
  adGroup          String? @map("ad_group")
  adGroupId        String? @map("ad_group_id")
  keyword          String?
  placement        String?
  status           String?
  onOff            String? @map("on_off")
  currentBid       Int?    @map("current_bid")
  dailyBudget      Int?    @map("daily_budget")

  spend       Int @default(0)
  revenue     Int @default(0)
  impressions Int @default(0)
  clicks      Int @default(0)
  conversions Int @default(0)
  orders      Int @default(0)
  adSpend     Int @default(0) @map("ad_spend")
  adRevenue   Int @default(0) @map("ad_revenue")

  rawSnapshotId     String? @map("raw_snapshot_id") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid
  metaJson          Json?   @map("meta_json")

  sampleCount     Int      @default(1) @map("sample_count")
  firstObservedAt DateTime @default(now()) @map("first_observed_at") @db.Timestamptz
  lastObservedAt  DateTime @default(now()) @map("last_observed_at") @db.Timestamptz
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation("AdTargetSourceImport", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  adActions AdAction[]

  @@unique([id, organizationId], map: "channel_ad_target_daily_snapshots_id_org_key")
  @@unique([organizationId, channelAccountId, channel, businessDate, targetType, targetKey], map: "channel_ad_target_daily_legacy_key", where: raw("source_import_run_id IS NULL"))
  @@unique([organizationId, sourceImportRunId, channelAccountId, channel, businessDate, targetType, targetKey], map: "channel_ad_target_daily_generation_key", where: raw("source_import_run_id IS NOT NULL AND (target_type <> 'keyword' OR ad_group_id IS NULL)"))
  @@unique([organizationId, sourceImportRunId, channelAccountId, channel, businessDate, targetType, adGroupId, targetKey], map: "channel_ad_target_keyword_group_generation_key", where: raw("source_import_run_id IS NOT NULL AND target_type = 'keyword' AND ad_group_id IS NOT NULL"))
  @@index([organizationId, channel, businessDate])
  @@index([channelAccountId, businessDate])
  @@index([organizationId, channelAccountId, campaignIdentity, businessDate])
  @@index([listingId, businessDate])
  @@index([listingOptionId, businessDate])
  @@index([organizationId, targetType, businessDate])
  @@index([rawSnapshotId])
  @@index([sourceImportRunId, organizationId], map: "channel_ad_target_daily_source_run_org_idx")
  @@map("channel_ad_target_daily_snapshots")
}

/// @namespace Advertising
/// @describe ChannelAdListingProductMonthlyFact canonical state owned by advertising.
/// @namespace Channels
/// @describe Immutable monthly recipe basis and integer-KRW allocation for one completed advertising source generation.
model ChannelAdListingProductMonthlyFact {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  sourceImportRunId      String   @map("source_import_run_id") @db.Uuid
  channelAccountId       String   @map("channel_account_id") @db.Uuid
  channelListingId       String   @map("channel_listing_id") @db.Uuid
  masterProductId        String   @map("master_product_id") @db.Uuid
  month                  DateTime @map("month") @db.Date
  coveredStartDate       DateTime @map("covered_start_date") @db.Date
  coveredEndDate         DateTime @map("covered_end_date") @db.Date
  wholeRecipeWeight      Int      @map("whole_recipe_weight")
  mappingGeneration      BigInt   @map("mapping_generation") @db.BigInt
  observedTargetDayCount Int      @map("observed_target_day_count")
  allocatedSpend         BigInt   @map("allocated_spend") @db.BigInt
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun @relation("AdListingProductMonthlyFacts", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, sourceImportRunId, channelAccountId, channelListingId, month, masterProductId], map: "channel_ad_listing_product_monthly_facts_generation_key")
  @@index([sourceImportRunId, organizationId], map: "channel_ad_listing_product_monthly_facts_source_run_org_idx")
  @@index([channelAccountId, organizationId], map: "channel_ad_listing_product_monthly_facts_account_org_idx")
  @@index([channelListingId, organizationId, channelAccountId], map: "ad_monthly_facts_listing_org_account_idx")
  @@index([masterProductId, organizationId], map: "channel_ad_listing_product_monthly_facts_master_product_org_idx")
  @@index([organizationId, sourceImportRunId, month])
  @@map("channel_ad_listing_product_monthly_facts")
}

/// @namespace Advertising
/// @describe CoupangRepresentativeKeywordOverride canonical state owned by advertising.
/// @namespace Channels
/// @describe 자사 쿠팡 상품(vendorItemId)별 사용자가 직접 지정한 대표 검색 키워드. 없으면 쿠팡 카테고리와 Wing 28일 지표로 자동 추천한다.
model CoupangRepresentativeKeywordOverride {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  vendorItemId   String @map("vendor_item_id")
  keyword        String

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, vendorItemId])
  @@index([organizationId])
  @@map("coupang_representative_keyword_overrides")
}

/// @namespace Advertising
/// @describe CoupangKeywordTracker canonical state owned by advertising.
/// @namespace Channels
/// @describe 쿠팡 검색 키워드별 자사 상품 순위 추적 대상. 확장이 www.coupang.com 검색결과(SERP)를 수집할 키워드 정의. vendorItemIds 는 명시 추적 타깃(빈 배열 = 자사 카탈로그 자동매칭만).
model CoupangKeywordTracker {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  keyword       String
  vendorItemIds String[] @map("vendor_item_ids") // 명시 추적 타깃 vendorItemId 목록(빈 배열 = 자사 카탈로그 자동매칭만)
  maxPages      Int      @default(2) @map("max_pages")
  enabled       Boolean  @default(true)

  lastCapturedAt DateTime? @map("last_captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyword])
  @@index([organizationId])
  @@map("coupang_keyword_trackers")
}

/// @namespace Advertising
/// @describe CoupangKeywordRankDailySnapshot canonical state owned by advertising.
/// @namespace Channels
/// @describe 쿠팡 검색 키워드×상품(vendorItemId) 일별 순위 fact. 순위 null = 스캔한 페이지 내 미노출(순위권 밖). overallRank 는 광고 포함 전체 순위, organicRank 는 오가닉만, adRank 는 광고만 센 순위.
model CoupangKeywordRankDailySnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  sourceImportRunId String?  @map("source_import_run_id") @db.Uuid
  keyword           String
  vendorItemId      String   @map("vendor_item_id")
  businessDate      DateTime @map("business_date") @db.Date

  productId   String? @map("product_id")
  itemId      String? @map("item_id")
  productName String? @map("product_name")

  overallRank    Int? @map("overall_rank")
  organicRank    Int? @map("organic_rank")
  adRank         Int? @map("ad_rank")
  page           Int?
  positionInPage Int? @map("position_in_page")
  priceKrw       Int? @map("price_krw")
  reviewCount    Int? @map("review_count")

  source     String   @default("coupang_search")
  capturedAt DateTime @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation("KeywordRankSource", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, keyword, vendorItemId, businessDate])
  @@index([sourceImportRunId, organizationId])
  @@index([organizationId, keyword, businessDate])
  @@index([organizationId, vendorItemId, businessDate])
  @@map("coupang_keyword_rank_daily_snapshots")
}

/// @namespace Advertising
/// @describe CoupangWingTrackedProduct canonical state owned by advertising.
/// @namespace Channels
/// @describe 쿠팡 Wing 카탈로그 경쟁상품 추적 대상. 상품분석(wing-catalog)에서 사용자가 추적 등록한 카탈로그 상품(자사/경쟁 무관). sourceKeyword = 지표 갱신 시 재검색할 키워드.
model CoupangWingTrackedProduct {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  productId    String  @map("product_id")
  itemId       String? @map("item_id")
  vendorItemId String? @map("vendor_item_id")

  productName       String  @map("product_name")
  imagePath         String? @map("image_path")
  brandName         String? @map("brand_name")
  categoryHierarchy String? @map("category_hierarchy")
  sourceKeyword     String? @map("source_keyword")

  enabled        Boolean   @default(true)
  lastCapturedAt DateTime? @map("last_captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization                             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots    CoupangWingTrackedProductDailySnapshot[]

  @@unique([organizationId, productId])
  @@index([organizationId])
  @@map("coupang_wing_tracked_products")
}

/// @namespace Advertising
/// @describe CoupangWingTrackedProductDailySnapshot canonical state owned by advertising.
/// @namespace Channels
/// @describe 쿠팡 Wing 추적상품 일별 지표 스냅샷(상품×일자당 최신본 upsert). Wing 카탈로그 28일 지표(클릭 pv·판매·매출·전환) + 판매가·리뷰.
model CoupangWingTrackedProductDailySnapshot {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  trackedProductId String   @map("tracked_product_id") @db.Uuid
  businessDate     DateTime @map("business_date") @db.Date

  salePriceKrw        Int?     @map("sale_price_krw")
  ratingCount         Int?     @map("rating_count")
  ratingAverage       Decimal? @map("rating_average") @db.Decimal(3, 2)
  pvLast28Day         Int?     @map("pv_last_28day")
  salesLast28d        Int?     @map("sales_last_28d")
  estimatedRevenue28d Int?     @map("estimated_revenue_28d")
  conversionRate28d   Decimal? @map("conversion_rate_28d") @db.Decimal(7, 6)

  sourceKeyword String?  @map("source_keyword")
  capturedAt    DateTime @map("captured_at") @db.Timestamptz
  /// 이 행을 쓴 실행(`advertising.wing_tracked_products`, ADR-0025). 옛 attempt 행은 null.
  operationId   String?  @map("operation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  trackedProduct CoupangWingTrackedProduct @relation(fields: [trackedProductId], references: [id], onDelete: Cascade)

  @@unique([trackedProductId, businessDate])
  @@index([organizationId])
  @@index([trackedProductId, businessDate])
  @@index([operationId])
  @@map("coupang_wing_tracked_product_daily_snapshots")
}

/// @namespace Advertising
/// @describe CoupangKeywordSerpDailySnapshot canonical state owned by advertising.
/// @namespace Channels
/// @describe 쿠팡 검색 키워드별 SERP 전체 캡처(키워드-일자당 최신본 upsert). items 는 DOM 순서 그대로의 결과 리스트 JSON — 경쟁사 노출 확인·순위 재계산용.
model CoupangKeywordSerpDailySnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  sourceImportRunId String?  @map("source_import_run_id") @db.Uuid
  keyword           String
  businessDate      DateTime @map("business_date") @db.Date

  items        Json // [{ rank, page, positionInPage, isAd, productId, itemId, vendorItemId, name, priceKrw, reviewCount, ratingScore, link }]
  itemCount    Int  @default(0) @map("item_count")
  pagesScanned Int  @default(0) @map("pages_scanned")

  capturedAt DateTime @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation("KeywordSerpSource", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, keyword, businessDate])
  @@index([sourceImportRunId, organizationId])
  @@index([organizationId, businessDate])
  @@map("coupang_keyword_serp_daily_snapshots")
}

/// @namespace Advertising
/// @describe CoupangWingSalesRankDailySnapshot canonical state owned by advertising.
/// @namespace Channels
/// @describe Wing 상품 매칭 API의 키워드별 최근 28일 판매량순에서 자사 vendorItemId가 차지한 일별 순위. salesRank null은 수집 범위 밖이며 판매량·조회·매출 지표도 같은 Wing 응답에서 저장한다.
model CoupangWingSalesRankDailySnapshot {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  sourceImportRunId String?  @map("source_import_run_id") @db.Uuid
  keyword           String
  vendorItemId      String   @map("vendor_item_id")
  businessDate      DateTime @map("business_date") @db.Date

  productId         String? @map("product_id")
  itemId            String? @map("item_id")
  productName       String? @map("product_name")
  categoryHierarchy String? @map("category_hierarchy")

  salesRank         Int?     @map("sales_rank")
  salesLast28d      Int?     @map("sales_last_28d")
  viewsLast28d      Int?     @map("views_last_28d")
  revenueLast28d    Int?     @map("revenue_last_28d")
  conversionRate28d Decimal? @map("conversion_rate_28d") @db.Decimal(9, 6)
  salePrice         Int?     @map("sale_price")
  reviewCount       Int?     @map("review_count")

  // 같은 키워드 검색 결과 전체의 시장 수요 지표. 후보 키워드 간 비교 점수에 사용한다.
  keywordSalesLast28d      Int?     @map("keyword_sales_last_28d")
  keywordViewsLast28d      Int?     @map("keyword_views_last_28d")
  keywordConversionRate28d Decimal? @map("keyword_conversion_rate_28d") @db.Decimal(9, 6)

  pagesScanned   Int      @default(0) @map("pages_scanned")
  collectedCount Int      @default(0) @map("collected_count")
  totalResults   Int?     @map("total_results")
  capturedAt     DateTime @map("captured_at") @db.Timestamptz
  /// 이 행을 쓴 실행(`advertising.wing_rank`, ADR-0025). 옛 attempt 행은 null(`source_import_run_id`만 있다).
  operationId    String?  @map("operation_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation("WingRankSource", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, keyword, vendorItemId, businessDate])
  @@index([organizationId, businessDate])
  @@index([organizationId, keyword, businessDate])
  @@index([organizationId, vendorItemId, businessDate])
  @@index([sourceImportRunId, organizationId])
  @@index([operationId])
  @@map("coupang_wing_sales_rank_daily_snapshots")
}
