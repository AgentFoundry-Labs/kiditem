  channelAccountId String    @map("channel_account_id") @db.Uuid
  campaignId       String    @map("campaign_id")
  name             String
  isActive         Boolean   @map("is_active")
  status           String?
  servingStatus    String?   @map("serving_status")
  budget           Int?
