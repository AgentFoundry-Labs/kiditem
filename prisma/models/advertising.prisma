  roasTarget       Decimal?  @map("roas_target") @db.Decimal(12, 4)
  adSelectionType  String?   @map("ad_selection_type")
  totalAdCount     Int?      @map("total_ad_count")
  lastSeenAt       DateTime  @map("last_seen_at") @db.Timestamptz
  deletedAt        DateTime? @map("deleted_at") @db.Timestamptz

  operationId String   @map("operation_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channelAccountId, campaignId], map: "channel_ad_campaigns_key")
  @@index([operationId])
  @@map("channel_ad_campaigns")
