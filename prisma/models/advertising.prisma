  campaignKey         String   @map("campaign_key")
  deliveredSpend      Int      @map("delivered_spend")
  billedSpend         Int      @map("billed_spend")
  promotionAdjustment Int      @map("promotion_adjustment")
  billableAdjustment  Int      @map("billable_adjustment")

