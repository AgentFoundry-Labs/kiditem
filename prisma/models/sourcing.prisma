  policyKey        String    @map("policy_key") @db.VarChar(120)
  policyVersion    String    @map("policy_version") @db.VarChar(120)
  evidenceCutoffAt DateTime  @map("evidence_cutoff_at") @db.Timestamptz
  startedAt        DateTime  @default(now()) @map("started_at") @db.Timestamptz
  completedAt      DateTime? @map("completed_at") @db.Timestamptz
  validUntil       DateTime? @map("valid_until") @db.Timestamptz
  summary          Json      @default("{}") @db.JsonB

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendationRun  SourcingRecommendationRun  @relation(fields: [recommendationRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recommendationItem SourcingRecommendationItem @relation(fields: [recommendationItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  checks             SourcingValidationCheck[]
  reviewBatchItems   SourcingReviewBatchItem[]

  @@unique([id, organizationId], map: "sourcing_validation_episodes_id_org_key")
  @@unique([recommendationRunId, recommendationItemId], map: "sourcing_validation_episodes_run_item_key")
  @@index([organizationId, status, completedAt])
  @@map("sourcing_validation_episodes")
}

/// @namespace Sourcing
/// @describe 하나의 검증 episode를 구성하는 데이터 기반 check 결과.
model SourcingValidationCheck {
  id                  String @id @default(uuid()) @db.Uuid
  organizationId      String @map("organization_id") @db.Uuid
  validationEpisodeId String @map("validation_episode_id") @db.Uuid

  checkKey    String   @map("check_key") @db.VarChar(120)
  status      String   @db.VarChar(40)
  severity    String?  @db.VarChar(40)
  score       Int?
  summary     String?  @db.Text
  details     Json     @default("{}") @db.JsonB
  evaluatedAt DateTime @default(now()) @map("evaluated_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization      Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  validationEpisode SourcingValidationEpisode         @relation(fields: [validationEpisodeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  evidence          SourcingValidationCheckEvidence[]

  @@unique([id, organizationId], map: "sourcing_validation_checks_id_org_key")
  @@unique([validationEpisodeId, checkKey], map: "sourcing_validation_checks_episode_check_key")
  @@index([validationEpisodeId, evaluatedAt])
  @@map("sourcing_validation_checks")
}

/// @namespace Sourcing
/// @describe 검증 check가 참조한 immutable evidence link.
model SourcingValidationCheckEvidence {
  id                    String   @id @default(uuid()) @db.Uuid
  organizationId        String   @map("organization_id") @db.Uuid
  validationCheckId     String   @map("validation_check_id") @db.Uuid
  evidenceObservationId String   @map("evidence_observation_id") @db.Uuid
  role                  String   @db.VarChar(80)
  ordinal               Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  validationCheck     SourcingValidationCheck     @relation(fields: [validationCheckId, organizationId], references: [id, organizationId], onDelete: Restrict)
  evidenceObservation SourcingEvidenceObservation @relation(fields: [evidenceObservationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId], map: "sourcing_validation_check_evidence_id_org_key")
  @@unique([validationCheckId, evidenceObservationId, role], map: "sourcing_validation_check_evidence_check_observation_role_key")
  @@index([validationCheckId, ordinal])
  @@index([evidenceObservationId])
  @@map("sourcing_validation_check_evidence")
}

/// @namespace Sourcing
/// @describe Entry/Final 화면 선택 상태의 org-scoped, optimistic-concurrency record.
model SourcingReviewSelection {
  id                  String @id @default(uuid()) @db.Uuid
  organizationId      String @map("organization_id") @db.Uuid
  recommendationRunId String @map("recommendation_run_id") @db.Uuid
  workspaceKey        String @map("workspace_key") @db.VarChar(40)
  itemKey             String @map("item_key") @db.VarChar(64)
  state               String @default("neutral") @db.VarChar(20)
  version             Int    @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendationRun SourcingRecommendationRun @relation(fields: [recommendationRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId], map: "sourcing_review_selections_id_org_key")
  @@unique([organizationId, workspaceKey, recommendationRunId, itemKey], map: "sourcing_review_selections_workspace_run_item_key")
  @@index([organizationId, recommendationRunId, state], map: "sourcing_review_selections_run_state_idx")
  @@map("sourcing_review_selections")
}

/// @namespace Sourcing
/// @describe Final 화면에서 생성하는 immutable review handoff. procurement intent나 provider side effect를 만들지 않는다.
model SourcingReviewBatch {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  recommendationRunId String    @map("recommendation_run_id") @db.Uuid
  requestedByUserId   String    @map("requested_by_user_id") @db.Uuid
  idempotencyKey      String    @map("idempotency_key") @db.VarChar(300)
  requestHash         String    @map("request_hash") @db.VarChar(64)
  status              String    @default("awaiting_procurement_enablement") @db.VarChar(60)
  requestedAt         DateTime  @default(now()) @map("requested_at") @db.Timestamptz
  cancelledAt         DateTime? @map("cancelled_at") @db.Timestamptz
  cancelReason        String?   @map("cancel_reason") @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendationRun SourcingRecommendationRun @relation(fields: [recommendationRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  requestedBy       User                      @relation("SourcingReviewBatchRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  items             SourcingReviewBatchItem[]

  @@unique([id, organizationId], map: "sourcing_review_batches_id_org_key")
  @@unique([organizationId, idempotencyKey], map: "sourcing_review_batches_org_idempotency_key")
  @@index([requestedByUserId])
  @@index([organizationId, requestedAt])
  @@map("sourcing_review_batches")
}

/// @namespace Sourcing
/// @describe review batch가 실제로 검토한 recommendation, validation, exact offer observation을 동결한다.
model SourcingReviewBatchItem {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  reviewBatchId             String   @map("review_batch_id") @db.Uuid
  recommendationItemId      String   @map("recommendation_item_id") @db.Uuid
  validationEpisodeId       String?  @map("validation_episode_id") @db.Uuid
  offerKeywordObservationId String   @map("offer_keyword_observation_id") @db.Uuid
  ordinal                   Int      @default(0)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization            Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewBatch             SourcingReviewBatch                 @relation(fields: [reviewBatchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recommendationItem      SourcingRecommendationItem          @relation(fields: [recommendationItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  validationEpisode       SourcingValidationEpisode?          @relation(fields: [validationEpisodeId, organizationId], references: [id, organizationId], onDelete: Restrict)
  offerKeywordObservation Sourcing1688OfferKeywordObservation @relation(fields: [offerKeywordObservationId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId], map: "sourcing_review_batch_items_id_org_key")
  @@unique([reviewBatchId, recommendationItemId], map: "sourcing_review_batch_items_batch_item_key")
  @@index([reviewBatchId, ordinal])
  @@index([recommendationItemId])
  @@index([validationEpisodeId])
  @@index([offerKeywordObservationId])
  @@map("sourcing_review_batch_items")
}

/// @namespace Sourcing
/// @describe Reviewed product preparation의 marketplace create/reconcile side effect 실행 기록. 준비 입력과 provider lifecycle을 분리해 보존한다.
model ProductRegistrationExecution {
  id                   String  @id @default(uuid()) @db.Uuid
  organizationId       String  @map("organization_id") @db.Uuid
  productPreparationId String  @map("product_preparation_id") @db.Uuid
  channelAccountId     String  @map("channel_account_id") @db.Uuid
  channelListingId     String? @map("channel_listing_id") @db.Uuid

  executionKind             String  @default("create") @map("execution_kind")
  expectedProviderAccountId String? @map("expected_provider_account_id")
  idempotencyKey            String  @map("idempotency_key")
  requestHash               String  @map("request_hash")

  submissionPayloadJson Json?   @map("submission_payload_json") @db.JsonB
  submissionPayloadHash String? @map("submission_payload_hash")

  status          String @default("prepared")
  providerOutcome String @default("not_attempted") @map("provider_outcome")

  providerSubmissionId String? @map("provider_submission_id")
  externalListingId    String? @map("external_listing_id")
  resultJson           Json?   @map("result_json") @db.JsonB
  lastErrorCode        String? @map("last_error_code")
  lastErrorMessage     String? @map("last_error_message")

  leaseToken        String?   @map("lease_token") @db.Uuid
  leaseClaimedAt    DateTime? @map("lease_claimed_at") @db.Timestamptz
  requestedByUserId String?   @map("requested_by_user_id") @db.Uuid
  startedAt         DateTime? @map("started_at") @db.Timestamptz
  completedAt       DateTime? @map("completed_at") @db.Timestamptz
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization       @relation("ProductRegistrationExecutionOrganization", fields: [organizationId], references: [id], onDelete: Cascade)
  productPreparation ProductPreparation @relation("ProductPreparationExecutions", fields: [productPreparationId, organizationId, channelAccountId], references: [id, organizationId, channelAccountId], onDelete: Restrict)
  channelAccount     ChannelAccount     @relation("ChannelAccountProductRegistrationExecutions", fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  channelListing     ChannelListing?    @relation("ChannelListingProductRegistrationExecutions", fields: [channelListingId, organizationId, channelAccountId], references: [id, organizationId, channelAccountId], onDelete: Restrict)
  requestedByUser    User?              @relation("ProductRegistrationExecutionRequestedBy", fields: [requestedByUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, idempotencyKey], map: "product_registration_executions_org_idempotency_key")
  @@unique([organizationId, productPreparationId], map: "product_registration_executions_org_preparation_key")
  @@unique([organizationId, channelListingId], map: "product_registration_executions_active_listing_key", where: raw("channel_listing_id IS NOT NULL AND status = ANY (ARRAY['prepared'::text, 'executing'::text, 'reconciling'::text])"))
  @@unique([organizationId, channelAccountId, externalListingId], map: "product_registration_executions_active_external_listing_key", where: raw("external_listing_id IS NOT NULL AND status = ANY (ARRAY['prepared'::text, 'executing'::text, 'reconciling'::text])"))
  @@index([productPreparationId])
  @@index([channelAccountId])
  @@index([channelListingId])
  @@index([requestedByUserId])
  @@index([organizationId, status, createdAt])
  @@map("product_registration_executions")
}
