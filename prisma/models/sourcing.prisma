// sourcing.prisma — Sourcing domain (issue #192)

/// @namespace Sourcing
/// @describe 외부 플랫폼에서 스크랩한 소싱 후보. MasterProduct와 분리된 sourcing inbox.
model SourcingCandidate {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  sourceUrl            String  @map("source_url")
  sourcePlatform       String  @map("source_platform")
  externalOfferId      String? @map("external_offer_id") @db.VarChar(200)
  variantKeyNormalized String  @default("") @map("variant_key_normalized") @db.VarChar(300)
  sourceIdentityHash   String? @map("source_identity_hash") @db.VarChar(64)
  rawData              Json    @default("{}") @map("raw_data")

  name         String
  description  String  @default("")
  category     String?
  tags         Json    @default("[]")
  thumbnailUrl String? @map("thumbnail_url")
  imageUrl     String? @map("image_url")

  costCny Decimal? @map("cost_cny") @db.Decimal(12, 2)

  status                    String  @default("sourced")
  provenanceMasterProductId String? @map("provenance_master_product_id") @db.Uuid

  rejectedReason   String?   @map("rejected_reason")
  rejectedAt       DateTime? @map("rejected_at") @db.Timestamptz
  rejectedByUserId String?   @map("rejected_by_user_id") @db.Uuid

  triggeredByUserId String? @map("triggered_by_user_id") @db.Uuid

  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization                 Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provenanceMasterProduct      MasterProduct?                @relation("SourcingCandidateProvenance", fields: [provenanceMasterProductId, organizationId], references: [id, organizationId], onDelete: Restrict)
  rejectedByUser               User?                         @relation("SourcingCandidateRejectedBy", fields: [rejectedByUserId], references: [id], onDelete: SetNull)
  triggeredByUser              User?                         @relation("SourcingCandidateTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  images                       CandidateImage[]
  contentGenerationSources     ContentGenerationSource[]
  contentGenerations           ContentGeneration[]           @relation("ContentGenerationPrimarySourcingCandidate")
  contentWorkspaces            ContentWorkspace[]            @relation("ContentWorkspaceSourcingCandidate")
  productPreparations          ProductPreparation[]
  thumbnailGenerations         ThumbnailGeneration[]         @relation("ThumbnailGenerationSourcingCandidate")
  channelListings              ChannelListing[]
  detailPageImageRenderIntents DetailPageImageRenderIntent[] @relation("DetailPageImageRenderIntentCandidate")
  launchCandidates             SourcingLaunchCandidate[]

  @@unique([organizationId, sourcePlatform, sourceIdentityHash], map: "sourcing_candidates_org_platform_identity_key", where: raw("source_identity_hash IS NOT NULL AND is_deleted = false AND status = 'sourced'"))
  @@unique([provenanceMasterProductId, organizationId], map: "sourcing_candidates_org_provenance_master_key")
  @@unique([id, organizationId], map: "sourcing_candidates_id_org_key")
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, isDeleted])
  @@index([provenanceMasterProductId])
  @@map("sourcing_candidates")
}

/// @namespace Sourcing
/// @describe 소싱 후보가 소유하는 이미지 갤러리. 소싱 콘텐츠와 썸네일 생성 입력으로 사용한다.
/// ThumbnailGenerationInputImage이 선택된 후보 이미지를 이 테이블에서 참조한다.
model CandidateImage {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  candidateId    String @map("candidate_id") @db.Uuid

  url        String
  storageKey String? @map("storage_key")
  role       String  @default("product")
  label      String?
  sortOrder  Int     @default(0) @map("sort_order")
  source     String  @default("sourcing-extension")

  mimeType String? @map("mime_type")
  width    Int?
  height   Int?
  fileSize Int?    @map("file_size")

  isPrimary Boolean   @default(false) @map("is_primary")
  isDeleted Boolean   @default(false) @map("is_deleted")
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization              Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidate                 SourcingCandidate               @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  thumbnailGenerationInputs ThumbnailGenerationInputImage[]

  @@index([organizationId])
  @@index([candidateId])
  @@index([organizationId, candidateId])
  @@map("sourcing_candidate_images")
}

/// @namespace Sourcing
/// @describe 조직/KST 날짜/scope 단위의 소싱 AI 결과 캐시. 오늘의 추천/키워드 분석 결과를 최신 1개로 재사용한다.
model SourcingWorkspaceSnapshot {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  scope             String
  businessDate      DateTime  @map("business_date") @db.Date
  projectionVersion String    @default("legacy") @map("projection_version") @db.VarChar(120)
  inputHash         String    @default("") @map("input_hash") @db.VarChar(64)
  payload           Json      @default("{}") @map("payload") @db.JsonB
  generatedAt       DateTime  @default(now()) @map("generated_at") @db.Timestamptz
  expiresAt         DateTime? @map("expires_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, businessDate, projectionVersion, inputHash], map: "sourcing_workspace_snapshots_projection_input_key")
  @@index([organizationId, scope, businessDate, generatedAt(sort: Desc)], map: "sourcing_workspace_snapshots_latest_projection_idx")
  @@map("sourcing_workspace_snapshots")
}

/// @namespace Sourcing
/// @describe 서버가 소유하는 관심 키워드. 화면의 전체 JSON snapshot 대체를 금지하고 낙관적 버전으로 개별 변경을 보장한다.
model SourcingInterestTarget {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  targetKey    String   @map("target_key") @db.VarChar(300)
  targetType   String   @map("target_type") @db.VarChar(40)
  label        String   @db.VarChar(300)
  sourceKeys   String[] @default([]) @map("source_keys")
  keyword      String?  @db.VarChar(200)
  category     String?  @db.VarChar(200)
  productId    String?  @map("product_id") @db.VarChar(200)
  itemId       String?  @map("item_id") @db.VarChar(200)
  vendorItemId String?  @map("vendor_item_id") @db.VarChar(200)
  productName  String?  @map("product_name") @db.VarChar(500)
  enabled      Boolean  @default(true)
  version      Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId], map: "sourcing_interest_targets_id_org_key")
  @@unique([organizationId, targetKey], map: "sourcing_interest_targets_org_target_key")
  @@index([organizationId, enabled, updatedAt], map: "sourcing_interest_targets_enabled_updated_idx")
  @@map("sourcing_interest_targets")
}

/// @namespace Sourcing
/// @describe 조직별 키워드 제외 설정. 전체 JSON snapshot 대신 키 하나를 낙관적으로 갱신한다.
model SourcingKeywordPreference {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  keywordNormalized String   @map("keyword_normalized") @db.VarChar(200)
  displayKeyword    String   @map("display_keyword") @db.VarChar(200)
  excluded          Boolean  @default(false)
  version           Int      @default(1)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([id, organizationId], map: "sourcing_keyword_preferences_id_org_key")
  @@unique([organizationId, keywordNormalized], map: "sourcing_keyword_preferences_org_keyword_key")
  @@index([organizationId, excluded, updatedAt], map: "sourcing_keyword_preferences_excluded_idx")
  @@map("sourcing_keyword_preferences")
}

/// @namespace Sourcing
/// @describe 1688 키워드 검색에서 수집한 정확한 offer/variant 관측치. 같은 offer가 여러 키워드에서 발견된 provenance를 보존한다.
model Sourcing1688OfferKeywordObservation {
  id                    String @id @default(uuid()) @db.Uuid
  organizationId        String @map("organization_id") @db.Uuid
  evidenceObservationId String @map("evidence_observation_id") @db.Uuid
  ingestionRunId        String @map("ingestion_run_id") @db.Uuid

  businessDate            DateTime @map("business_date") @db.Date
  sourceKeywordNormalized String   @map("source_keyword_normalized") @db.VarChar(200)
  externalOfferId         String   @map("external_offer_id") @db.VarChar(200)
  variantKeyNormalized    String   @default("") @map("variant_key_normalized") @db.VarChar(300)
  sourceUrl               String?  @map("source_url") @db.Text
  title                   String?  @db.VarChar(500)
  supplierName            String?  @map("supplier_name") @db.VarChar(300)
  imageUrl                String?  @map("image_url") @db.Text
  rank                    Int?
  priceCny                Decimal? @map("price_cny") @db.Decimal(12, 2)
  monthlySales            Int?     @map("monthly_sales")
  rawOffer                Json     @default("{}") @map("raw_offer") @db.JsonB
  capturedAt              DateTime @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization        Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidenceObservation SourcingEvidenceObservation  @relation(fields: [evidenceObservationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  ingestionRun        SourcingEvidenceIngestionRun @relation(fields: [ingestionRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reviewBatchItems    SourcingReviewBatchItem[]

  @@unique([id, organizationId], map: "sourcing_1688_offer_keyword_observations_id_org_key")
  @@unique([evidenceObservationId, organizationId], map: "sourcing_1688_offer_keyword_observations_evidence_org_key")
  @@unique([organizationId, businessDate, sourceKeywordNormalized, externalOfferId, variantKeyNormalized, capturedAt], map: "sourcing_1688_offer_keyword_observations_identity_key")
  @@index([ingestionRunId])
  @@index([organizationId, sourceKeywordNormalized, capturedAt(sort: Desc)], map: "sourcing_1688_offer_keyword_observations_keyword_captured_idx")
  @@index([organizationId, externalOfferId, variantKeyNormalized, capturedAt(sort: Desc)], map: "sourcing_1688_offer_keyword_observations_offer_captured_idx")
  @@map("sourcing_1688_offer_keyword_observations")
}

/// @namespace Sourcing
/// @describe 문구·완구 시장 트렌드 정기 수집의 시드 키워드. sources 로 몰별(naver/shorts/1688) 수집 대상을 제어. keywordCn 은 1688 中文 검색어(null이면 keyword 사용).
model TrendSeedKeyword {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  keyword   String
  keywordCn String?  @map("keyword_cn")
  sources   String[] @default(["naver", "shorts", "1688"])
  enabled   Boolean  @default(true)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyword])
  @@index([organizationId])
  @@map("trend_seed_keywords")
}

/// @namespace Sourcing
/// @describe 네이버 키워드(검색광고 월검색량 + 데이터랩 검색어트렌드) 일별 스냅샷. 시드 키워드당 하루 1행(최신본 upsert). trendRatio 는 latestRatio 반올림(0-100).
model NaverKeywordDailySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  keyword        String
  businessDate   DateTime @map("business_date") @db.Date

  monthlyTotalSearchCount  Int?    @map("monthly_total_search_count")
  monthlyPcSearchCount     Int?    @map("monthly_pc_search_count")
  monthlyMobileSearchCount Int?    @map("monthly_mobile_search_count")
  competitionIndex         String? @map("competition_index")
  averageAdRank            Int?    @map("average_ad_rank")
  trendRatio               Int?    @map("trend_ratio")
  trendDelta               Int?    @map("trend_delta")

  source     String   @default("naver")
  capturedAt DateTime @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, keyword, businessDate])
  @@index([organizationId, keyword, businessDate])
  @@map("naver_keyword_daily_snapshots")
}

/// @namespace Sourcing
/// @describe 네이버 데이터랩 인기키워드 보드(출산/육아·완구/인형·문구/사무 등)의 일별 순위 스냅샷. 보드×키워드 identity를 사용하고 매 수집마다 보드×일자 범위를 통째로 교체한다.
model NaverPopularKeywordDailySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  boardKey       String   @map("board_key")
  boardLabel     String?  @map("board_label")
  cid            String?
  businessDate   DateTime @map("business_date") @db.Date

  rank    Int
  keyword String
  linkId  String? @map("link_id")

  capturedAt DateTime @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, boardKey, businessDate, keyword])
  @@index([organizationId, boardKey, businessDate])
  @@map("naver_popular_keyword_daily_snapshots")
}

/// @namespace Sourcing
/// @describe 쇼츠트렌드(shortstrend.co.kr) 급상승 쇼츠 일별 스냅샷. rank 는 소스 노출 순위, videoKey 는 영상 식별자. video×일자당 1행.
model ShortsTrendDailySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessDate   DateTime @map("business_date") @db.Date
  videoKey       String   @map("video_key")

  rank         Int?
  title        String?
  channelName  String?   @map("channel_name")
  viewCount    Int?      @map("view_count")
  likeCount    Int?      @map("like_count")
  commentCount Int?      @map("comment_count")
  keyword      String?
  publishedAt  DateTime? @map("published_at") @db.Timestamptz
  thumbnailUrl String?   @map("thumbnail_url")
  videoUrl     String?   @map("video_url")

  source     String   @default("shortstrend")
  capturedAt DateTime @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, businessDate, videoKey])
  @@index([organizationId, businessDate])
  @@map("shorts_trend_daily_snapshots")
}

/// @namespace Sourcing
/// @describe 타오바오 공식 API 또는 로그인된 1688·도우인 브라우저 화면에서 수집한 라이브 방송 일별 스냅샷. source와 broadcastId가 외부 방송 식별자를 이룬다.
model LiveCommerceBroadcastDailySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessDate   DateTime @map("business_date") @db.Date
  source         String
  broadcastId    String   @map("broadcast_id")

  title           String?
  broadcasterId   String?   @map("broadcaster_id")
  broadcasterName String?   @map("broadcaster_name")
  status          String?
  viewerCount     Int?      @map("viewer_count")
  likeCount       Int?      @map("like_count")
  startedAt       DateTime? @map("started_at") @db.Timestamptz
  endedAt         DateTime? @map("ended_at") @db.Timestamptz
  coverImageUrl   String?   @map("cover_image_url")
  sourceUrl       String?   @map("source_url")
  capturedAt      DateTime  @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, businessDate, source, broadcastId])
  @@index([organizationId, source, businessDate])
  @@map("live_commerce_broadcast_daily_snapshots")
}

/// @namespace Sourcing
/// @describe 중국 라이브 방송에 노출된 상품의 일별 스냅샷. broadcastId로 방송 스냅샷과 논리적으로 연결하고 상품 단위 비교를 지원한다.
model LiveCommerceProductDailySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessDate   DateTime @map("business_date") @db.Date
  source         String
  broadcastId    String   @map("broadcast_id")
  productId      String   @map("product_id")

  rank       Int?
  title      String?
  priceCny   Decimal? @map("price_cny") @db.Decimal(12, 2)
  salesCount Int?     @map("sales_count")
  imageUrl   String?  @map("image_url")
  sourceUrl  String?  @map("source_url")
  capturedAt DateTime @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, businessDate, source, broadcastId, productId])
  @@index([organizationId, source, businessDate], map: "live_commerce_product_source_date_idx")
  @@index([organizationId, source, productId], map: "live_commerce_product_source_product_idx")
  @@map("live_commerce_product_daily_snapshots")
}

/// @namespace Sourcing
/// @describe 틱톡 크리에이티브 센터(Creative Center)에서 확장이 스크랩한 인기 트렌드 일별 스냅샷. trendType(hashtag|keyword|product|song)으로 종류를, region(국가코드)으로 시장을 구분하고 (region,trendType,entityKey)가 외부 식별자를 이룬다. viewCount 는 int4 를 초과할 수 있어 BigInt. ⚠️ 라이브 틱톡 원본은 봇/리전 차단이라 무료로는 확장 스크랩 경로로만 적재한다([[reference_market_trend_research_tools]]).
model TiktokCreativeTrendDailySnapshot {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  businessDate   DateTime @map("business_date") @db.Date
  region         String
  trendType      String   @map("trend_type")
  entityKey      String   @map("entity_key")

  rank          Int?
  label         String?
  industry      String?
  sourceKeyword String?  @map("source_keyword")
  postCount     Int?     @map("post_count")
  viewCount     BigInt?  @map("view_count")
  growthPct     Decimal? @map("growth_pct") @db.Decimal(12, 2)
  thumbnailUrl  String?  @map("thumbnail_url")
  sourceUrl     String?  @map("source_url")

  source     String   @default("tiktok-cc")
  capturedAt DateTime @map("captured_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, businessDate, region, trendType, entityKey])
  @@index([organizationId, businessDate])
  @@map("tiktok_creative_trend_daily_snapshots")
}

/// @namespace Sourcing
/// @describe Optional organization-level pause for an allowlisted collection source. Absence means enabled.
model SourcingCollectionSourceControl {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sourceKey      String   @map("source_key") @db.VarChar(80)
  enabled        Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, sourceKey], map: "sourcing_collection_source_controls_org_source_key")
  @@index([organizationId, enabled, updatedAt], map: "sourcing_collection_source_controls_runtime_idx")
  @@map("sourcing_collection_source_controls")
}

/// @namespace Sourcing
/// @describe Durable collector attempt with a fenced lease, request identity, collection window, coverage, and terminal result.
model SourcingEvidenceIngestionRun {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  sourceKey              String    @default("") @map("source_key") @db.VarChar(80)
  scopeKey               String    @default("default") @map("scope_key") @db.VarChar(160)
  leaseToken             String    @default(uuid()) @map("lease_token") @db.Uuid
  leaseExpiresAt         DateTime  @default(now()) @map("lease_expires_at") @db.Timestamptz
  sourceControlCheckedAt DateTime  @default(now()) @map("source_control_checked_at") @db.Timestamptz
  generation             Int       @default(1)
  cancelRequestedAt      DateTime? @map("cancel_requested_at") @db.Timestamptz
  staleDiscardedCount    Int       @default(0) @map("stale_discarded_count")

  targetKey         String  @map("target_key") @db.VarChar(300)
  idempotencyKey    String  @map("idempotency_key") @db.VarChar(300)
