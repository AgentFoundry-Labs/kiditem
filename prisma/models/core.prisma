/// @namespace Core
/// @describe Organization-owned canonical inventory product and sole official product ABC identity.
model MasterProduct {
  id                     String    @id @default(uuid()) @db.Uuid
  organizationId         String    @map("organization_id") @db.Uuid
  originChannelListingId String?   @map("origin_channel_listing_id") @db.Uuid
  code                   String
  name                   String
  description            String?
  category               String?
  brand                  String?
  tags                   String[]  @default([])
  imageUrls              String[]  @default([]) @map("image_urls")
  abcGrade               String?   @map("abc_grade")
  profitTag              String?   @map("profit_tag")
  adTier                 String?   @map("ad_tier")
  adBudgetLimit          Int?      @map("ad_budget_limit")
  healthScore            Int?      @map("health_score")
  healthUpdatedAt        DateTime? @map("health_updated_at") @db.Timestamptz
  isActive               Boolean   @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization                 Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provenanceCandidate          SourcingCandidate?                   @relation("SourcingCandidateProvenance")
  channelListings              ChannelListing[]                     @relation("ChannelListingOperationalProduct")
  originChannelListing         ChannelListing?                      @relation("ChannelListingOriginProduct", fields: [originChannelListingId, organizationId], references: [id, organizationId], onDelete: Restrict)
  inventorySkus                SellpiaInventorySku[]                @relation("MasterProductInventorySkus")
  frozenSellpiaProfitFacts     SellpiaProductMonthlySales[]         @relation("SellpiaProductMonthlyFrozenMaster")
  frozenAdvertisingProfitFacts ChannelAdListingProductMonthlyFact[] @relation("AdFactMasterProduct")
  abcEvaluation                MasterProductAbcEvaluation?
  abcGradeHistories            MasterProductAbcGradeHistory[]

  @@unique([organizationId, code])
  @@unique([originChannelListingId, organizationId])
  @@unique([id, organizationId], map: "master_products_id_org_key")
  @@index([organizationId])
  @@index([organizationId, isActive])
  @@map("master_products")
}

/// @namespace Core
/// @describe Immutable organization-owned formula versions for absolute product ABC publication.
model MasterProductAbcFormulaVersion {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  formulaKey      String   @map("formula_key")
  version         Int
  formulaJson     Json     @map("formula_json") @db.JsonB
  formulaChecksum String   @map("formula_checksum")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeFormulaState MasterProductAbcFormulaState?  @relation("MasterProductAbcFormulaStateActiveFormula")
  evaluations        MasterProductAbcEvaluation[]   @relation("MasterProductAbcFormulaVersionEvaluations")
  gradeHistories     MasterProductAbcGradeHistory[] @relation("MasterProductAbcFormulaVersionGradeHistories")

  @@unique([id, organizationId], map: "master_product_abc_formula_versions_id_org_key")
  @@unique([organizationId, formulaKey, version], map: "master_product_abc_formula_versions_org_key_version_key")
  @@unique([organizationId, formulaChecksum], map: "master_product_abc_formula_versions_org_checksum_key")
  @@index([organizationId, formulaKey, createdAt])
  @@map("master_product_abc_formula_versions")
}

/// @namespace Core
/// @describe One organization-owned formula and official publication envelope.
model MasterProductAbcFormulaState {
  organizationId                        String    @id @map("organization_id") @db.Uuid
  activeFormulaVersionId                String?   @map("active_formula_version_id") @db.Uuid
  formulaRevision                       Int       @default(0) @map("formula_revision")
  publicationRevision                   Int       @default(0) @map("publication_revision")
  officialCutoffDate                    DateTime? @map("official_cutoff_date") @db.Date
  publishedSellpiaSourceImportRunId     String?   @map("published_sellpia_source_import_run_id") @db.Uuid
  publishedAdvertisingSourceImportRunId String?   @map("published_advertising_source_import_run_id") @db.Uuid
  publishedMappingGeneration            BigInt?   @map("published_mapping_generation") @db.BigInt
  mappingGeneration                     BigInt    @default(0) @map("mapping_generation") @db.BigInt
  publishedAt                           DateTime? @map("published_at") @db.Timestamptz
  createdAt                             DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization                        Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeFormulaVersion                MasterProductAbcFormulaVersion? @relation("MasterProductAbcFormulaStateActiveFormula", fields: [activeFormulaVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  publishedSellpiaSourceImportRun     SourceImportRun?                @relation("MasterProductAbcFormulaStatePublishedSellpia", fields: [publishedSellpiaSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  publishedAdvertisingSourceImportRun SourceImportRun?                @relation("MasterProductAbcFormulaStatePublishedAdvertising", fields: [publishedAdvertisingSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([activeFormulaVersionId, organizationId], map: "master_product_abc_formula_states_active_formula_org_key")
  @@index([publishedSellpiaSourceImportRunId, organizationId])
  @@index([publishedAdvertisingSourceImportRunId, organizationId])
  @@map("master_product_abc_formula_states")
}

/// @namespace Core
/// @describe Current Products-owned normal absolute ABC evaluation for one MasterProduct.
model MasterProductAbcEvaluation {
  id                           String   @id @default(uuid()) @db.Uuid
  organizationId               String   @map("organization_id") @db.Uuid
  masterProductId              String   @map("master_product_id") @db.Uuid
  formulaVersionId             String   @map("formula_version_id") @db.Uuid
  abcGrade                     String   @map("abc_grade")
  weightedRevenue              Decimal  @map("weighted_revenue") @db.Decimal(20, 6)
  weightedOrderTimeSupplyCost  Decimal  @map("weighted_order_time_supply_cost") @db.Decimal(20, 6)
  weightedAdvertisingSpend     Decimal  @map("weighted_advertising_spend") @db.Decimal(20, 6)
  weightedOperatingProfit      Decimal  @map("weighted_operating_profit") @db.Decimal(20, 6)
  operatingProfitVelocity30    Decimal  @map("operating_profit_velocity_30") @db.Decimal(20, 6)
  operatingMargin              Decimal? @map("operating_margin") @db.Decimal(12, 6)
  lossPersistence              Decimal  @map("loss_persistence") @db.Decimal(12, 6)
  profitScore                  Decimal  @map("profit_score") @db.Decimal(12, 6)
  marginScore                  Decimal? @map("margin_score") @db.Decimal(12, 6)
  consistencyScore             Decimal  @map("consistency_score") @db.Decimal(12, 6)
  economicScore                Decimal  @map("economic_score") @db.Decimal(12, 6)
  validObservationDays         Int      @map("valid_observation_days")
  formulaRevision              Int      @map("formula_revision")
  publicationRevision          Int      @map("publication_revision")
  gradeBasisCutoffDate         DateTime @map("grade_basis_cutoff_date") @db.Date
  /// Normalized verified sale-start provenance used by this evaluation. It is
  /// nullable only so pre-cutover rows remain readable; new publications must
  /// always provide it.
  saleStartDate                DateTime? @map("sale_start_date") @db.Date
  sellpiaSourceImportRunId     String   @map("sellpia_source_import_run_id") @db.Uuid
  advertisingSourceImportRunId String   @map("advertising_source_import_run_id") @db.Uuid
  sellpiaGeneration            BigInt   @map("sellpia_generation") @db.BigInt
  advertisingGeneration        BigInt   @map("advertising_generation") @db.BigInt
  mappingGeneration            BigInt   @map("mapping_generation") @db.BigInt
  calculatedAt                 DateTime @default(now()) @map("calculated_at") @db.Timestamptz

  organization               Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  masterProduct              MasterProduct                  @relation(fields: [masterProductId, organizationId], references: [id, organizationId], onDelete: Cascade)
  formulaVersion             MasterProductAbcFormulaVersion @relation("MasterProductAbcFormulaVersionEvaluations", fields: [formulaVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sellpiaSourceImportRun     SourceImportRun                @relation("MasterProductAbcEvaluationSellpiaSourceImport", fields: [sellpiaSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  advertisingSourceImportRun SourceImportRun                @relation("MasterProductAbcEvaluationAdvertisingSourceImport", fields: [advertisingSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([masterProductId, organizationId])
  @@index([organizationId, formulaVersionId])
  @@index([formulaVersionId, organizationId])
  @@index([masterProductId])
  @@index([sellpiaSourceImportRunId, organizationId])
  @@index([advertisingSourceImportRunId, organizationId])
  @@index([organizationId, publicationRevision])
  @@map("master_product_abc_evaluations")
}

/// @namespace Core
/// @describe Immutable absolute ABC grade transitions after the initial baseline.
model MasterProductAbcGradeHistory {
  id                                   String   @id @default(uuid()) @db.Uuid
  organizationId                       String   @map("organization_id") @db.Uuid
  masterProductId                      String   @map("master_product_id") @db.Uuid
  formulaVersionId                     String   @map("formula_version_id") @db.Uuid
  oldGrade                             String?  @map("old_grade")
  newGrade                             String?  @map("new_grade")
  economicScore                        Decimal? @map("economic_score") @db.Decimal(12, 6)
  weightedOperatingProfit              Decimal? @map("weighted_operating_profit") @db.Decimal(20, 6)
  operatingMargin                      Decimal? @map("operating_margin") @db.Decimal(12, 6)
  previousSellpiaSourceImportRunId     String?  @map("previous_sellpia_source_import_run_id") @db.Uuid
  nextSellpiaSourceImportRunId         String?  @map("next_sellpia_source_import_run_id") @db.Uuid
  previousAdvertisingSourceImportRunId String?  @map("previous_advertising_source_import_run_id") @db.Uuid
  nextAdvertisingSourceImportRunId     String?  @map("next_advertising_source_import_run_id") @db.Uuid
  formulaRevision                      Int      @map("formula_revision")
  publicationRevision                  Int      @map("publication_revision")
  sourceCutoffDate                     DateTime @map("source_cutoff_date") @db.Date
  reason                               String   @db.VarChar(100)
  calculatedAt                         DateTime @default(now()) @map("calculated_at") @db.Timestamptz

  organization                       Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  masterProduct                      MasterProduct                  @relation(fields: [masterProductId, organizationId], references: [id, organizationId], onDelete: Cascade)
  formulaVersion                     MasterProductAbcFormulaVersion @relation("MasterProductAbcFormulaVersionGradeHistories", fields: [formulaVersionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  previousSellpiaSourceImportRun     SourceImportRun?               @relation("MasterProductAbcGradeHistoryPreviousSellpiaSourceImport", fields: [previousSellpiaSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  nextSellpiaSourceImportRun         SourceImportRun?               @relation("MasterProductAbcGradeHistoryNextSellpiaSourceImport", fields: [nextSellpiaSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  previousAdvertisingSourceImportRun SourceImportRun?               @relation("MasterProductAbcGradeHistoryPreviousAdvertisingSourceImport", fields: [previousAdvertisingSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  nextAdvertisingSourceImportRun     SourceImportRun?               @relation("MasterProductAbcGradeHistoryNextAdvertisingSourceImport", fields: [nextAdvertisingSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId, calculatedAt])
  @@index([organizationId, formulaVersionId])
  @@index([formulaVersionId, organizationId])
  @@index([masterProductId])
  @@index([masterProductId, calculatedAt])
  @@index([previousSellpiaSourceImportRunId, organizationId])
  @@index([nextSellpiaSourceImportRunId, organizationId])
  @@index([previousAdvertisingSourceImportRunId, organizationId])
  @@index([nextAdvertisingSourceImportRunId, organizationId])
  @@map("master_product_abc_grade_histories")
}

/// @namespace Core
/// @describe 채널에 올라간 판매 등록상품. 쿠팡 등록상품ID, 네이버 상품번호 등.
model ChannelListing {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  channelAccountId  String  @map("channel_account_id") @db.Uuid
  sourceCandidateId String? @map("source_candidate_id") @db.Uuid
  masterProductId   String? @map("master_product_id") @db.Uuid

  externalId String @map("external_id")

  channelName     String? @map("channel_name")
  displayName     String? @map("display_name")
  category        String?
  brand           String?
  manufacturer    String?
  rawJson         Json?   @map("raw_json")
  lastImportRunId String? @map("last_import_run_id") @db.Uuid

  status         String?
  exposureStatus String? @map("exposure_status")

  deliveryChargeType String? @map("delivery_charge_type")
  freeShipOverAmount Int?    @map("free_ship_over_amount")
  returnCharge       Int?    @map("return_charge")
  deliveryInfo       Json?   @map("delivery_info")

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization                  Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelAccount                ChannelAccount                    @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceCandidate               SourcingCandidate?                @relation(fields: [sourceCandidateId, organizationId], references: [id, organizationId], onDelete: Restrict)
  masterProduct                 MasterProduct?                    @relation("ChannelListingOperationalProduct", fields: [masterProductId, organizationId], references: [id, organizationId], onDelete: Restrict)
  originatedMasterProduct       MasterProduct?                    @relation("ChannelListingOriginProduct")
  lastImportRun                 SourceImportRun?                  @relation("ChannelProductLastImport", fields: [lastImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  options                       ChannelListingOption[]
  contentWorkspaces             ContentWorkspace[]
  productPreparations           ProductPreparation[]
  productRegistrationExecutions ProductRegistrationExecution[]    @relation("ChannelListingProductRegistrationExecutions")
  deletionOperations            ChannelListingDeletionOperation[] @relation("ChannelListingDeletionOperations")

  reviews            Review[]
  thumbnails         Thumbnail[]
  thumbnailTrackings ThumbnailTracking[]
  adActions          AdAction[]

  // Channels — market-data snapshots (Wave C0)
  channelScrapeSnapshots             ChannelScrapeSnapshot[]
  channelListingDailySnapshots       ChannelListingDailySnapshot[]
  channelListingOptionDailySnapshots ChannelListingOptionDailySnapshot[]

  // Channels — daily fact extensions (Hard rewrite H1)
  channelAdTargetDailySnapshots       ChannelAdTargetDailySnapshot[]
  channelAdListingProductMonthlyFacts ChannelAdListingProductMonthlyFact[] @relation("AdFactChannelListing")

  @@unique([organizationId, channelAccountId, externalId])
  @@unique([organizationId, sourceCandidateId, channelAccountId], map: "channel_listings_org_source_account_active_key", where: raw("source_candidate_id IS NOT NULL AND is_active = true"))
  @@unique([id, organizationId], map: "channel_listings_id_org_key")
  @@unique([id, organizationId, channelAccountId], map: "channel_listings_id_org_account_key")
  @@index([organizationId])
  @@index([channelAccountId])
  @@index([sourceCandidateId])
  @@index([masterProductId])
  @@index([organizationId, masterProductId])
  @@index([lastImportRunId])
  @@index([organizationId, channelAccountId, isActive])
  @@index([organizationId, updatedAt, id])
  @@map("channel_listings")
}

/// @namespace Core
/// @describe One sellable SKU under a channel listing.
model ChannelListingOption {
  id             String @id @default(uuid()) @db.Uuid
  listingId      String @map("listing_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid

  externalOptionId  String   @map("external_option_id") @db.VarChar(60)
  itemName          String?  @map("item_name")
  salePrice         Int?     @map("sale_price")
  costPriceOverride Int?     @map("cost_price_override")
  commissionRate    Decimal? @map("commission_rate") @db.Decimal(5, 4)
  shippingCost      Int?     @map("shipping_cost")
  otherCost         Int?     @map("other_cost")
  sellerSku         String?  @map("seller_sku")
  barcode           String?
  modelNumber       String?  @map("model_number")
  status            String?
  attributesJson    Json?    @map("attributes_json")
  rawJson           Json?    @map("raw_json")
  lastImportRunId   String?  @map("last_import_run_id") @db.Uuid

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  listing                         ChannelListing                           @relation(fields: [listingId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization                    Organization                             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryComponents             ChannelListingOptionInventoryComponent[]
  lastImportRun                   SourceImportRun?                         @relation("ChannelSkuLastImport", fields: [lastImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  orderLineItems                  OrderLineItem[]
  orderReturnLineItems            OrderReturnLineItem[]
  rocketPurchaseConfirmationLines RocketPurchaseConfirmationLine[]
  adActions                       AdAction[]

  // Channels — market-data snapshots (Wave C0)
  channelScrapeSnapshots             ChannelScrapeSnapshot[]
  channelListingOptionDailySnapshots ChannelListingOptionDailySnapshot[]

  // Channels — daily fact extensions (Hard rewrite H1)
  channelAdTargetDailySnapshots ChannelAdTargetDailySnapshot[]

  @@unique([listingId, externalOptionId])
  @@unique([id, organizationId], map: "channel_listing_options_id_org_key")
  @@index([organizationId, externalOptionId])
  @@index([externalOptionId])
  @@index([lastImportRunId])
  @@map("channel_listing_options")
}

/// @namespace Core
/// @describe Confirmed Sellpia inventory consumption for one channel sellable option.
model ChannelListingOptionInventoryComponent {
  id                     String   @id @default(uuid()) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  channelListingOptionId String   @map("channel_listing_option_id") @db.Uuid
  sellpiaInventorySkuId  String   @map("sellpia_inventory_sku_id") @db.Uuid
  quantity               Int
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelListingOption ChannelListingOption @relation(fields: [channelListingOptionId, organizationId], references: [id, organizationId], onDelete: Cascade)
  sellpiaInventorySku  SellpiaInventorySku  @relation(fields: [sellpiaInventorySkuId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([channelListingOptionId, sellpiaInventorySkuId])
  @@index([organizationId, channelListingOptionId], map: "channel_option_inventory_components_org_option_idx")
  @@index([organizationId, sellpiaInventorySkuId], map: "channel_option_inventory_components_org_sku_idx")
  @@map("channel_listing_option_inventory_components")
}
