// core.prisma — Core domain

/// @namespace Core
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  // Core
  memberships                     OrganizationMembership[]
  legalEntities                   LegalEntity[]
  channelAccounts                 ChannelAccount[]
  sellpiaManualMatchSnapshots     SellpiaManualMatchSnapshot[]
  sellpiaManualMatchAliases       SellpiaManualMatchAlias[]
  sourceImportRuns                SourceImportRun[]
  orderCollectionArtifacts        OrderCollectionArtifact[]
  coupangDirectTransportReceipts     CoupangDirectTransportReceipt[]
  coupangDirectTransportConsumptions CoupangDirectTransportConsumption[]
  reviewCollectionChunks          ReviewCollectionChunk[]
  rocketPoCatalogSnapshots        RocketPoCatalogSnapshot[]
  rocketPoCatalogLines            RocketPoCatalogLine[]
  orders                          Order[]
  purchaseOrders                  PurchaseOrder[]
  purchaseOrderSubmissionAttempts PurchaseOrderSubmissionAttempt[]
  thumbnails                      Thumbnail[]
  thumbnailAnalyses               ThumbnailAnalysis[]
  thumbnailGenerations            ThumbnailGeneration[]
  thumbnailGenerationCandidates   ThumbnailGenerationCandidate[]
  thumbnailGenerationInputImages  ThumbnailGenerationInputImage[]
  thumbnailGenerationEvents       ThumbnailGenerationEvent[]
  thumbnailRegistrationAttempts   ThumbnailRegistrationAttempt[]
  thumbnailTrackings              ThumbnailTracking[]
  thumbnailTrackingDailySnapshots ThumbnailTrackingDailySnapshot[]
  reviews                         Review[]
  alerts                          Alert[]
  rulesEvaluationApplications     RulesEvaluationApplication[]

  // Sourcing & Content
  contentGenerations                  ContentGeneration[]
  contentGenerationGroups             ContentGenerationGroup[]
  contentGenerationSources            ContentGenerationSource[]
  contentAssets                       ContentAsset[]
  contentGenerationAssetUsages        ContentGenerationAssetUsage[]
  contentWorkspaces                   ContentWorkspace[]
  contentWorkspaceThumbnailSelections ContentWorkspaceThumbnailSelection[]
  productPreparations                 ProductPreparation[]
  productRegistrationExecutions       ProductRegistrationExecution[]       @relation("ProductRegistrationExecutionOrganization")
  detailPageArtifacts                 DetailPageArtifact[]
  detailPageRevisions                 DetailPageRevision[]
  detailPageImageArtifacts            DetailPageImageArtifact[]
  detailPageImageRenderIntents        DetailPageImageRenderIntent[]
  aiDirectJobs                        AiDirectJob[]

  // Durable domain activity
  activityEvents ActivityEvent[]

  // Agent OS — exact capability mutation admission and replay receipts.
  capabilityInvocations CapabilityInvocation[]

  // Order domain (Plan A.5)
  orderLineItems       OrderLineItem[]
  orderReturns         OrderReturn[]
  orderReturnLineItems OrderReturnLineItem[]

  // Supplier & Procurement
  suppliers                               Supplier[]
  supplierPayments                        SupplierPayment[]
  supplierProducts                        SupplierProduct[]
  supplierOfferSkuSnapshots               SupplierOfferSkuSnapshot[]
  supplierOfferPriceTiers                 SupplierOfferPriceTier[]
  procurementTestIntents                  ProcurementTestIntent[]
  purchaseOrderItems                      PurchaseOrderItem[]
  rocketPurchaseConfirmations             RocketPurchaseConfirmation[]
  rocketPurchaseConfirmationLines         RocketPurchaseConfirmationLine[]
  rocketPurchaseConfirmationAllocations   RocketPurchaseConfirmationAllocation[]
  rocketPurchaseConfirmationTransmissions RocketPurchaseConfirmationTransmission[]

  // Warehouse & record-only inventory operations
  warehouses                                    Warehouse[]
  stockTransfers                                StockTransfer[]
  coupangShipmentDateSummaries                  CoupangShipmentDateSummary[]
  sellpiaInventoryState                         SellpiaInventoryState?
  sellpiaOrderTransmissionIntents               SellpiaOrderTransmissionIntent[]
  sellpiaOrderTransmissionIntentReconciliations SellpiaOrderTransmissionIntentReconciliation[]
  coupangDirectPoSnapshots                      CoupangDirectPoSnapshot[]

  // Record-only returns
  returnTransfers ReturnTransfer[]

  // Finance
  settlements Settlement[]

  // Operations & Config
  categoryMappings CategoryMapping[]

  // Analytics
  salesPlans                 SalesPlan[]
  sellpiaSalesDailySnapshots SellpiaSalesDailySnapshot[]
  sellpiaProductMonthlySales SellpiaProductMonthlySales[]

  // Ontology
  businessRules  BusinessRule[]
  systemSettings SystemSetting[]

  // Ad Scrape Targets
  scrapeTargets ScrapeTarget[]

  // Ad Execution
  adActions        AdAction[]
  executionWorkers ExecutionWorker[]

  // Action Board
  actionTasks ActionTask[]

  // Product operations, Sellpia physical items, and channel catalogs
  masterProducts                              MasterProduct[]
  masterProductAbcFormulaVersions             MasterProductAbcFormulaVersion[]
  masterProductAbcFormulaState                MasterProductAbcFormulaState?
  masterProductAbcEvaluations                 MasterProductAbcEvaluation[]
  masterProductAbcGradeHistories              MasterProductAbcGradeHistory[]
  sellpiaInventorySkus                        SellpiaInventorySku[]
  channelListings                             ChannelListing[]
  channelListingOptions                       ChannelListingOption[]
  channelListingOptionInventoryComponents     ChannelListingOptionInventoryComponent[]
  channelRegistrationOwnerIdempotencyReceipts ChannelRegistrationOwnerIdempotencyReceipt[] @relation("ChannelRegistrationOwnerIdempotencyReceiptOrganization")
  channelListingDeletionOperations            ChannelListingDeletionOperation[]            @relation("ChannelListingDeletionOperationOrganization")

  // Channels — market-data snapshots (Wave C0)
  channelScrapeRuns                  ChannelScrapeRun[]
  channelScrapeChunks                ChannelScrapeChunk[]
  channelScrapeSnapshots             ChannelScrapeSnapshot[]
  channelListingDailySnapshots       ChannelListingDailySnapshot[]
  channelListingOptionDailySnapshots ChannelListingOptionDailySnapshot[]

  // Channels — daily fact extensions (Hard rewrite H1)
  channelAdTargetDailySnapshots       ChannelAdTargetDailySnapshot[]
  channelAccountDailyKpiSnapshots     ChannelAccountDailyKpiSnapshot[]
  channelAdListingProductMonthlyFacts ChannelAdListingProductMonthlyFact[]

  // Channels — Coupang keyword and competitor rank tracking
  coupangRepresentativeKeywordOverrides   CoupangRepresentativeKeywordOverride[]
  coupangKeywordTrackers                  CoupangKeywordTracker[]
  coupangKeywordRankDailySnapshots        CoupangKeywordRankDailySnapshot[]
  coupangKeywordSerpDailySnapshots        CoupangKeywordSerpDailySnapshot[]
  coupangWingSalesRankDailySnapshots      CoupangWingSalesRankDailySnapshot[]
  coupangWingTrackedProducts              CoupangWingTrackedProduct[]
  coupangWingTrackedProductDailySnapshots CoupangWingTrackedProductDailySnapshot[]

  // Sourcing (issue #192)
  sourcingCandidates                   SourcingCandidate[]
  sourcingOwnerIdempotencyReceipts     SourcingOwnerIdempotencyReceipt[]
  candidateImages                      CandidateImage[]
  sourcingWorkspaceSnapshots           SourcingWorkspaceSnapshot[]
  sourcingInterestTargets              SourcingInterestTarget[]
  sourcingKeywordPreferences           SourcingKeywordPreference[]
  sourcing1688OfferKeywordObservations Sourcing1688OfferKeywordObservation[]
  sourcingRecommendationRuns           SourcingRecommendationRun[]
  sourcingRecommendationItems          SourcingRecommendationItem[]
  sourcingRecommendationItemEvidence   SourcingRecommendationItemEvidence[]
  sourcingValidationEpisodes           SourcingValidationEpisode[]
  sourcingValidationChecks             SourcingValidationCheck[]
  sourcingValidationCheckEvidence      SourcingValidationCheckEvidence[]
  sourcingReviewSelections             SourcingReviewSelection[]
  sourcingReviewBatches                SourcingReviewBatch[]
  sourcingReviewBatchItems             SourcingReviewBatchItem[]

  // Sourcing — market trend and live-commerce snapshots
  trendSeedKeywords                   TrendSeedKeyword[]
  naverKeywordDailySnapshots          NaverKeywordDailySnapshot[]
  naverPopularKeywordDailySnapshots   NaverPopularKeywordDailySnapshot[]
  shortsTrendDailySnapshots           ShortsTrendDailySnapshot[]
  liveCommerceBroadcastDailySnapshots LiveCommerceBroadcastDailySnapshot[]
  liveCommerceProductDailySnapshots   LiveCommerceProductDailySnapshot[]
  tiktokCreativeTrendDailySnapshots   TiktokCreativeTrendDailySnapshot[]
  sourcingCollectionSourceControls    SourcingCollectionSourceControl[]
  sourcingEvidenceIngestionRuns       SourcingEvidenceIngestionRun[]
  sourcingEvidenceObservations        SourcingEvidenceObservation[]
  sourcingLaunchCandidates            SourcingLaunchCandidate[]
  sourcingDecisionBatches             SourcingDecisionBatch[]
  sourcingDecisionBatchItems          SourcingDecisionBatchItem[]
  sourcingDecisionEvidence            SourcingDecisionEvidence[]

  @@map("organizations")
}

/// @namespace Core
/// @describe Human or system account. Organization membership is the source of truth.
model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String?   @map("password")
  role         String    @default("member") // global/default role; per-organization role lives on OrganizationMembership.
  type         String    @default("human")
  team         String?
  avatarUrl    String?   @map("avatar_url")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  memberships                                OrganizationMembership[]
  authSessions                               AuthSession[]
  invitedOrganizationMemberships             OrganizationMembership[]                       @relation("OrganizationMembershipInviter")
  triggeredThumbnailGenerations              ThumbnailGeneration[]                          @relation("ThumbnailGenerationTriggeredBy")
  thumbnailGenerationEvents                  ThumbnailGenerationEvent[]                     @relation("ThumbnailGenerationEventActor")
  triggeredContentGenerations                ContentGeneration[]                            @relation("ContentGenerationTriggeredBy")
  createdContentAssets                       ContentAsset[]                                 @relation("ContentAssetCreatedBy")
  createdContentWorkspaces                   ContentWorkspace[]                             @relation("ContentWorkspaceCreatedBy")
  createdContentWorkspaceThumbnailSelections ContentWorkspaceThumbnailSelection[]           @relation("ContentWorkspaceThumbnailSelectionCreatedBy")
  createdProductPreparations                 ProductPreparation[]                           @relation("ProductPreparationCreatedBy")
  approvedProductPreparations                ProductPreparation[]                           @relation("ProductPreparationApprovedBy")
  requestedProductRegistrationExecutions     ProductRegistrationExecution[]                 @relation("ProductRegistrationExecutionRequestedBy")
  requestedChannelListingDeletionOperations  ChannelListingDeletionOperation[]              @relation("ChannelListingDeletionOperationRequestedBy")
  triggeredSourcingEvidenceIngestionRuns     SourcingEvidenceIngestionRun[]                 @relation("SourcingEvidenceIngestionRunTriggeredBy")
  requestedSourcingDecisionBatches           SourcingDecisionBatch[]                        @relation("SourcingDecisionBatchRequestedBy")
  requestedSourcingReviewBatches             SourcingReviewBatch[]                          @relation("SourcingReviewBatchRequestedBy")
  createdSourcingLaunchCandidates            SourcingLaunchCandidate[]                      @relation("SourcingLaunchCandidateCreatedBy")
  requestedProcurementTestIntents            ProcurementTestIntent[]                        @relation("ProcurementTestIntentRequestedBy")
  reviewedProcurementTestIntents             ProcurementTestIntent[]                        @relation("ProcurementTestIntentReviewedBy")
  createdDetailPageArtifacts                 DetailPageArtifact[]                           @relation("DetailPageArtifactCreatedBy")
  createdDetailPageRevisions                 DetailPageRevision[]                           @relation("DetailPageRevisionCreatedBy")
  createdDetailPageImageArtifacts            DetailPageImageArtifact[]                      @relation("DetailPageImageArtifactCreatedBy")
  requestedDetailPageImageRenderIntents      DetailPageImageRenderIntent[]                  @relation("DetailPageImageRenderIntentRequestedBy")
  claimedDetailPageImageRenderIntents        DetailPageImageRenderIntent[]                  @relation("DetailPageImageRenderIntentClaimedBy")
  actorAlerts                                Alert[]                                        @relation("AlertActor")
  assignedActionTasks                        ActionTask[]                                   @relation("ActionTaskAssignee")
  activeSellpiaInventoryStates               SellpiaInventoryState[]                        @relation("SellpiaInventoryStateActiveSyncOwner")
  createdSellpiaOrderTransmissionIntents     SellpiaOrderTransmissionIntent[]               @relation("SellpiaOrderTransmissionIntentCreator")
  reconciledSellpiaOrderTransmissionIntents  SellpiaOrderTransmissionIntentReconciliation[] @relation("SellpiaOrderTransmissionIntentReconciler")
  confirmedSourceImportRuns                  SourceImportRun[]                              @relation("SourceImportRunManualFreshExportConfirmer")
  reconciledPurchaseOrderSubmissionAttempts  PurchaseOrderSubmissionAttempt[]               @relation("PurchaseOrderSubmissionAttemptReconciler")
  confirmedRocketPurchaseConfirmations       RocketPurchaseConfirmation[]                   @relation("RocketPurchaseConfirmationConfirmer")
  releasedRocketPurchaseConfirmations        RocketPurchaseConfirmation[]                   @relation("RocketPurchaseConfirmationReleaser")

  // Agent OS — capability invocation actor relations
  initiatedCapabilityInvocations CapabilityInvocation[] @relation("CapabilityInvocationInitiator")
  approvedCapabilityInvocations  CapabilityInvocation[] @relation("CapabilityInvocationApprover")

  // Sourcing (issue #192)
  rejectedSourcingCandidates  SourcingCandidate[] @relation("SourcingCandidateRejectedBy")
  triggeredSourcingCandidates SourcingCandidate[] @relation("SourcingCandidateTriggeredBy")

  @@map("users")
}

/// @namespace Core
/// @describe Revocable KidItem-owned browser and extension authentication session. Only a SHA-256 token hash is persisted.
model AuthSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

/// @namespace Core
/// @describe B2B customer/workspace membership. A user may belong to multiple organizations; this row supplies request organization and role.
model OrganizationMembership {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  role           String    @default("member")
  status         String    @default("active")
  invitedById    String?   @map("invited_by_id") @db.Uuid
  joinedAt       DateTime  @default(now()) @map("joined_at") @db.Timestamptz
  lastSelectedAt DateTime? @map("last_selected_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitedBy    User?        @relation("OrganizationMembershipInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, userId])
  @@index([userId, status])
  @@index([organizationId, role])
  @@index([invitedById])
  @@map("organization_memberships")
}

/// @namespace Core
/// @describe Legal/business entity under an organization. This stores tax, invoice, and settlement identity separately from the SaaS organization boundary.
model LegalEntity {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  name               String
  businessNumber     String?  @map("business_number")
  countryCode        String   @default("KR") @map("country_code")
  representativeName String?  @map("representative_name")
  address            String?
  isPrimary          Boolean  @default(false) @map("is_primary")
  metadata           Json?    @db.JsonB
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([organizationId, isPrimary])
  @@map("legal_entities")
}

/// @namespace Core
/// @describe Marketplace/store account such as Coupang Wing or Naver SmartStore. Operational channel ownership is distinct from the SaaS organization.
model ChannelAccount {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  channel           String
  name              String
  externalAccountId String?  @map("external_account_id")
  sellerId          String?  @map("seller_id")
  vendorId          String?  @map("vendor_id")
  status            String   @default("active")
  isPrimary         Boolean  @default(false) @map("is_primary")
  config            Json?    @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization                        Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listings                            ChannelListing[]
  sourceImportRuns                    SourceImportRun[]
  productPreparations                 ProductPreparation[]
  productRegistrationExecutions       ProductRegistrationExecution[]       @relation("ChannelAccountProductRegistrationExecutions")
  channelListingDeletionOperations    ChannelListingDeletionOperation[]    @relation("ChannelAccountListingDeletionOperations")
  orders                              Order[]
  orderReturns                        OrderReturn[]
  channelScrapeRuns                   ChannelScrapeRun[]
  channelAdTargetDailySnapshots       ChannelAdTargetDailySnapshot[]
  channelAdListingProductMonthlyFacts ChannelAdListingProductMonthlyFact[]
  channelAccountDailyKpiSnapshots     ChannelAccountDailyKpiSnapshot[]
  rocketPurchaseConfirmations         RocketPurchaseConfirmation[]
  rocketPoCatalogSnapshots            RocketPoCatalogSnapshot[]
  sourcingLaunchCandidates            SourcingLaunchCandidate[]
  coupangDirectTransportReceipts      CoupangDirectTransportReceipt[]

  @@unique([organizationId, channel, externalAccountId])
  @@unique([id, organizationId], map: "channel_accounts_id_org_key")
  @@index([organizationId, channel])
  @@index([organizationId, isPrimary])
  @@map("channel_accounts")
}

/// @namespace Core
/// @describe Durable provenance and publication fence for Sellpia and channel full-snapshot imports.
model SourceImportRun {
  id                           String    @id @default(uuid()) @db.Uuid
  organizationId               String    @map("organization_id") @db.Uuid
  sourceType                   String    @map("source_type")
  rankKeyword                  String?   @map("rank_keyword")
  channelAccountId             String?   @map("channel_account_id") @db.Uuid
  fileName                     String?   @map("file_name")
  fileHash                     String?   @map("file_hash")
  status                       String    @default("running")
  rowCount                     Int       @default(0) @map("row_count")
  importedAt                   DateTime? @map("imported_at") @db.Timestamptz
  lastVerifiedAt               DateTime? @map("last_verified_at") @db.Timestamptz
  verificationCount            Int       @default(0) @map("verification_count")
  lastTrigger                  String?   @map("last_trigger")
  freshnessGeneration          BigInt?   @map("freshness_generation") @db.BigInt
  manualFreshExportConfirmedAt DateTime? @map("manual_fresh_export_confirmed_at") @db.Timestamptz
  manualFreshExportConfirmedBy String?   @map("manual_fresh_export_confirmed_by") @db.Uuid
  qualityReport                Json?     @map("quality_report") @db.JsonB
  errorCode                    String?   @map("error_code")
  errorMessage                 String?   @map("error_message")
  createdBy                    String?   @map("created_by")
  attemptToken                 String    @default(uuid()) @map("attempt_token") @db.Uuid
  idempotencyKey               String?   @map("idempotency_key") @db.VarChar(128)
  requestFingerprint           String?   @map("request_fingerprint") @db.VarChar(64)
  expiresAt                    DateTime? @map("expires_at") @db.Timestamptz
  plan                         Json?     @map("plan") @db.JsonB
  parserVersion                String?   @map("parser_version")
  contentChecksum              String?   @map("content_checksum") @db.VarChar(64)
  contentByteCount             Int?      @map("content_byte_count")
  providerBackedEmptyProof     Boolean?  @map("provider_backed_empty_proof")
  coveredMonths                String[]  @default([]) @map("covered_months")
  mappingGeneration            BigInt?   @map("mapping_generation") @db.BigInt
  publicationSequence          BigInt?   @map("publication_sequence") @db.BigInt
  coverageStartDate            DateTime? @map("coverage_start_date") @db.Date
  coverageEndDate              DateTime? @map("coverage_end_date") @db.Date
  adSourcePolicyHash           String?   @map("ad_source_policy_hash") @db.VarChar(64)
  createdAt                    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization                            Organization                             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelAccount                          ChannelAccount?                          @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  manualFreshExportConfirmer              User?                                    @relation("SourceImportRunManualFreshExportConfirmer", fields: [manualFreshExportConfirmedBy], references: [id], onDelete: SetNull)
  sellpiaProductMonthlySales              SellpiaProductMonthlySales[]             @relation("SellpiaProductMonthlySourceImport")
  sellpiaInventorySkus                    SellpiaInventorySku[]                    @relation("SellpiaInventorySkuLastImport")
  channelProducts                         ChannelListing[]                         @relation("ChannelProductLastImport")
  channelSkus                             ChannelListingOption[]                   @relation("ChannelSkuLastImport")
  channelScrapeRuns                       ChannelScrapeRun[]
  keywordSerpCaptures                     ChannelScrapeSnapshot[]                  @relation("KeywordSerpCapture")
  keywordRankDailyProjections             CoupangKeywordRankDailySnapshot[]        @relation("KeywordRankSource")
  keywordSerpDailyProjections             CoupangKeywordSerpDailySnapshot[]        @relation("KeywordSerpSource")
  wingRankDailyProjections                CoupangWingSalesRankDailySnapshot[]      @relation("WingRankSource")
  adListingProductMonthlyFacts            ChannelAdListingProductMonthlyFact[]     @relation("AdListingProductMonthlyFacts")
  adTargetDailySnapshots                  ChannelAdTargetDailySnapshot[]           @relation("AdTargetSourceImport")
  lastCompletedSellpiaInventoryStates     SellpiaInventoryState[]                  @relation("SellpiaInventoryStateLastCompletedRun")
  rocketPurchaseConfirmations             RocketPurchaseConfirmation[]
  rocketPurchaseConfirmationTransmissions RocketPurchaseConfirmationTransmission[]
  rocketPoCatalogSnapshot                 RocketPoCatalogSnapshot?
  coupangShipmentDateSummaries            CoupangShipmentDateSummary[]
  sellpiaSalesDailySnapshots               SellpiaSalesDailySnapshot[]    @relation("SellpiaSalesSource")
  orders                                  Order[]
  orderCollectionArtifact                 OrderCollectionArtifact?
  coupangDirectTransportEffectReceipts    CoupangDirectTransportReceipt[]     @relation("CoupangDirectTransportReceiptEffectSource")
  coupangDirectTransportConsumptions      CoupangDirectTransportConsumption[] @relation("CoupangDirectTransportConsumptionSource")
  reviewCollectionChunks                  ReviewCollectionChunk[]
  reviewCollectionFacts                   Review[]                    @relation("ReviewCollectionFacts")
  publishedSellpiaAbcFormulaStates        MasterProductAbcFormulaState[]           @relation("MasterProductAbcFormulaStatePublishedSellpia")
  publishedAdvertisingAbcFormulaStates    MasterProductAbcFormulaState[]           @relation("MasterProductAbcFormulaStatePublishedAdvertising")
  sellpiaAbcEvaluations                   MasterProductAbcEvaluation[]             @relation("MasterProductAbcEvaluationSellpiaSourceImport")
  advertisingAbcEvaluations               MasterProductAbcEvaluation[]             @relation("MasterProductAbcEvaluationAdvertisingSourceImport")
  previousSellpiaAbcGradeHistories        MasterProductAbcGradeHistory[]           @relation("MasterProductAbcGradeHistoryPreviousSellpiaSourceImport")
  nextSellpiaAbcGradeHistories            MasterProductAbcGradeHistory[]           @relation("MasterProductAbcGradeHistoryNextSellpiaSourceImport")
  previousAdvertisingAbcGradeHistories    MasterProductAbcGradeHistory[]           @relation("MasterProductAbcGradeHistoryPreviousAdvertisingSourceImport")
  nextAdvertisingAbcGradeHistories        MasterProductAbcGradeHistory[]           @relation("MasterProductAbcGradeHistoryNextAdvertisingSourceImport")

  @@unique([organizationId, sourceType, channelAccountId, fileHash], map: "source_import_runs_org_source_account_hash_key", where: raw("channel_account_id IS NOT NULL AND file_hash IS NOT NULL"))
  @@unique([organizationId, sourceType, fileHash], map: "source_import_runs_org_source_hash_null_account_key", where: raw("channel_account_id IS NULL AND file_hash IS NOT NULL"))
  @@unique([organizationId, sourceType, freshnessGeneration], map: "source_import_runs_org_source_failed_generation_key", where: raw("file_hash IS NULL AND source_type = 'sellpia_inventory' AND status = 'failed' AND freshness_generation IS NOT NULL"))
  @@unique([organizationId, sourceType, idempotencyKey], map: "source_import_runs_source_idempotency_key", where: raw("idempotency_key IS NOT NULL"))
  @@unique([organizationId, sourceType, rankKeyword], map: "source_import_runs_keyword_serp_running_key", where: raw("source_type IN ('coupang_keyword_serp', 'coupang_wing_rank') AND status = 'running'"))
  @@unique([organizationId, sourceType, rankKeyword, freshnessGeneration], map: "source_import_runs_keyword_serp_generation_key", where: raw("source_type IN ('coupang_keyword_serp', 'coupang_wing_rank') AND freshness_generation IS NOT NULL"))
  @@unique([organizationId, sourceType, channelAccountId], map: "source_import_runs_ad_keyword_running_key", where: raw("source_type = 'coupang_ad_keyword' AND status = 'running'"))
  @@unique([organizationId, sourceType, channelAccountId, freshnessGeneration], map: "source_import_runs_ad_keyword_generation_key", where: raw("source_type = 'coupang_ad_keyword' AND freshness_generation IS NOT NULL"))
  @@unique([organizationId, sourceType, channelAccountId], map: "source_import_runs_ad_campaign_running_key", where: raw("source_type = 'coupang_ad_campaign' AND status = 'running'"))
  @@unique([organizationId, sourceType, channelAccountId, freshnessGeneration], map: "source_import_runs_ad_campaign_generation_key", where: raw("source_type = 'coupang_ad_campaign' AND freshness_generation IS NOT NULL"))
  @@unique([organizationId, sourceType], map: "source_import_runs_ads_daily_running_key", where: raw("source_type = 'coupang_ads_daily' AND status = 'running'"))
  @@unique([organizationId, sourceType, channelAccountId, freshnessGeneration], map: "source_import_runs_ads_daily_generation_key", where: raw("source_type = 'coupang_ads_daily' AND channel_account_id IS NOT NULL AND freshness_generation IS NOT NULL"))
  @@unique([organizationId, sourceType, channelAccountId], map: "source_import_runs_wing_itemwinner_running_key", where: raw("source_type = 'coupang_wing_itemwinner' AND channel_account_id IS NOT NULL AND status = 'running'"))
  @@unique([organizationId, sourceType, channelAccountId, freshnessGeneration], map: "source_import_runs_wing_itemwinner_generation_key", where: raw("source_type = 'coupang_wing_itemwinner' AND channel_account_id IS NOT NULL AND freshness_generation IS NOT NULL"))
  @@unique([organizationId, sourceType], map: "source_import_runs_sellpia_profitability_running_key", where: raw("source_type = 'sellpia_product_profitability' AND status = 'running'"))
  @@unique([organizationId, sourceType], map: "source_import_runs_sellpia_sales_running_key", where: raw("source_type = 'sellpia_sales_daily' AND status = 'running'"))
  @@unique([organizationId, sourceType], map: "source_import_runs_coupang_ad_profitability_running_key", where: raw("source_type = 'coupang_ad_profitability' AND status = 'running'"))
  @@unique([organizationId, sourceType, publicationSequence], map: "source_import_runs_org_source_publication_key", where: raw("publication_sequence IS NOT NULL"))
  @@unique([organizationId, sourceType], map: "source_import_runs_shipment_summary_running_key", where: raw("source_type = 'coupang_shipment_summary' AND status = 'running'"))
  @@unique([organizationId, sourceType], map: "source_import_runs_coupang_reviews_running_key", where: raw("source_type = 'coupang_reviews' AND status = 'running'"))
  @@unique([organizationId, sourceType, channelAccountId], map: "source_import_runs_rocket_po_running_key", where: raw("source_type = 'coupang_rocket_po_catalog' AND status = 'running'"))
  @@unique([organizationId, sourceType, channelAccountId, freshnessGeneration], map: "source_import_runs_rocket_po_generation_key", where: raw("source_type = 'coupang_rocket_po_catalog' AND freshness_generation IS NOT NULL"))
  @@unique([organizationId, sourceType, freshnessGeneration], map: "source_import_runs_shipment_summary_generation_key", where: raw("source_type = 'coupang_shipment_summary' AND freshness_generation IS NOT NULL"))
  @@unique([id, organizationId], map: "source_import_runs_id_org_key")
  @@index([organizationId, sourceType, status, createdAt])
  @@index([organizationId, sourceType, idempotencyKey])
  @@index([organizationId, sourceType, status, coverageEndDate])
  @@index([channelAccountId])
  @@index([manualFreshExportConfirmedBy])
  @@map("source_import_runs")
}

