// orders.prisma — Orders domain

/// @namespace Orders
/// @describe Retained collection input evidence; converted downloads are not persisted and lifecycle belongs to SourceImportRun.
model OrderCollectionArtifact {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  /** 옛 attempt 경로의 run(H3′·KID-365까지). 실행 계약 kind가 보관한 캡처는 `operationId`만 갖는다. */
  sourceImportRunId String?  @map("source_import_run_id") @db.Uuid
  /** 실행 계약(ADR-0025) 실행 id — 스칼라, FK 없음. 청크는 finish에서 지워지므로 보관할 캡처는 여기 남는다(KID-359 wave2). */
  operationId       String?  @map("operation_id") @db.Uuid
  sourceFileName    String?  @map("source_file_name") @db.VarChar(240)
  sourceContentType String   @map("source_content_type") @db.VarChar(120)
  sourceBytes       Bytes    @map("source_bytes")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation(fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([sourceImportRunId, organizationId])
  @@unique([operationId, organizationId])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("order_collection_artifacts")
}

/// @namespace Orders
/// @describe Immutable transport effect receipt for one normalized Coupang direct-order payload. It owns downstream publication identity, not source collection state.
model CoupangDirectTransportReceipt {
  id                           String   @id @default(uuid()) @db.Uuid
  organizationId               String   @map("organization_id") @db.Uuid
  channelAccountId             String   @map("channel_account_id") @db.Uuid
  /** 옛 attempt run(N까지). 실행 계약 kind `orders.coupang_directship`의 변환이 만든 영수증은 `effectOperationId`만 갖는다. */
  effectSourceImportRunId      String?  @map("effect_source_import_run_id") @db.Uuid
  /** 이 영수증의 효과(주문·워크북 대조)를 처음 만든 directship 실행(스칼라, 관계 없음 — ADR-0025). */
  effectOperationId            String?  @map("effect_operation_id") @db.Uuid
  rocketPurchaseConfirmationId String?  @map("rocket_purchase_confirmation_id") @db.Uuid
  transport                    String   @db.VarChar(20)
  payloadChecksum              String   @map("payload_checksum") @db.VarChar(64)
  transmissionIntentKey        String?  @map("transmission_intent_key") @db.VarChar(500)
  matchedLineCount             Int      @default(0) @map("matched_line_count")
  reconciledRows               Int      @default(0) @map("reconciled_rows")
  collectedLines               Json     @map("collected_lines") @db.JsonB
  matchedLines                 Json     @map("matched_lines") @db.JsonB
  unmatchedLines               Json     @map("unmatched_lines") @db.JsonB
  createdAt                    DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization               Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  effectSourceImportRun      SourceImportRun?                    @relation("CoupangDirectTransportReceiptEffectSource", fields: [effectSourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  rocketPurchaseConfirmation RocketPurchaseConfirmation?         @relation(fields: [rocketPurchaseConfirmationId, organizationId], references: [id, organizationId], onDelete: Restrict)
  consumptions               CoupangDirectTransportConsumption[]

  @@unique([id, organizationId, transport], map: "coupang_direct_transport_receipts_id_org_transport_key")
  @@unique([organizationId, channelAccountId, transport, payloadChecksum], map: "coupang_direct_transport_receipts_dedupe_key")
  @@unique([organizationId, transmissionIntentKey], map: "coupang_direct_transport_receipts_org_intent_key", where: raw("transmission_intent_key IS NOT NULL"))
  @@index([channelAccountId, organizationId])
  @@index([effectSourceImportRunId, organizationId])
  @@index([organizationId, effectOperationId])
  @@index([rocketPurchaseConfirmationId, organizationId])
  @@map("coupang_direct_transport_receipts")
}

/// @namespace Orders
/// @describe Immutable alias from one completed source attempt and transport selection to its canonical downstream effect receipt.
model CoupangDirectTransportConsumption {
  id                        String   @id @default(uuid()) @db.Uuid
  organizationId            String   @map("organization_id") @db.Uuid
  /** 옛 attempt run(N까지). 실행이 변환한 소비는 `operationId`만 갖는다(KID-359). */
  sourceImportRunId         String?  @map("source_import_run_id") @db.Uuid
  /** 이 운송유형을 변환한 directship 실행(스칼라, 관계 없음 — ADR-0025). */
  operationId               String?  @map("operation_id") @db.Uuid
  receiptId                 String   @map("receipt_id") @db.Uuid
  transport                 String   @db.VarChar(20)
  selectedPurchaseOrderKeys String[] @default([]) @map("selected_purchase_order_keys")
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization    Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun?              @relation("CoupangDirectTransportConsumptionSource", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  receipt         CoupangDirectTransportReceipt @relation(fields: [receiptId, organizationId, transport], references: [id, organizationId, transport], onDelete: Restrict)

  @@unique([organizationId, sourceImportRunId, transport], map: "coupang_direct_transport_consumptions_source_transport_key")
  @@unique([organizationId, operationId, transport], map: "coupang_direct_transport_consumptions_operation_transport_key")
  @@index([sourceImportRunId, organizationId])
  @@index([receiptId, organizationId, transport])
  @@map("coupang_direct_transport_consumptions")
}

/// @namespace Orders
/// @describe Organization-scoped idempotency fence for browser Sellpia order transmission. It does not represent or mutate inventory freshness.
model SellpiaOrderTransmissionIntent {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  intentKey      String    @map("intent_key") @db.VarChar(500)
  status         String    @default("prepared")
  createdBy      String    @map("created_by") @db.Uuid
  preparedAt     DateTime  @default(now()) @map("prepared_at") @db.Timestamptz
  finalizedAt    DateTime? @map("finalized_at") @db.Timestamptz
  abortedAt      DateTime? @map("aborted_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization                                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator         User                                           @relation("SellpiaOrderTransmissionIntentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  reconciliations SellpiaOrderTransmissionIntentReconciliation[]

  @@unique([organizationId, intentKey], map: "sellpia_order_transmission_intents_org_key")
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([createdBy])
  @@map("sellpia_order_transmission_intents")
}

/// @namespace Orders
/// @describe Append-only owner/admin audit for resolving an ambiguous Sellpia order transmission outcome.
model SellpiaOrderTransmissionIntentReconciliation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  intentId       String   @map("intent_id") @db.Uuid
  reconciledBy   String   @map("reconciled_by") @db.Uuid
  reconciledAt   DateTime @default(now()) @map("reconciled_at") @db.Timestamptz
  note           String   @db.VarChar(500)
  outcome        String   @db.VarChar(32)

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intent       SellpiaOrderTransmissionIntent @relation(fields: [intentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reconciler   User                           @relation("SellpiaOrderTransmissionIntentReconciler", fields: [reconciledBy], references: [id], onDelete: Restrict)

  @@index([organizationId, reconciledAt])
  @@index([intentId])
  @@index([reconciledBy])
  @@map("sellpia_order_transmission_intent_reconciliations")
}

/// @namespace Orders
/// @describe 채널-agnostic 주문 aggregate. Coupang 등 채널별 raw payload 는 metadata Json. 라인 아이템은 OrderLineItem.
model Order {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  channelAccountId  String  @map("channel_account_id") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid
  /** 이 주문을 마지막으로 쓴 directship 실행(스칼라, 관계 없음 — ADR-0025, KID-359). 옛 run·다른 경로 주문은 null. */
  operationId       String? @map("operation_id") @db.Uuid

  externalOrderId String  @map("external_order_id") @db.VarChar(60)
  externalNumber  String? @map("external_number") @db.VarChar(60)

  customerName  String  @default("") @map("customer_name")
  receiverName  String? @map("receiver_name")
  receiverPhone String? @map("receiver_phone")
  receiverAddr  String? @map("receiver_addr")
  memo          String?

  status      String    @default("pending")
  orderedAt   DateTime  @default(now()) @map("ordered_at") @db.Timestamptz
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz

  trackingNumber  String? @map("tracking_number")
  shippingCompany String? @map("shipping_company")
  shippingPrice   Int     @default(0) @map("shipping_price")

  totalPrice Int @default(0) @map("total_price")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation(fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lineItems       OrderLineItem[]

  @@index([organizationId, operationId])
  @@unique([id, organizationId])
  @@unique([organizationId, channelAccountId, externalOrderId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, orderedAt])
  @@index([channelAccountId])
  @@index([sourceImportRunId])
  @@map("orders")
}

/// @namespace Orders
/// @describe 주문 라인 아이템 — 1 SKU 단위. listingOption → option 으로 SKU 해상도. order FK 는 organizationId 를 함께 참조해 cross-organization mismatch 를 DB 가 차단한다.
model OrderLineItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid

  listingOptionId String? @map("listing_option_id") @db.Uuid

  productName String  @default("") @map("product_name")
  optionName  String? @map("option_name")
  sku         String?

  quantity   Int @default(1)
  unitPrice  Int @default(0) @map("unit_price")
  totalPrice Int @default(0) @map("total_price")

  status String @default("pending")

  externalLineId  String? @map("external_line_id") @db.VarChar(60)
  externalBarcode String? @map("external_barcode") @db.VarChar(80)

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order        @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([id, organizationId])
  @@unique([orderId, externalLineId])
  @@index([organizationId])
  @@index([orderId])
  @@index([listingOptionId])
  @@map("order_line_items")
}

/// @namespace Orders
/// @describe 월별 정산 (예상 vs 실제 비교).
model Settlement {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  period         String
  expectedAmount Int       @default(0) @map("expected_amount")
  actualAmount   Int       @default(0) @map("actual_amount")
  commission     Int       @default(0)
  shippingFee    Int       @default(0) @map("shipping_fee")
  adjustments    Int       @default(0)
  difference     Int       @default(0)
  orderCount     Int       @default(0) @map("order_count")
  returnCount    Int       @default(0) @map("return_count")
  status         String    @default("pending")
  settledAt      DateTime? @map("settled_at") @db.Timestamptz
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
  @@index([organizationId])
  @@map("settlements")
}

/// @namespace Orders
/// @describe 채널 상품평 원본 1건. 쿠팡은 Wing 상품평 화면(`/tenants/cs/product/review`)을
/// 확장이 크롤링해 적재하며 `externalReviewId` 로 재수집 멱등성을 보장한다.
/// `listingId` 는 `externalOptionId`(쿠팡 vendorItemId) → `ChannelListingOption` 매칭 결과이며
/// 매칭 실패 시 null(미연결 리뷰)로 남는다.
model Review {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  sourceImportRunId String?   @map("source_import_run_id") @db.Uuid
  /// 이 행을 마지막으로 쓴 실행(operations.id, 스칼라·FK 없음, ADR-0025). 옛 sourceImportRunId 행은 KID-365까지 함께 읽힌다.
  operationId       String?   @map("operation_id") @db.Uuid
  /// 실행이 이 행을 마지막으로 발행한 시각(옛 publication_sequence 대체). 리뷰당 실행 행은 하나이고, 옛 run 행보다 항상 앞선다.
  publishedAt       DateTime? @map("published_at") @db.Timestamptz
  listingId         String?   @map("listing_id") @db.Uuid

  platform     String  @default("coupang")
  rating       Int
  title        String?
  content      String?
  reviewerName String? @map("reviewer_name")

  /// 채널 원본 리뷰 식별자(쿠팡 reviewId). 재수집 중복 방지 키.
  externalReviewId  String? @map("external_review_id")
  /// 리뷰 대상 채널 옵션 식별자(쿠팡 vendorItemId = 옵션ID). listing 매칭 키.
  externalOptionId  String? @map("external_option_id")
  /// 채널 노출 상품 식별자(쿠팡 productId = 노출상품ID).
  externalProductId String? @map("external_product_id")
  /// 수집 시점 채널 노출 상품명. listing 미매칭 리뷰의 표시 폴백.
  itemName          String? @map("item_name")

  imageCount Int @default(0) @map("image_count")
  videoCount Int @default(0) @map("video_count")

  /// 채널에서 삭제/블라인드 처리된 리뷰. 집계에서 제외한다.
  isDeleted Boolean @default(false) @map("is_deleted")
  isBlinded Boolean @default(false) @map("is_blinded")

  reviewedAt DateTime @default(now()) @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation("ReviewCollectionFacts", fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Cascade)

  /// 실행 행은 (조직, 플랫폼, 리뷰)당 하나다 — 실행 finalize가 내용·operationId·publishedAt을 갱신한다(KID-359).
  @@unique([organizationId, platform, externalReviewId], map: "reviews_org_platform_external_operation_key", where: raw("operation_id IS NOT NULL"))
  @@unique([organizationId, sourceImportRunId, platform, externalReviewId], map: "reviews_org_source_run_external_key", where: raw("source_import_run_id IS NOT NULL"))
  @@index([organizationId, operationId])
  @@index([organizationId])
  @@index([organizationId, sourceImportRunId])
  @@index([listingId])
  @@index([organizationId, reviewedAt])
  @@index([organizationId, externalOptionId])
  @@map("reviews")
}

/// @namespace Orders
/// @describe Persisted Coupang shipment 발송일별 건수/박스 요약 snapshot so the calendar survives reload and only new dates are collected.
model CoupangShipmentDateSummary {
  id                String   @id @default(uuid()) @db.Uuid
  organizationId    String   @map("organization_id") @db.Uuid
  /** 옛 attempt 경로의 run(N까지). 실행 계약 kind `orders.coupang_shipment_summary`가 쓴 행은 `operationId`만 갖는다(KID-359). */
  sourceImportRunId String?  @map("source_import_run_id") @db.Uuid
  /** 이 발송일을 센 실행(스칼라, 관계 없음 — ADR-0025). 옛 run 행·기준 행은 null. */
  operationId       String?  @map("operation_id") @db.Uuid
  shipmentDate      String   @map("shipment_date")
  count             Int      @default(0)
  boxes             Int      @default(0)
  capturedAt        DateTime @default(now()) @map("captured_at") @db.Timestamptz
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sourceImportRun SourceImportRun? @relation(fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, sourceImportRunId, shipmentDate], map: "shipment_date_summary_attempt_date_key", where: raw("source_import_run_id IS NOT NULL"))
  @@unique([organizationId, operationId, shipmentDate], map: "shipment_date_summary_operation_date_key", where: raw("operation_id IS NOT NULL"))
  @@unique([organizationId, shipmentDate], map: "shipment_date_summary_baseline_date_key", where: raw("source_import_run_id IS NULL AND operation_id IS NULL"))
  @@index([sourceImportRunId, organizationId])
  @@index([organizationId, operationId])
  @@index([organizationId])
  @@map("coupang_shipment_date_summaries")
}

/// @namespace Orders
/// @describe RocketPoCatalogSnapshot canonical state owned by orders.
/// @namespace Channels
/// @describe Completed Coupang Rocket PO collection evidence that can be reopened without another provider collection. Inventory capacity is never stored here.
model RocketPoCatalogSnapshot {
  id                String @id @default(uuid()) @db.Uuid
  organizationId    String @map("organization_id") @db.Uuid
  channelAccountId  String @map("channel_account_id") @db.Uuid
  /** 옛 attempt 경로의 run(N까지). 실행 계약 kind `orders.coupang_rocket_po`가 쓴 스냅샷은 `operationId`만 갖는다(KID-359). */
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid
  /** 이 스냅샷을 발행한 실행(스칼라, 관계 없음 — ADR-0025). 옛 run 스냅샷은 null. */
  operationId       String? @map("operation_id") @db.Uuid
  /** 수집 증거의 식별자. 실행이 쓴 스냅샷은 `operationId`와 같다. */
  collectionRunId   String  @map("collection_run_id") @db.Uuid

  vendorId       String @map("vendor_id")
  listPagesRead  Int    @map("list_pages_read")
  totalListPages Int    @map("total_list_pages")
  detailPoCount  Int    @map("detail_po_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  lines RocketPoCatalogLine[]

  sourceImportRun SourceImportRun?      @relation(fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([id, organizationId], map: "rocket_po_catalog_snapshots_id_org_key")
  @@unique([sourceImportRunId, organizationId], map: "rocket_po_catalog_snapshots_run_org_key")
  @@unique([organizationId, operationId], map: "rocket_po_catalog_snapshots_org_operation_key")
  @@unique([organizationId, channelAccountId, collectionRunId], map: "rocket_po_catalog_snapshots_org_account_collection_key")
  @@index([organizationId, channelAccountId, createdAt])
  @@index([channelAccountId])
  @@index([sourceImportRunId])
  @@map("rocket_po_catalog_snapshots")
}

/// @namespace Orders
/// @describe RocketPoCatalogLine canonical state owned by orders.
/// @namespace Channels
/// @describe Normalized Rocket PO line and confirmation-workbook evidence owned by one completed catalog snapshot.
model RocketPoCatalogLine {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  snapshotId     String @map("snapshot_id") @db.Uuid

  poLineId            String   @map("po_line_id")
  poNumber            String   @map("po_number")
  vendorId            String   @map("vendor_id")
  productNo           String   @map("product_no")
  barcode             String
  productName         String   @map("product_name")
  orderQty            Int      @map("order_qty")
  plannedDeliveryDate DateTime @map("planned_delivery_date") @db.Date
  poStatusCode        String?  @map("po_status_code")
  businessDateBasis   String?  @map("business_date_basis")
  center              String?
  inboundType         String?  @map("inbound_type")
  poStatus            String?  @map("po_status")
  returnManager       String?  @map("return_manager")
  returnContact       String?  @map("return_contact")
  returnAddress       String?  @map("return_address")
  purchasePrice       Int?     @map("purchase_price")
  supplyPrice         Int?     @map("supply_price")
  vat                 Int?
  totalPurchase       Int?     @map("total_purchase")
  poRegisteredAt      String?  @map("po_registered_at")
  xdock               String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  snapshot RocketPoCatalogSnapshot @relation(fields: [snapshotId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([snapshotId, poLineId], map: "rocket_po_catalog_lines_snapshot_line_key")
  @@index([snapshotId])
  @@index([organizationId, plannedDeliveryDate])
  @@index([organizationId, poNumber])
  @@map("rocket_po_catalog_lines")
}
