// orders.prisma — Orders domain

/// @namespace Orders
/// @describe Organization-scoped idempotency fence for browser Sellpia order transmission. It does not represent or mutate inventory freshness.
model SellpiaOrderTransmissionIntent {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  intentKey           String    @map("intent_key") @db.VarChar(500)
  status              String    @default("prepared")
  createdBy           String    @map("created_by") @db.Uuid
  preparedAt          DateTime  @default(now()) @map("prepared_at") @db.Timestamptz
  finalizedAt         DateTime? @map("finalized_at") @db.Timestamptz
  abortedAt           DateTime? @map("aborted_at") @db.Timestamptz
  finalizedGeneration BigInt?   @map("finalized_generation") @db.BigInt
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization                                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator         User                                           @relation("SellpiaOrderTransmissionIntentCreator", fields: [createdBy], references: [id], onDelete: Restrict)
  reconciliations SellpiaOrderTransmissionIntentReconciliation[]

  @@unique([organizationId, intentKey], map: "sellpia_order_transmission_intents_org_key")
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([createdBy])
  @@map("sellpia_order_transmission_intents")
}

/// @namespace Orders
/// @describe Append-only owner/admin audit for resolving an ambiguous Sellpia order transmission outcome.
model SellpiaOrderTransmissionIntentReconciliation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  intentId       String   @map("intent_id") @db.Uuid
  reconciledBy   String   @map("reconciled_by") @db.Uuid
  reconciledAt   DateTime @default(now()) @map("reconciled_at") @db.Timestamptz
  note           String   @db.VarChar(500)
  outcome        String   @db.VarChar(32)

  organization Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intent       SellpiaOrderTransmissionIntent @relation(fields: [intentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  reconciler   User                           @relation("SellpiaOrderTransmissionIntentReconciler", fields: [reconciledBy], references: [id], onDelete: Restrict)

  @@index([organizationId, reconciledAt])
  @@index([intentId])
  @@index([reconciledBy])
  @@map("sellpia_order_transmission_intent_reconciliations")
}

/// @namespace Orders
/// @describe 채널-agnostic 주문 aggregate. Coupang 등 채널별 raw payload 는 metadata Json. 라인 아이템은 OrderLineItem.
model Order {
  id                String  @id @default(uuid()) @db.Uuid
  organizationId    String  @map("organization_id") @db.Uuid
  channelAccountId  String  @map("channel_account_id") @db.Uuid
  sourceImportRunId String? @map("source_import_run_id") @db.Uuid

  externalOrderId String  @map("external_order_id") @db.VarChar(60)
  externalNumber  String? @map("external_number") @db.VarChar(60)

  customerName  String  @default("") @map("customer_name")
  receiverName  String? @map("receiver_name")
  receiverPhone String? @map("receiver_phone")
  receiverAddr  String? @map("receiver_addr")
  memo          String?

  status      String    @default("pending")
  orderedAt   DateTime  @default(now()) @map("ordered_at") @db.Timestamptz
  paidAt      DateTime? @map("paid_at") @db.Timestamptz
  shippedAt   DateTime? @map("shipped_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz

  trackingNumber  String? @map("tracking_number")
  shippingCompany String? @map("shipping_company")
  shippingPrice   Int     @default(0) @map("shipping_price")

  totalPrice Int @default(0) @map("total_price")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelAccount  ChannelAccount   @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  sourceImportRun SourceImportRun? @relation(fields: [sourceImportRunId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lineItems       OrderLineItem[]
  shipments       Shipment[]
  returns         OrderReturn[]
  unshippedItems  UnshippedItem[]
  csRecords       CSRecord[]

  @@unique([id, organizationId])
  @@unique([organizationId, channelAccountId, externalOrderId])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, orderedAt])
  @@index([channelAccountId])
  @@index([sourceImportRunId])
  @@map("orders")
}

/// @namespace Orders
/// @describe 주문 라인 아이템 — 1 SKU 단위. listingOption → option 으로 SKU 해상도. order FK 는 organizationId 를 함께 참조해 cross-organization mismatch 를 DB 가 차단한다.
model OrderLineItem {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  orderId        String @map("order_id") @db.Uuid

  listingOptionId String? @map("listing_option_id") @db.Uuid

  productName String  @default("") @map("product_name")
  optionName  String? @map("option_name")
  sku         String?

  quantity   Int @default(1)
  unitPrice  Int @default(0) @map("unit_price")
  totalPrice Int @default(0) @map("total_price")

  status String @default("pending")

  externalLineId  String? @map("external_line_id") @db.VarChar(60)
  externalBarcode String? @map("external_barcode") @db.VarChar(80)

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order           Order                 @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  listingOption   ChannelListingOption? @relation(fields: [listingOptionId, organizationId], references: [id, organizationId], onDelete: Restrict)
  returnLineItems OrderReturnLineItem[]
  shipmentItems   ShipmentItem[]
  unshippedItems  UnshippedItem[]

  @@unique([id, organizationId])
  @@unique([orderId, externalLineId])
  @@index([organizationId])
  @@index([orderId])
  @@index([listingOptionId])
  @@map("order_line_items")
}

/// @namespace Orders
/// @describe 채널-agnostic 반품 aggregate. 반품 item 은 OrderReturnLineItem 으로 정규화. type=RETURN/EXCHANGE 구분 first-class.
model OrderReturn {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  orderId          String? @map("order_id") @db.Uuid
  channelAccountId String  @map("channel_account_id") @db.Uuid

  externalReturnId String @map("external_return_id") @db.VarChar(60)

  type String @default("RETURN") @db.VarChar(20)

  status          String  @default("pending")
  reason          String  @default("")
  reasonCategory1 String? @map("reason_category1")
  reasonCategory2 String? @map("reason_category2")
  faultBy         String  @default("CUSTOMER") @map("fault_by") @db.VarChar(20)

  requesterName String @default("") @map("requester_name")
  enclosePrice  Int?   @map("enclose_price")

  requestedAt DateTime  @map("requested_at") @db.Timestamptz
  completedAt DateTime? @map("completed_at") @db.Timestamptz

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelAccount ChannelAccount        @relation(fields: [channelAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  order          Order?                @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lineItems      OrderReturnLineItem[]

  @@unique([id, organizationId])
  @@unique([organizationId, channelAccountId, externalReturnId])
  @@index([organizationId])
  @@index([orderId])
  @@index([status])
  @@index([type])
  @@index([requestedAt])
  @@index([channelAccountId])
  @@map("order_returns")
}

/// @namespace Orders
/// @describe 반품 라인 아이템 — 반품 건 내 SKU 단위 상세. return FK 는 organizationId 를 함께 참조해 cross-organization mismatch 를 DB 가 차단한다.
model OrderReturnLineItem {
  id              String  @id @default(uuid()) @db.Uuid
  organizationId  String  @map("organization_id") @db.Uuid
  returnId        String  @map("return_id") @db.Uuid
  orderLineItemId String? @map("order_line_item_id") @db.Uuid
  listingOptionId String? @map("listing_option_id") @db.Uuid

  productName String  @default("") @map("product_name")
  optionName  String? @map("option_name")
  externalSku String? @map("external_sku")
  quantity    Int

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  return        OrderReturn           @relation(fields: [returnId, organizationId], references: [id, organizationId], onDelete: Cascade)
  orderLineItem OrderLineItem?        @relation(fields: [orderLineItemId, organizationId], references: [id, organizationId], onDelete: Restrict)
  listingOption ChannelListingOption? @relation(fields: [listingOptionId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId])
  @@index([returnId])
  @@index([orderLineItemId])
  @@index([listingOptionId])
  @@map("order_return_line_items")
}

/// @namespace Orders
model Shipment {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  orderId        String    @map("order_id") @db.Uuid
  trackingNo     String?   @map("tracking_no")
  courierCode    String?   @map("courier_code")
  courierName    String?   @map("courier_name")
  status         String    @default("ready")
  shippedAt      DateTime? @map("shipped_at") @db.Timestamptz
  deliveredAt    DateTime? @map("delivered_at") @db.Timestamptz
  deliveryDays   Int?      @map("delivery_days")
  warehouseId    String?   @map("warehouse_id") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order          @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  warehouse    Warehouse?     @relation(fields: [warehouseId, organizationId], references: [id, organizationId], onDelete: Restrict)
  items        ShipmentItem[]

  @@unique([id, organizationId], map: "shipments_id_org_key")
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([orderId])
  @@index([warehouseId])
  @@map("shipments")
}

/// @namespace Orders
/// @describe Order-line shipment detail.
model ShipmentItem {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  shipmentId      String   @map("shipment_id") @db.Uuid
  orderLineItemId String   @map("order_line_item_id") @db.Uuid
  quantity        Int
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment      Shipment      @relation(fields: [shipmentId, organizationId], references: [id, organizationId], onDelete: Cascade)
  orderLineItem OrderLineItem @relation(fields: [orderLineItemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([shipmentId, orderLineItemId])
  @@index([organizationId])
  @@index([shipmentId])
  @@index([orderLineItemId])
  @@map("shipment_items")
}

/// @namespace Orders
model UnshippedItem {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  orderId         String    @map("order_id") @db.Uuid
  orderLineItemId String    @map("order_line_item_id") @db.Uuid
  productName     String    @map("product_name")
  optionName      String?   @map("option_name")
  externalSku     String?   @map("external_sku")
  quantity        Int
  orderDate       DateTime  @map("order_date") @db.Timestamptz
  delayDays       Int       @default(0) @map("delay_days")
  reason          String?
  isNotified      Boolean   @default(false) @map("is_notified")
  notifiedAt      DateTime? @map("notified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order         Order         @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Cascade)
  orderLineItem OrderLineItem @relation(fields: [orderLineItemId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([organizationId])
  @@index([orderId])
  @@index([delayDays])
  @@index([isNotified])
  @@index([orderLineItemId])
  @@map("unshipped_items")
}

/// @namespace Orders
/// @describe 월별 정산 (예상 vs 실제 비교).
model Settlement {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  period         String
  expectedAmount Int       @default(0) @map("expected_amount")
  actualAmount   Int       @default(0) @map("actual_amount")
  commission     Int       @default(0)
  shippingFee    Int       @default(0) @map("shipping_fee")
  adjustments    Int       @default(0)
  difference     Int       @default(0)
  orderCount     Int       @default(0) @map("order_count")
  returnCount    Int       @default(0) @map("return_count")
  status         String    @default("pending")
  settledAt      DateTime? @map("settled_at") @db.Timestamptz
  notes          String?
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, period])
  @@index([organizationId])
  @@map("settlements")
}

/// @namespace Orders
model CSRecord {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  orderId        String?  @map("order_id") @db.Uuid
  listingId      String?  @map("listing_id") @db.Uuid
  csType         String   @map("cs_type")
  csStatus       String   @default("접수") @map("cs_status")
  priority       String   @default("normal")
  assignee       String?
  content        String
  resolution     String?
  createdBy      String?  @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  order        Order?          @relation(fields: [orderId, organizationId], references: [id, organizationId], onDelete: Restrict)
  listing      ChannelListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, csStatus, createdAt])
  @@index([orderId])
  @@index([listingId])
  @@index([csType])
  @@index([csStatus])
  @@index([createdAt])
  @@map("cs_records")
}

/// @namespace Orders
/// @describe 채널 상품평 원본 1건. 쿠팡은 Wing 상품평 화면(`/tenants/cs/product/review`)을
/// 확장이 크롤링해 적재하며 `externalReviewId` 로 재수집 멱등성을 보장한다.
/// `listingId` 는 `externalOptionId`(쿠팡 vendorItemId) → `ChannelListingOption` 매칭 결과이며
/// 매칭 실패 시 null(미연결 리뷰)로 남는다.
model Review {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  listingId      String? @map("listing_id") @db.Uuid

  platform     String  @default("coupang")
  rating       Int
  title        String?
  content      String?
  reviewerName String? @map("reviewer_name")

  /// 채널 원본 리뷰 식별자(쿠팡 reviewId). 재수집 중복 방지 키.
  externalReviewId String? @map("external_review_id")
  /// 리뷰 대상 채널 옵션 식별자(쿠팡 vendorItemId = 옵션ID). listing 매칭 키.
  externalOptionId String? @map("external_option_id")
  /// 채널 노출 상품 식별자(쿠팡 productId = 노출상품ID).
  externalProductId String? @map("external_product_id")
  /// 수집 시점 채널 노출 상품명. listing 미매칭 리뷰의 표시 폴백.
  itemName String? @map("item_name")

  imageCount Int @default(0) @map("image_count")
  videoCount Int @default(0) @map("video_count")

  /// 채널에서 삭제/블라인드 처리된 리뷰. 집계에서 제외한다.
  isDeleted Boolean @default(false) @map("is_deleted")
  isBlinded Boolean @default(false) @map("is_blinded")

  reviewedAt DateTime @default(now()) @map("reviewed_at") @db.Timestamptz
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  listing      ChannelListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)

  @@unique([organizationId, platform, externalReviewId], map: "reviews_org_platform_external_key")
  @@index([organizationId])
  @@index([listingId])
  @@index([organizationId, reviewedAt])
  @@index([organizationId, externalOptionId])
  @@map("reviews")
}

/// @namespace Orders
/// @describe 쿠팡직배송 발주확정 스냅샷. 입고예정일 달력이 매번 쿠팡을 다시 긁지 않도록
/// 마지막 수집분을 보관한다. 조회 편의용 캐시이며 주문 진실은 Order/OrderLineItem 이 갖는다.
model CoupangDirectPoSnapshot {
  id               String @id @default(uuid()) @db.Uuid
  organizationId   String @map("organization_id") @db.Uuid
  channelAccountId String @map("channel_account_id") @db.Uuid

  /// 쿠팡 발주번호(purchaseOrderSeq)
  purchaseOrderSeq String @map("purchase_order_seq") @db.VarChar(40)

  centerName String  @map("center_name")
  /// SHIPMENT | MILKRUN
  transport  String
  /// 입고예정일(KST, YYYY-MM-DD). 달력의 그룹 키다.
  deliveryDate String? @map("delivery_date") @db.VarChar(10)
  /// 발주일(KST, YYYY-MM-DD)
  orderedDate  String? @map("ordered_date") @db.VarChar(10)
  /// 발주유형이 긴급(purchaseOrderType = URGENT)인지
  isUrgent   Boolean @default(false) @map("is_urgent")

  skuCount      Int @default(0) @map("sku_count")
  orderQuantity Int @default(0) @map("order_quantity")
  orderAmount   Int @default(0) @map("order_amount")

  /// 품목 원본(바코드·상품명·수량·금액). 엑셀 생성은 수집 시 새로 받은 값을 쓴다.
  itemsJson Json? @map("items_json")

  collectedAt DateTime @default(now()) @map("collected_at") @db.Timestamptz
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @default(now()) @updatedAt @db.Timestamptz @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, channelAccountId, purchaseOrderSeq], map: "coupang_direct_po_snapshots_org_account_seq_key")
  @@index([organizationId])
  @@index([organizationId, channelAccountId, deliveryDate])
  @@map("coupang_direct_po_snapshots")
}
