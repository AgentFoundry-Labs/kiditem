# Copy to C:/ProgramData/KidItem/.env.office and replace every placeholder.
# Never commit the populated file.
POSTGRES_PASSWORD=replace-me
OFFICE_ORIGIN=http://kiditem-office
OFFICE_HOST=kiditem-office
# Host Chrome is managed outside Compose. Compose injects this endpoint into the
# API/worker, which reach the host through OFFICE_HOST.
SOURCING_PLAYWRIGHT_CDP_ENDPOINT=http://kiditem-office:9444
S3_ENDPOINT=http://minio:9000
S3_PUBLIC_URL=http://kiditem-office:9000/kiditem
MINIO_ROOT_USER=replace-me
MINIO_ROOT_PASSWORD=replace-me
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=replace-me
# Immutable release identity is written to .env.office.deploy by the deploy
# script. The Host Runner bearer is a file path, never an environment token.
# The dedicated Windows Task Scheduler account credential is deliberately not
# an env value: deployment receives an in-memory PSCredential instead.
KIDITEM_AGENT_RUNNER_TOKEN_FILE=C:/ProgramData/KidItem/secrets/agent-runner-token
AGENT_CLI_MAX_CONCURRENCY=4
AGENT_OPERATOR_MODEL=replace-me
AGENT_SOURCING_MODEL=replace-me
AGENT_MERCHANDISING_MODEL=replace-me
AGENT_SUPPLY_MODEL=replace-me
AGENT_CHANNEL_OPERATIONS_MODEL=replace-me
AGENT_ADVERTISING_MODEL=replace-me
OFFICE_API_ENV_FILE=C:/workspace/kiditem/apps/server/.env
