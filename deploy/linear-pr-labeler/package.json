{
  "name": "linear-pr-labeler",
  "version": "0.1.0",
  "private": true,
  "description": "Linear webhook → Cloudflare Worker that applies the kiditem PR label to the Linear issues a pull request completes",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "types": "wrangler types",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "build": "wrangler deploy --dry-run --outdir dist",
    "test": "vitest run",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "wrangler": "4.133.0"
  }
}
