{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@kiditem/shared/*": [
        "../packages/shared/src/*"
      ]
    },
    "lib": [
      "ES2022",
      "WebWorker"
    ],
    "types": [
      "chrome"
    ],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
