# KidItem environment variables (root level).
# Consumed by root-level tooling: Prisma CLI, dev bootstrap, and dev data sync.
# App runtimes use app-local files:
# - apps/server/.env.example
# - apps/web/.env.example
# - agents/.env.example
# Do not place app runtime AI/provider/marketplace secrets here; keep NestJS
# values in apps/server/.env and Python agent values in agents/.env.

# DATABASE_URL — Prisma CLI and root scripts main connection.
DATABASE_URL=postgresql://user:password@localhost:5432/kiditem

# Supabase tooling only — storage/rebuild helpers that have not yet moved to
# Office MinIO may use these values. Application authentication does not.
SUPABASE_URL=
# Server-only administrative key. Never expose it to the web app or git.
SUPABASE_SECRET_KEY=

# Shared dev data — Google Drive Desktop local sync path and target org scope.
# Fresh local DBs may use 00000000-0000-4000-8000-000000000001 after
# docs/runbooks/import-drive-reference-data.md creates KidItem Dev.
KIDITEM_DEV_DATA_DRIVE_DIR=
KIDITEM_DEV_ORGANIZATION_ID=
# Optional API replay overrides for `npm run data:dev:*`.
KIDITEM_DEV_USER_ID=
KIDITEM_API_URL=http://localhost:4000
KIDITEM_DEV_DATA_CLOUD_STORAGE_ROOT=
# Optional fallback user id for dev-data replay when an explicit user id is not
# passed. Prefer KIDITEM_DEV_ORGANIZATION_ID for organization-scoped imports.
DEV_DEFAULT_USER_ID=

# Agent OS local seed helper. Empty means seed every active local organization.
# `npm run seed:agent-os` reads this root `.env` and requires an explicit Agent
# OS model. Fixed image/detail/thumbnail generation uses `AI_*` in
# `apps/server/.env`, not `AGENT_*`.
AGENT_DEFAULT_MODEL=gemini-2.5-flash
AGENT_SEED_ORG_IDS=

# Optional Coupang extension staging package helper.
STAGING_URL=
EXTENSION_OUTPUT_DIR=
