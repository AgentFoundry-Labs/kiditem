# KidItem environment variables (root level).
# Consumed by root-level tooling: Prisma CLI, dev bootstrap, and dev data sync.
# App runtimes use app-local files:
# - apps/server/.env.example
# - apps/web/.env.example
# - agents/.env.example
# Do not place app runtime AI/provider/marketplace secrets here; keep NestJS
# values in apps/server/.env and Python agent values in agents/.env.

# DATABASE_URL — Prisma CLI and root scripts main connection.
DATABASE_URL=postgresql://kiditem:kiditem@localhost:5433/kiditem

# Shared dev data — Google Drive Desktop local sync path and target org scope.
# Create the local user/organization first with `npm run dev:bootstrap-user`.
# Shared bundle setup is documented in docs/runbooks/google-drive-dev-data.md.
KIDITEM_DEV_DATA_DRIVE_DIR=
KIDITEM_DEV_ORGANIZATION_ID=
# Optional API replay overrides for `npm run data:dev:*`.
KIDITEM_DEV_USER_ID=
KIDITEM_API_URL=http://localhost:4000
KIDITEM_DEV_DATA_CLOUD_STORAGE_ROOT=
# Optional fallback user id for dev-data replay when an explicit user id is not
# passed. Prefer KIDITEM_DEV_ORGANIZATION_ID for organization-scoped imports.
DEV_DEFAULT_USER_ID=

# Optional extension release package output directory.
EXTENSION_OUTPUT_DIR=
