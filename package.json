{
  "name": "kiditem",
  "private": true,
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "setup:macos": "node scripts/setup-macos-development.mjs",
    "dev": "npm run dev --workspace=apps/web",
    "clean:web-cache": "node -e \"require('fs').rmSync('apps/web/.next/dev/cache',{recursive:true,force:true})\"",
    "dev:server": "npm run start:dev --workspace=apps/server",
    "dev:agents": "cd agents && .venv/bin/uvicorn src.server:app --host 0.0.0.0 --port 8001 --reload",
    "dev:core": "concurrently --kill-others-on-fail -n web,server -c blue,green \"npm run dev\" \"npm run dev:server\"",
    "dev:gateway": "npm run build --workspace=apps/agent-gateway && node scripts/local-agent-gateway.mjs start",
    "dev:all": "node scripts/run-local-development.mjs",
    "gateway:auth:codex": "node scripts/local-agent-gateway.mjs auth codex",
    "gateway:login:codex": "node scripts/local-agent-gateway.mjs login codex",
    "gateway:login:claude": "node scripts/local-agent-gateway.mjs login claude",
    "dev:bootstrap-user": "bash bin/bootstrap-local-auth-user.sh",
    "auth:password": "bash bin/set-local-auth-password.sh",
    "build": "npm run build --workspace=apps/web && npm run build --workspace=apps/server",
    "hooks:install": "git config core.hooksPath .githooks",
    "check:agents-hygiene": "node scripts/check-agents-hygiene.mjs",
    "check:agent-os-hexagonal": "node scripts/check-agent-os-hexagonal.mjs",
    "check:agent-os-contraction": "node scripts/check-agent-os-contraction.mjs",
    "check:operation-automation-cutover": "node scripts/check-operation-automation-cutover.mjs",
    "preflight:operation-automation-cutover": "node scripts/operation-automation-cutover-preflight.mjs",
    "check:identifier-contracts": "node scripts/check-identifier-contracts.mjs",
    "check:copilotkit-train": "node scripts/check-copilotkit-train.mjs",
    "skills:update": "bash skills/update-project-skills/scripts/update-local-skills.sh",
    "skills:verify": "bash skills/update-project-skills/scripts/update-local-skills.sh --verify-only",
    "check:pr-reconstruction": "node scripts/check-pr-reconstruction-contract.mjs",
    "check:pr-release-contract": "node scripts/check-pr-release-contract.mjs",
    "check:cutover-data-blockers": "node scripts/check-cutover-data-blockers.mjs",
    "check:cutover-blocker-coverage": "node scripts/check-cutover-blocker-coverage.mjs",
    "check:channel-registry-sync": "node scripts/generate-channel-registry.mjs --check",
    "check:scripts-inventory": "node scripts/check-script-inventory.mjs",
    "deploy:office:local": "node scripts/office-deploy.mjs deploy",
    "deploy:office:status": "node scripts/office-deploy.mjs status",
    "deploy:office:rollback": "node scripts/office-deploy.mjs rollback",
    "check:schema-artifact-sync": "node scripts/check-schema-artifact-sync.mjs",
    "check:directory-architecture": "node scripts/check-directory-architecture.mjs",
    "check:sourcing-long-running-actions": "node scripts/check-sourcing-long-running-actions.mjs",
    "check:web-db-boundary": "./scripts/check-frontend-db-boundary.sh",
    "check:idor": "./scripts/check-queryraw-tenancy.sh",
    "check:tenant-scope": "./scripts/check-tenant-scope.sh",
    "check:raw-snapshot-read-models": "bash scripts/check-raw-snapshot-read-models.sh",
    "check:ledger-readers": "node scripts/check-ledger-readers.mjs",
    "check:cross-owner-fk": "node scripts/check-cross-owner-fk.mjs",
    "check:business-date-arithmetic": "node scripts/check-business-date-arithmetic.mjs",
    "check:shared-interface-names": "node scripts/check-shared-interface-names.mjs",
    "check:shared-root-imports": "bash scripts/check-shared-root-imports.sh",
    "check:server-type-baseline": "node scripts/check-server-type-baseline.mjs",
    "check:conventions": "npm run check:agents-hygiene && npm run check:scripts-inventory && npm run check:identifier-contracts && npm run check:schema-artifact-sync && npm run check:directory-architecture && npm run check:hexagonal && npm run check:agent-os-contraction -- --enforce && npm run check:agent-os-hexagonal && npm run check:sourcing-long-running-actions && npm run check:web-db-boundary && npm run check:idor && npm run check:tenant-scope && npm run check:raw-snapshot-read-models && npm run check:business-date-arithmetic && npm run check:ledger-readers && npm run check:cross-owner-fk && npm run check:shared-interface-names && npm run check:shared-root-imports && npm run check:channel-registry-sync && npm run check:server-type-baseline",
    "knip:report": "knip --no-exit-code --no-progress --reporter compact",
    "test:scripts": "vitest run --config scripts/vitest.config.ts && node --test scripts/__tests__/*.test.mjs",
    "db:erd": "node scripts/generate-prisma-erd.mjs",
    "db:generate": "prisma generate",
    "db:push": "node scripts/safe-prisma-db-push.mjs",
    "db:sync:local": "tsx scripts/sync-local-database.ts",
    "db:studio": "prisma studio",
    "data:dev:status": "tsx scripts/dev-data.ts status",
    "data:dev:setup": "tsx scripts/dev-data.ts setup",
    "data:dev:pull": "tsx scripts/dev-data.ts pull",
    "data:dev:sync": "tsx scripts/dev-data.ts sync",
    "data:dev:export": "tsx scripts/dev-data.ts export",
    "data:dev:sanitize": "tsx scripts/dev-data.ts sanitize",
    "data:dev:replay": "tsx scripts/dev-data.ts replay",
    "data:dev:pack": "tsx scripts/dev-data.ts pack",
    "data:dev:publish": "tsx scripts/dev-data.ts publish",
    "data:migrate": "tsx scripts/run-data-migrations.ts",
    "extension:release": "node scripts/manage-extension-release.mjs",
    "inventory:bootstrap:dev": "tsx scripts/bootstrap-authoritative-inventory-dev.ts",
    "eval:agent-os": "node evals/agent-os/harness/run-eval.mjs",
    "test:agent-evals": "node --test evals/agent-os/tests/*.test.mjs",
    "qa:agent-os:clean-cutover": "node scripts/qa-agent-os-clean-cutover.mjs",
    "seed:agent-os:browser-qa": "tsx scripts/seed-agent-os-browser-qa.ts",
    "smoke:interaction-os": "node scripts/smoke-interaction-os.mjs",
    "seed:order-collection-malls": "tsx scripts/seed-order-collection-mall-accounts.ts",
    "test:integration": "npm run test:integration --workspace=apps/server --",
    "check:hexagonal": "node scripts/check-hexagonal.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1029.0",
    "@copilotkit/react-core": "1.69.0",
    "@copilotkit/runtime": "1.69.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@testcontainers/postgresql": "^12.0.4",
    "concurrently": "^9.2.1",
    "dotenv": "^16.6.1",
    "exceljs": "4.4.0",
    "knip": "^6.7.0",
    "playwriter": "^0.1.0",
    "prisma": "^7.9.1",
    "tsx": "^4.21.0",
    "vitest": "^4.1.2",
    "xlsx": "npm:@e965/xlsx@^0.20.3"
  },
  "overrides": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@xmorse/playwright-core": {
      "diff": "8.0.4"
    },
    "@ai-sdk/google-vertex": "3.0.158",
    "@google/genai": {
      "protobufjs": "7.6.5"
    },
    "@google/genai@1.52.0": {
      "protobufjs": "7.6.5"
    },
    "@hono/node-server": "2.1.0",
    "@langchain/core": {
      "langsmith": "0.6.3"
    },
    "@langchain/core@1.1.45": {
      "langsmith": "0.6.3"
    },
    "@langchain/langgraph-sdk": {
      "uuid": "13.0.2"
    },
    "@langchain/langgraph-sdk@1.8.8": {
      "uuid": "13.0.2"
    },
    "basic-ftp": "6.0.1",
    "deepmerge-ts": "8.0.2",
    "esbuild": "0.28.1",
    "express": "^5.2.0",
    "express-rate-limit": "8.5.1",
    "fast-xml-parser": "5.7.3",
    "hono": "4.13.8",
    "ip-address": "10.4.0",
    "langchain": {
      "langsmith": "0.6.3"
    },
    "langsmith": "0.6.3",
    "multer": "2.3.0",
    "mysql2": "3.23.4",
    "postcss": "8.5.26",
    "protobufjs": "7.6.5",
    "qs": "6.16.0",
    "sharp": "0.35.4",
    "shell-quote": "1.10.0",
    "uuid": "11.1.1",
    "vite": "8.2.0",
    "ws": "8.21.2",
    "yauzl": "3.2.1"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57"
  }
}
