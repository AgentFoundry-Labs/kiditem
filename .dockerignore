# Dependencies (Dockerfile에서 자체 install)
node_modules/
**/node_modules/

# Build artifacts (Docker 안에서 빌드)
apps/server/dist/
apps/web/.next/

# Secrets
.secrets/
**/.env
**/.env.*
**/*.env
**/*.env.*
!**/.env.example
!**/.env.*.example
!**/*.env.example
!**/*.env.*.example

# Git
.git/
.gitignore

# Python (agents는 별도 context)
agents/.venv/
agents/__pycache__/
**/__pycache__/

# Unnecessary for server build
extensions/
*.md
!agent-config/prompts/agents/operator.md
!agent-config/prompts/agents/sourcing.md
!agent-config/prompts/agents/merchandising.md
!agent-config/prompts/agents/supply.md
!agent-config/prompts/agents/channel_operations.md
!agent-config/prompts/agents/advertising.md
