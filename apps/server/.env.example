NODE_ENV=development
PORT=4000

# Keep this file to the variables required by local and Office API runtimes and
# to safe local verification examples. Host Gateway values are file-path and
# loopback configuration only; provider login state never enters the API.

# PostgreSQL database used by local development. Office uses its local Docker
# PostgreSQL service and keeps the populated value outside Git.
DATABASE_URL=postgresql://kiditem:kiditem@localhost:5433/kiditem

# Canonical browser origin used to construct extension render document URLs.
WEB_ORIGIN=http://localhost:3000

# Set to the browser origin for the current local or Office runtime. Same-origin
# calls do not require CORS, but explicit allowlisting protects extension and
# API-only callers.
CORS_ORIGINS=http://localhost:3000

# Local/Office MinIO through its S3-compatible endpoint. Keep the populated
# Office credentials outside Git.
S3_REGION=us-east-1
S3_BUCKET=kiditem
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_URL=http://localhost:9000/kiditem
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Channel credentials encryption key — required for storing/decrypting channel
# account credentials. Generate with: openssl rand -base64 32
CHANNEL_CREDENTIALS_ENCRYPTION_KEY=

# BEGIN ORDER_COLLECTION_MALL_SEED
# Order-collection mall credential seed input. These values are read only by
# `npm run seed:order-collection-malls`, then encrypted into organization-scoped
# ChannelAccount rows. The API runtime never uses them as global fallbacks.
# Local runs may omit ORDER_COLLECTION_MALL_ORGANIZATION_ID when root `.env`
# already defines KIDITEM_DEV_ORGANIZATION_ID. Set the confirmation only for an
# intentional seed operation.
ORDER_COLLECTION_MALL_ORGANIZATION_ID=
ORDER_COLLECTION_MALL_SEED_CONFIRM=

ONE_POLARIS_ID=
ONE_POLARIS_PW=
ONE_POLARIS_URL=
ICECREAM_MALL_ID=
ICECREAM_MALL_PW=
ICECREAM_MALL_URL=
KIDKIDS_ID=
KIDKIDS_PW=
KIDKIDS_URL=
KIDSNOTE_ID=
KIDSNOTE_PW=
KIDSNOTE_URL=
HAEBUB_MALL_ID=
HAEBUB_MALL_PW=
HAEBUB_MALL_URL=
ONCH_ID=
ONCH_PW=
ONCH_URL=
KKOMANGSE_ID=
KKOMANGSE_PW=
KKOMANGSE_URL=
ART09_ID=
ART09_SUPPLIER_ID=
ART09_PW=
ART09_URL=
TEKVILLE_EDU_ID=
TEKVILLE_EDU_PW=
TEKVILLE_EDU_URL=
BENEPIA_MUL_ID=
BENEPIA_MUL_PW=
BENEPIA_MUL_URL=
DOMEGGOOK_ID=
DOMEGGOOK_PW=
DOMEGGOOK_URL=
LOTTE_ON_ID=
LOTTE_ON_PW=
LOTTE_ON_URL=
BORIBORI_ID=
BORIBORI_PW=
BORIBORI_URL=
ALWAYS_ID=
ALWAYS_PW=
ALWAYS_URL=
WOONGJIN_CLASS_ID=
WOONGJIN_CLASS_PW=
WOONGJIN_CLASS_URL=
KAKAO_ID=
KAKAO_PW=
KAKAO_URL=
TOSS_ID=
TOSS_PW=
TOSS_URL=
TEACHER_MALL_ID=
TEACHER_MALL_PW=
TEACHER_MALL_URL=
GS_SHOP_ID=
GS_SHOP_PW=
GS_SHOP_URL=
COUPANG_DIRECT_ID=
COUPANG_DIRECT_PW=
COUPANG_DIRECT_URL=
# END ORDER_COLLECTION_MALL_SEED

# Server-side NAVER API HUB and SearchAd keyword research. Optional until the
# sourcing rising-keyword workflow is enabled. Do not expose these publicly.
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=
NAVER_API_HUB_BASE_URL=https://naverapihub.apigw.ntruss.com
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=
NAVER_SEARCHAD_BASE_URL=https://api.searchad.naver.com

# Server-side 1688 search. Nest wholesale keyword/matching uses 1688 public
# mtop search directly; TMAPI remains only for legacy Python matcher flows.
DIRECT_1688_MTOP_BASE_URL=https://h5api.m.1688.com
TMAPI_TOKEN=
TMAPI_BASE_URL=https://api.tmapi.top

# Local sourcing uses its own Playwright profile by default. Leave CDP blank on
# macOS; Office supplies http://kiditem-office:9444 from its own env example.
# Keyword batches remain managed-profile-only in Office. URL scrape can launch
# the dedicated local profile below while it is being prepared or debugged.
SOURCING_PLAYWRIGHT_CDP_ENDPOINT=
SOURCING_PLAYWRIGHT_USER_DATA_DIR=.kiditem/playwright/sourcing
SOURCING_PLAYWRIGHT_HEADLESS=true

# Taobao Live official TOP APIs. The live metadata/item endpoints do not need
# seller OAuth, but every request still requires an approved TOP AppKey and
# server-side signature. Never expose the secret to the web or extension.
TAOBAO_TOP_APP_KEY=
TAOBAO_TOP_APP_SECRET=
TAOBAO_TOP_BASE_URL=https://eco.taobao.com/router/rest
TAOBAO_TOP_TIMEOUT_MS=15000

# Optional paid shadow treatment. Keep disabled until a pilot
# organization and an EchoTik-supported region are explicitly selected.
SOURCING_LINKFOX_SHADOW_ENABLED=0
SOURCING_LINKFOX_ECHOTIK_REGION=
SOURCING_LINKFOX_PILOT_ORGANIZATION_IDS=
LINKFOX_AGENT_API_KEY=

# Owner confirm report (사장님 컨펌) over Telegram. Create a dedicated bot per
# environment with @BotFather; never reuse the Claude Code bridge bot token,
# because two processes reading one bot cut each other off. Leave the chat ID
# empty, issue a setup token in the Agent Org Telegram box, send
# /start <token> to the bot, and copy the chat ID the bot replies with.
# Set POLLING=0 on any process that must not read button answers.
SOURCING_CONFIRM_TELEGRAM_BOT_TOKEN=
# Organization UUID the bot serves; empty turns Telegram confirm off.
SOURCING_CONFIRM_TELEGRAM_ORGANIZATION_ID=
SOURCING_CONFIRM_TELEGRAM_CHAT_ID=
SOURCING_CONFIRM_TELEGRAM_ALLOWED_USER_IDS=
SOURCING_CONFIRM_TELEGRAM_POLLING=

# Server-side Gemini AI used by current API text/detail/thumbnail/image-edit features.
GEMINI_API_KEY=
AI_TEXT_MODEL=gemini-2.5-flash
AI_IMAGE_MODEL=gemini-3.1-flash-image
AI_IMAGE_ANALYSIS_MODEL=gemini-3.1-flash-lite
AI_IMAGE_ANALYSIS_VERIFY_MODEL=gemini-3.1-flash-lite

# Internal API base used by Action Board actions (Office: http://api:4000).
API_SELF_URL=http://localhost:4000
# Docker secret file containing one 43-character Host Gateway installation bearer.
KIDITEM_AGENT_GATEWAY_TOKEN_FILE=
AGENT_CLI_MAX_CONCURRENCY=4

# Private stateless capability MCP runtime. Any value other than these exact
# values fails the readiness probe instead of negotiating a legacy fallback.
MCP_SDK_GENERATION=v2
MCP_PROTOCOL_NEGOTIATION=auto
